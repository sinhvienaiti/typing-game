{
  "name": "@typing-game/platform",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.21.0",
  "engines": { "node": ">=24.0.0 <25" },
  "scripts": {
    "bootstrap": "bash scripts/bootstrap.sh",
    "dev": "concurrently -k -n portal,monkeytype,shooter \"pnpm dev:portal\" \"pnpm dev:monkeytype:app\" \"pnpm dev:shooter:app\"",
    "dev:portal": "pnpm --dir portal dev",
    "dev:monkeytype": "concurrently -k -n portal,monkeytype \"pnpm dev:portal\" \"pnpm dev:monkeytype:app\"",
    "dev:monkeytype:app": "cd games/monkeytype && SERVER_OPEN=false DEV_HOST=127.0.0.1 DEV_ALLOWED_HOSTS=monkeytype.typing-game.local DEV_HMR_HOST=monkeytype.typing-game.local DEV_HMR_PROTOCOL=wss DEV_HMR_CLIENT_PORT=443 pnpm dev-fe",
    "dev:shooter": "concurrently -k -n portal,shooter \"pnpm dev:portal\" \"pnpm dev:shooter:app\"",
    "dev:shooter:app": "pnpm --dir games/vocab-shooter dev",
    "build:portal": "pnpm --dir portal build",
    "build:shooter": "pnpm --dir games/vocab-shooter build",
    "build:monkeytype": "cd games/monkeytype && LOCAL_STATIC=true pnpm build-fe",
    "build:local": "pnpm build:portal && pnpm build:shooter && pnpm build:monkeytype",
    "setup:dev": "bash scripts/setup-nginx.sh dev",
    "setup:play": "bash scripts/setup-nginx.sh play",
    "play": "bash scripts/play.sh"
  },
  "devDependencies": { "concurrently": "^9.2.1" }
}
