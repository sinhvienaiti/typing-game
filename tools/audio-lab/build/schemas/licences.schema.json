{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "audiolab.licence/1",
  "title": "One row of art-src/audio/licences.jsonl, version 1",
  "description": "Source ledger (AUDIO_PIPELINE.md §10.6): one row per source file, library pack, model, licence acceptance or tool. Every row has a date, a licence URL and a hash.",
  "type": "object",
  "required": ["schema", "kind", "key", "date", "licence", "licenceUrl", "sha256"],
  "properties": {
    "schema": {"const": "audiolab.licence/1"},
    "kind": {"enum": ["source", "library", "model", "acceptance", "tool"]},
    "key": {"type": "string", "minLength": 3},
    "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "Download, recording or acceptance date."},
    "licence": {"type": "string", "minLength": 1},
    "licenceVersion": {"type": "string"},
    "licenceUrl": {"type": "string", "minLength": 1},
    "licenceCopy": {"type": "string", "description": "Path (relative to art-src/audio) of the dated licence copy."},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$", "description": "File, archive, weights or licence-file hash."},
    "commercial_ok": {"type": "boolean"},
    "attribution_required": {"type": "boolean"},
    "attribution_text": {"type": "string"},
    "ai_input_allowed": {"type": "boolean"},
    "raw_redistribution_allowed": {"type": "boolean"},
    "genai_preference": {"type": "string"},
    "release_file": {"type": "string"}
  },
  "allOf": [
    {
      "if": {"properties": {"kind": {"const": "source"}}},
      "then": {
        "required": ["origin", "file", "licenceCopy", "commercial_ok", "attribution_required", "ai_input_allowed", "raw_redistribution_allowed"],
        "properties": {
          "origin": {"enum": ["library", "freesound", "owner-recording", "other-recording", "generated", "purchased"]},
          "library": {"type": "string"}, "pack": {"type": "string"}, "packVersion": {"type": "string"},
          "year": {"type": "integer"}, "file": {"type": "string"}, "path": {"type": "string"},
          "url": {"type": "string"}, "author": {"type": "string"}
        }
      }
    },
    {
      "if": {"properties": {"kind": {"const": "library"}}},
      "then": {"required": ["library", "pack", "version", "url", "licenceCopy", "commercial_ok", "attribution_required", "ai_input_allowed", "raw_redistribution_allowed"]}
    },
    {
      "if": {"properties": {"kind": {"const": "model"}}},
      "then": {
        "required": ["repo", "revision", "role", "commercial_ok"],
        "properties": {"role": {"enum": ["generate", "critic", "listener"]}}
      }
    },
    {
      "if": {"properties": {"kind": {"const": "acceptance"}}},
      "then": {"required": ["who", "file"]}
    },
    {
      "if": {"properties": {"kind": {"const": "tool"}}},
      "then": {"required": ["name", "version"]}
    }
  ]
}
