    {
      "schemaVersion": 1,
      "id": "gr.c1.negative-inversion",
      "cefr": "C1",
      "title": "Inversion after negative and restrictive adverbials",
      "objective": "Use Never/Rarely/Only then/Not until + auxiliary inversion for marked emphasis.",
      "concept": {
        "en": "After certain negative or restrictive expressions placed first, invert the auxiliary and subject for marked emphasis.",
        "vi": "Khi đưa một số trạng từ/cụm từ phủ định hoặc hạn định lên đầu câu để nhấn mạnh, đảo trợ động từ lên trước chủ ngữ."
      },
      "formulae": [
        "Negative/restrictive expression + auxiliary + subject + main verb.",
        "Not until + clause + auxiliary + subject + main verb."
      ],
      "whenToUse": [
        "Formal writing, speeches and deliberate rhetorical emphasis.",
        "Emphasize rarity, restriction or a delayed realization."
      ],
      "forms": {
