    {
      "schemaVersion": 1,
      "id": "gr.a2.present-perfect-experience",
      "cefr": "A2",
      "title": "Present Perfect: life experience",
      "objective": "Talk about experience without stating a finished past time.",
      "concept": {
        "en": "Use the Present Perfect to talk about life experience when the exact finished time is not stated.",
        "vi": "Dùng Hiện tại hoàn thành để nói về trải nghiệm trong đời khi không nêu một thời điểm quá khứ đã kết thúc."
      },
      "formulae": [
        "Subject + have/has + past participle.",
        "Have/Has + subject + ever + past participle?",
        "Subject + have/has never + past participle."
      ],
      "whenToUse": [
        "Ask whether an experience has happened at any time up to now.",
        "State experience without a finished past-time expression."
      ],
      "forms": {
        "positive": [
          "I have visited Singapore twice."
        ],
        "negative": [
          "She has never missed a flight."
        ],
        "question": [
          "Have you ever worked abroad?"
        ]
      },
      "variations": [
        "Use Past Simple if you add a finished time such as last year."
      ],
