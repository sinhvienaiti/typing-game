    {
      "schemaVersion": 1,
      "id": "gr.b1.present-perfect-simple-vs-continuous",
      "cefr": "B1",
      "title": "Present Perfect Simple vs Continuous",
      "objective": "Choose result/completion/count vs duration/activity focus.",
      "concept": {
        "en": "Choose Present Perfect Simple for completion/result/count and Present Perfect Continuous for duration or ongoing activity.",
        "vi": "Chọn Hiện tại hoàn thành đơn khi nhấn mạnh kết quả, sự hoàn tất hoặc số lượng; chọn Hiện tại hoàn thành tiếp diễn khi nhấn mạnh quá trình hoặc khoảng thời gian."
      },
      "formulae": [
        "have/has + past participle",
        "have/has been + verb-ing"
      ],
      "whenToUse": [
        "Contrast a completed result with an activity in progress or recently continuing.",
        "Contrast how much/how many with how long."
      ],
      "forms": {
        "positive": [
          "I have written three emails.",
          "I have been writing emails for two hours."
        ]
      },
      "variations": [
        "State verbs normally prefer the simple form."
      ],
