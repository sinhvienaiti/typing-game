    {
      "schemaVersion": 1,
      "id": "gr.a2.first-conditional",
      "cefr": "A2",
      "title": "First Conditional",
      "objective": "Describe realistic future conditions and likely results.",
      "concept": {
        "en": "Use the First Conditional for a realistic future condition and its likely result.",
        "vi": "Dùng Câu điều kiện loại 1 cho điều kiện có khả năng xảy ra trong tương lai và kết quả có thể xảy ra theo."
      },
      "formulae": [
        "If + Present Simple, will + base verb.",
        "will + base verb + if + Present Simple."
      ],
      "whenToUse": [
        "Realistic future plans and consequences.",
        "Warnings, promises and practical decisions based on a future condition."
      ],
      "forms": {
        "positive": [
          "If it rains, we will take a taxi."
        ],
        "negative": [
          "If the shop isn't open, we won't wait."
        ],
        "question": [
          "What will you do if the train is late?"
        ]
      },
      "variations": [
        "Result clauses can later use can, may, might or an imperative."
      ],
