    {
      "schemaVersion": 1,
      "id": "gr.b1.second-conditional",
      "cefr": "B1",
      "title": "Second Conditional",
      "objective": "Describe unlikely or hypothetical present/future situations.",
      "concept": {
        "en": "Use the Second Conditional for unlikely, imaginary or hypothetical present/future situations.",
        "vi": "Dùng Câu điều kiện loại 2 cho tình huống hiện tại hoặc tương lai mang tính giả định, tưởng tượng hoặc khó xảy ra."
      },
      "formulae": [
        "If + Past Simple, would + base verb.",
        "would + base verb + if + Past Simple."
      ],
      "whenToUse": [
        "Imagine a different present or future.",
        "Give hypothetical advice or discuss unlikely possibilities."
      ],
      "forms": {
        "positive": [
          "If I had more time, I would learn another language."
        ],
        "negative": [
          "If we didn't need the car, we would sell it."
        ],
        "question": [
          "What would you do if your flight were cancelled?"
        ]
      },
      "variations": [
        "Were is common for hypothetical be, especially in careful/formal English."
      ],
