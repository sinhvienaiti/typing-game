      "id": "gr.c1.nominalisation",
      "cefr": "C1",
      "title": "Nominalisation in formal writing",
      "objective": "Convert processes/qualities into noun phrases without producing dense unnatural prose.",
      "concept": {
        "en": "Nominalisation turns actions or qualities into noun phrases, often creating denser formal writing.",
        "vi": "Danh từ hóa biến hành động hoặc đặc tính thành cụm danh từ, thường giúp văn phong trang trọng và cô đọng hơn nhưng có thể làm câu nặng nếu lạm dụng."
      },
      "formulae": [
        "verb/adjective → noun phrase",
        "evaluate → evaluation; expand → expansion; decide → decision"
      ],
      "whenToUse": [
        "Formal reports and academic writing where processes are discussed as concepts.",
        "Package information into a noun phrase for cohesion or comparison."
      ],
      "forms": {
        "positive": [
          "The rapid expansion of the service created new staffing needs."
        ]
      },
      "variations": [
        "Prefer a finite verb when nominalisation would hide the actor or make the sentence unnecessarily dense."
