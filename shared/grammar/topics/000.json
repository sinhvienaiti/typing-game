    {
      "schemaVersion": 1,
      "id": "gr.b2.reporting-passive",
      "cefr": "B2",
      "title": "Reporting passives",
      "objective": "Use It is said that... and subject + is believed to... patterns.",
      "concept": {
        "en": "Use reporting passives to present reported information while distancing the writer from the source.",
        "vi": "Dùng cấu trúc bị động tường thuật để trình bày thông tin được cho là đúng và tạo khoảng cách giữa người viết với nguồn thông tin."
      },
      "formulae": [
        "It + be + past participle + that-clause.",
        "Subject + be + past participle + to-infinitive.",
        "Subject + be + past participle + to have + past participle."
      ],
      "whenToUse": [
        "News, reports and formal summaries where the source is general or secondary.",
        "Claims where the writer does not want to present the proposition as a direct personal assertion."
      ],
      "forms": {
        "positive": [
          "The policy is expected to reduce delays.",
          "The company is reported to have opened a new office."
        ]
      },
      "variations": [
        "Common reporting verbs include say, believe, expect, think, know and report."
      ],
