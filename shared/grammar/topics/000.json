    {
      "schemaVersion": 1,
      "id": "gr.a1.present-simple-routines",
      "cefr": "A1",
      "title": "Present Simple: habits and routines",
      "objective": "Describe repeated everyday actions and routines.",
      "concept": {
        "en": "Use the Present Simple for repeated actions, habits and routines.",
        "vi": "Dùng Hiện tại đơn để nói về hành động lặp lại, thói quen và lịch sinh hoạt thường xuyên."
      },
      "formulae": [
        "Subject + base verb (+ s/es with he/she/it).",
        "Subject + do/does not + base verb.",
        "Do/Does + subject + base verb?"
      ],
      "whenToUse": [
        "Regular routines and habits.",
        "Repeated actions with frequency expressions such as every day, usually and often."
      ],
      "forms": {
        "positive": [
          "I work at home on Fridays.",
          "She takes the bus every morning."
        ],
        "negative": [
          "I don't drive to work.",
          "He doesn't work on Sundays."
        ],
        "question": [
          "Do you exercise every day?",
          "Does she start at nine?"
        ]
      },
      "variations": [
        "Frequency adverbs usually come before the main verb but after be."
      ],
