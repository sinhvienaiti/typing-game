    {
      "schemaVersion": 1,
      "id": "gr.a1.present-continuous-now",
      "cefr": "A1",
      "title": "Present Continuous: actions happening now",
      "objective": "Describe actions in progress at the speaking moment.",
      "concept": {
        "en": "Use the Present Continuous for an action in progress at the moment of speaking.",
        "vi": "Dùng Hiện tại tiếp diễn cho hành động đang diễn ra ngay tại thời điểm nói."
      },
      "formulae": [
        "Subject + am/is/are + verb-ing.",
        "Subject + am/is/are not + verb-ing.",
        "Am/Is/Are + subject + verb-ing?"
      ],
      "whenToUse": [
        "Something happening now.",
        "A visible or immediate activity around the speaking moment."
      ],
      "forms": {
        "positive": [
          "I am waiting now."
        ],
        "negative": [
          "She isn't working now."
        ],
        "question": [
          "Are they coming now?"
        ]
      },
      "variations": [
        "Now, right now and at the moment often make the time reference explicit."
      ],
