    {
      "schemaVersion": 1,
      "id": "gr.b2.third-conditional",
      "cefr": "B2",
      "title": "Third Conditional",
      "objective": "Describe unreal past conditions and imagined past results.",
      "concept": {
        "en": "Use the Third Conditional to imagine a different past condition and a different past result.",
        "vi": "Dùng Câu điều kiện loại 3 để tưởng tượng một điều kiện trong quá khứ đã không xảy ra và kết quả quá khứ khác đi."
      },
      "formulae": [
        "If + had + past participle, would have + past participle."
      ],
      "whenToUse": [
        "Past regrets and hindsight.",
        "Alternative outcomes for completed past events."
      ],
      "forms": {
        "positive": [
          "If we had left earlier, we would have caught the train."
        ],
        "negative": [
          "If I hadn't missed the call, I wouldn't have been late."
        ],
        "question": [
          "What would you have done if the booking had failed?"
        ]
      },
      "variations": [
        "Could have and might have can replace would have to change result meaning."
      ],
