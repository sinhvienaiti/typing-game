{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://typing-game.local/vocabulary/schema.json",
  "title": "Typing Game Vocabulary Level",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "level",
    "label",
    "entries"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "level": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "label": {
      "type": "string",
      "minLength": 1
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "en",
          "vi",
          "ipa"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^L\\d{3}-\\d{3,}$"
          },
          "en": {
            "type": "string",
            "minLength": 1
          },
          "vi": {
            "type": "string",
            "minLength": 1
          },
          "ipa": {
            "type": "string",
            "minLength": 3
          }
        }
      }
    }
  }
}
