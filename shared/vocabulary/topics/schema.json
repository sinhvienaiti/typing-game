{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://typing-game.local/vocabulary/topics/schema.json",
  "title": "Generated Topic Catalog",
  "type": "object",
  "required": [
    "version",
    "groups"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "topics"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "topics": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "label",
                "levels",
                "entries"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                },
                "levels": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "entries": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "key",
                      "level",
                      "priority"
                    ],
                    "properties": {
                      "key": {
                        "type": "string",
                        "minLength": 1
                      },
                      "level": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 100
                      },
                      "priority": {
                        "enum": [
                          "core",
                          "support"
                        ]
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
