{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://typing-game.local/schemas/english-content/dialogue.schema.json",
  "title": "dialogue",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "quality",
    "provenance",
    "scenario",
    "turns"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^dlg\\.[a-z0-9._-]+$"
    },
    "quality": {
      "$ref": "https://typing-game.local/schemas/english-content/common.schema.json#/$defs/quality"
    },
    "provenance": {
      "$ref": "https://typing-game.local/schemas/english-content/provenance.schema.json"
    },
    "scenario": {
      "type": "string",
      "minLength": 2,
      "maxLength": 300
    },
    "cefr": {
      "$ref": "https://typing-game.local/schemas/english-content/common.schema.json#/$defs/cefr"
    },
    "turns": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "speaker",
          "text"
        ],
        "properties": {
          "speaker": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        }
      }
    },
    "grammarIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^gr\\."
      }
    }
  }
}
