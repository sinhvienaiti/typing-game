{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://typing-game.local/schemas/english-content/oewn-entry-map.schema.json",
  "title": "Pinned OEWN entry map",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "source",
    "sourceRepository",
    "sourceCommit",
    "release",
    "shard",
    "records",
    "misses"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "source": {
      "const": "oewn"
    },
    "sourceRepository": {
      "const": "globalwordnet/english-wordnet"
    },
    "sourceCommit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "release": {
      "const": "2025-edition"
    },
    "shard": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "lexemeId",
          "legacyId",
          "headword",
          "headwordKey",
          "legacyVi",
          "legacyIpa",
          "parts"
        ],
        "properties": {
          "lexemeId": {
            "type": "string",
            "pattern": "^lex\\.en\\."
          },
          "legacyId": {
            "type": "string"
          },
          "headword": {
            "type": "string"
          },
          "headwordKey": {
            "type": "string"
          },
          "legacyVi": {
            "type": "string"
          },
          "legacyIpa": {
            "type": "string"
          },
          "parts": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "partOfSpeech",
                "forms",
                "pronunciations",
                "senses"
              ],
              "properties": {
                "partOfSpeech": {
                  "type": "string",
                  "enum": [
                    "n",
                    "v",
                    "a",
                    "r",
                    "s"
                  ]
                },
                "forms": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "string"
                  }
                },
                "pronunciations": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "value",
                      "variety"
                    ],
                    "properties": {
                      "value": {
                        "type": "string"
                      },
                      "variety": {
                        "type": [
                          "string",
                          "null"
                        ]
                      }
                    }
                  }
                },
                "senses": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "senseId",
                      "synsetId",
                      "lexFileNumber"
                    ],
                    "properties": {
                      "senseId": {
                        "type": "string"
                      },
                      "synsetId": {
                        "type": "string"
                      },
                      "lexFileNumber": {
                        "type": [
                          "integer",
                          "null"
                        ],
                        "minimum": 0,
                        "maximum": 99
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "misses": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "legacyId",
          "headword",
          "headwordKey"
        ],
        "properties": {
          "legacyId": {
            "type": "string"
          },
          "headword": {
            "type": "string"
          },
          "headwordKey": {
            "type": "string"
          }
        }
      }
    }
  }
}
