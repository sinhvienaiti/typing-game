{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://typing-game.local/schemas/english-content/collocation.schema.json",
  "title": "collocation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "quality",
    "provenance",
    "text",
    "headwordKeys",
    "pattern",
    "meaningVi"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^col\\.[a-z0-9._-]+$"
    },
    "quality": {
      "$ref": "https://typing-game.local/schemas/english-content/common.schema.json#/$defs/quality"
    },
    "provenance": {
      "$ref": "https://typing-game.local/schemas/english-content/provenance.schema.json"
    },
    "text": {
      "type": "string",
      "minLength": 2,
      "maxLength": 300
    },
    "headwordKeys": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "https://typing-game.local/schemas/english-content/common.schema.json#/$defs/normalizedEnglishKey"
      }
    },
    "pattern": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "meaningVi": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "cefr": {
      "$ref": "https://typing-game.local/schemas/english-content/common.schema.json#/$defs/cefr"
    },
    "exampleIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^sent\\."
      }
    }
  }
}
