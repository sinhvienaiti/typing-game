{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://typing-game.local/schemas/english-content/topic-pack.schema.json",
  "title": "English learning topic pack",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "title",
    "titleVi",
    "description",
    "cefr",
    "quality",
    "provenance",
    "objectives",
    "items"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^pack\\.[a-z0-9._-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 3,
      "maxLength": 160
    },
    "titleVi": {
      "type": "string",
      "minLength": 3,
      "maxLength": 200
    },
    "description": {
      "type": "string",
      "minLength": 10,
      "maxLength": 600
    },
    "cefr": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "https://typing-game.local/schemas/english-content/common.schema.json#/$defs/cefr"
      }
    },
    "estimatedMinutes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 120
    },
    "quality": {
      "$ref": "https://typing-game.local/schemas/english-content/common.schema.json#/$defs/quality"
    },
    "provenance": {
      "$ref": "https://typing-game.local/schemas/english-content/provenance.schema.json"
    },
    "objectives": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 5,
        "maxLength": 300
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "contentId",
          "stage",
          "activity",
          "learningFocus"
        ],
        "properties": {
          "contentId": {
            "type": "string",
            "minLength": 2,
            "maxLength": 200
          },
          "stage": {
            "type": "string",
            "enum": [
              "pre-check",
              "input",
              "practice",
              "contrast",
              "post-check"
            ]
          },
          "activity": {
            "type": "string",
            "minLength": 2,
            "maxLength": 60
          },
          "learningFocus": {
            "type": "string",
            "enum": [
              "typing-fluency",
              "recognition",
              "recall",
              "usage-discrimination",
              "comprehension",
              "production"
            ]
          },
          "noteVi": {
            "type": "string",
            "maxLength": 400
          }
        }
      }
    }
  }
}
