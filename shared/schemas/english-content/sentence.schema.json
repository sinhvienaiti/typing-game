{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://typing-game.local/schemas/english-content/sentence.schema.json",
  "title": "sentence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "quality",
    "provenance",
    "text"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^sent\\.[a-z0-9._-]+$"
    },
    "quality": {
      "$ref": "https://typing-game.local/schemas/english-content/common.schema.json#/$defs/quality"
    },
    "provenance": {
      "$ref": "https://typing-game.local/schemas/english-content/provenance.schema.json"
    },
    "text": {
      "type": "string",
      "minLength": 2,
      "maxLength": 1000
    },
    "cefr": {
      "$ref": "https://typing-game.local/schemas/english-content/common.schema.json#/$defs/cefr"
    },
    "contexts": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "maxLength": 80
      }
    },
    "register": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "maxLength": 60
      }
    },
    "grammarIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^gr\\."
      }
    },
    "lexicalIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "maxLength": 200
      }
    }
  }
}
