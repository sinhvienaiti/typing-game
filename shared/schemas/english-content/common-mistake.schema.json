{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://typing-game.local/schemas/english-content/common-mistake.schema.json",
  "title": "common-mistake",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "quality",
    "provenance",
    "incorrect",
    "corrections",
    "explanationVi",
    "targetIds",
    "evidenceType"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^err\\.[a-z0-9._-]+$"
    },
    "quality": {
      "$ref": "https://typing-game.local/schemas/english-content/common.schema.json#/$defs/quality"
    },
    "provenance": {
      "$ref": "https://typing-game.local/schemas/english-content/provenance.schema.json"
    },
    "incorrect": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1200
    },
    "corrections": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1200
      }
    },
    "explanationVi": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "targetIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "maxLength": 200
      }
    },
    "evidenceType": {
      "type": "string",
      "enum": [
        "pedagogical",
        "source-attested",
        "observed-local"
      ]
    }
  }
}
