{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://typing-game.local/schemas/english-content/usage.schema.json",
  "title": "usage",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "quality",
    "provenance",
    "targetId",
    "explanationVi"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^usage\\.[a-z0-9._-]+$"
    },
    "quality": {
      "$ref": "https://typing-game.local/schemas/english-content/common.schema.json#/$defs/quality"
    },
    "provenance": {
      "$ref": "https://typing-game.local/schemas/english-content/provenance.schema.json"
    },
    "targetId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "explanationVi": {
      "type": "string",
      "minLength": 1,
      "maxLength": 3000
    },
    "register": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 60
      }
    },
    "construction": {
      "type": "string",
      "maxLength": 500
    },
    "exampleIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^sent\\."
      }
    }
  }
}
