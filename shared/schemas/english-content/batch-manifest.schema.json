{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://typing-game.local/schemas/english-content/batch-manifest.schema.json",
  "title": "Controlled English-content batch manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "contentVersion",
    "batches"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "contentVersion": {
      "type": "string",
      "pattern": "^\\d{4}\\.\\d{2}\\.\\d+$",
      "maxLength": 40
    },
    "batches": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "phase",
          "category",
          "cefr",
          "state",
          "recordSets",
          "requiredBeforePublish",
          "gameSmokes"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^e\\d{2}\\.[a-z0-9][a-z0-9-]*$",
            "maxLength": 100
          },
          "phase": {
            "type": "string",
            "pattern": "^E\\d{2}$"
          },
          "category": {
            "type": "string",
            "enum": [
              "dictionary",
              "phrases",
              "grammar",
              "sentences",
              "mixed"
            ]
          },
          "cefr": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "$ref": "https://typing-game.local/schemas/english-content/common.schema.json#/$defs/cefr"
            }
          },
          "state": {
            "$ref": "https://typing-game.local/schemas/english-content/common.schema.json#/$defs/qualityState"
          },
          "recordSets": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "path",
                "expectedCount",
                "generated",
                "allowedQualityStates",
                "requiredChecks"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9-]*$",
                  "maxLength": 100
                },
                "path": {
                  "type": "string",
                  "pattern": "^content/english/",
                  "maxLength": 500
                },
                "expectedCount": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1000000
                },
                "generated": {
                  "type": "boolean"
                },
                "allowedQualityStates": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "$ref": "https://typing-game.local/schemas/english-content/common.schema.json#/$defs/qualityState"
                  }
                },
                "requiredChecks": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "pattern": "^[A-Za-z][A-Za-z0-9-]*$",
                    "maxLength": 80
                  }
                }
              }
            }
          },
          "requiredBeforePublish": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*$",
              "maxLength": 80
            }
          },
          "gameSmokes": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "gameId",
                "activity",
                "recordSetId",
                "sampleCount"
              ],
              "properties": {
                "gameId": {
                  "type": "string",
                  "enum": [
                    "recall-typing",
                    "vocab-shooter",
                    "karaoke-typing",
                    "space-typing"
                  ]
                },
                "activity": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                },
                "recordSetId": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9-]*$",
                  "maxLength": 100
                },
                "sampleCount": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 20
                }
              }
            }
          }
        }
      }
    }
  }
}
