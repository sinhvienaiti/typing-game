{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://typing-game.local/schemas/english-content/curriculum.schema.json",
  "title": "English CEFR curriculum level",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "cefr",
    "topicIds"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "cefr": {
      "$ref": "https://typing-game.local/schemas/english-content/common.schema.json#/$defs/cefr"
    },
    "topicIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^gr\\.(a1|a2|b1|b2|c1|c2)\\.[a-z0-9-]+$"
      }
    }
  }
}
