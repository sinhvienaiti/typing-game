{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://typing-game.local/schemas/english-content/multiwoz-source-pin.schema.json",
  "title": "MultiWOZ E06 source pin",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "source",
    "version",
    "repository",
    "commit",
    "path",
    "blobSha1",
    "license",
    "attribution"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "source": {
      "const": "multiwoz"
    },
    "version": {
      "const": "2.2"
    },
    "repository": {
      "const": "budzianowski/multiwoz"
    },
    "commit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "blobSha1": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "license": {
      "const": "MIT"
    },
    "attribution": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "additionalFiles": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "blobSha1"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "blobSha1": {
            "type": "string",
            "pattern": "^[a-f0-9]{40}$"
          }
        }
      }
    }
  }
}
