{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://typing-game.local/schemas/english-content/common.schema.json",
  "title": "English content common definitions",
  "$defs": {
    "cefr": {
      "type": "string",
      "enum": [
        "A1",
        "A2",
        "B1",
        "B2",
        "C1",
        "C2"
      ]
    },
    "qualityState": {
      "type": "string",
      "enum": [
        "candidate",
        "draft",
        "validated",
        "reviewed",
        "published",
        "deprecated"
      ]
    },
    "normalizedEnglishKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300,
      "pattern": "^\\S(?:.*\\S)?$"
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "checks"
      ],
      "properties": {
        "state": {
          "$ref": "https://typing-game.local/schemas/english-content/common.schema.json#/$defs/qualityState"
        },
        "checks": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "status",
              "method"
            ],
            "properties": {
              "status": {
                "type": "string",
                "enum": [
                  "pass",
                  "fail",
                  "pending",
                  "not-applicable"
                ]
              },
              "method": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "note": {
                "type": "string",
                "maxLength": 500
              }
            }
          }
        }
      }
    },
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataset",
        "license",
        "modified"
      ],
      "properties": {
        "dataset": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$",
          "maxLength": 80
        },
        "sourceId": {
          "type": "string",
          "maxLength": 300
        },
        "sourceUrl": {
          "type": "string",
          "maxLength": 1000
        },
        "snapshot": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 100
        },
        "license": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "attribution": {
          "type": "string",
          "maxLength": 1000
        },
        "modified": {
          "type": "boolean"
        }
      }
    }
  }
}
