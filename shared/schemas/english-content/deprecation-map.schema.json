{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://typing-game.local/schemas/english-content/deprecation-map.schema.json",
  "title": "English-content deprecation map",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "mappings"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "mappings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "oldId",
          "replacementId",
          "reason",
          "effectiveVersion"
        ],
        "properties": {
          "oldId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "replacementId": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 200
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "effectiveVersion": {
            "type": "string",
            "pattern": "^\\d{4}\\.\\d{2}\\.\\d+$"
          }
        }
      }
    }
  }
}
