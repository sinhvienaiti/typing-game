{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://typing-game.local/schemas/english-content/grammar-topic.schema.json",
  "title": "grammar-topic",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "quality",
    "provenance",
    "cefr",
    "title",
    "objective"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^gr\\.(a1|a2|b1|b2|c1|c2)\\.[a-z0-9-]+$"
    },
    "quality": {
      "$ref": "https://typing-game.local/schemas/english-content/common.schema.json#/$defs/quality"
    },
    "provenance": {
      "$ref": "https://typing-game.local/schemas/english-content/provenance.schema.json"
    },
    "cefr": {
      "$ref": "https://typing-game.local/schemas/english-content/common.schema.json#/$defs/cefr"
    },
    "title": {
      "type": "string",
      "minLength": 3,
      "maxLength": 180
    },
    "objective": {
      "type": "string",
      "minLength": 10,
      "maxLength": 500
    },
    "concept": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "en": {
          "type": "string",
          "maxLength": 4000
        },
        "vi": {
          "type": "string",
          "maxLength": 5000
        }
      }
    },
    "formulae": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 500
      }
    },
    "whenToUse": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 1000
      }
    },
    "forms": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "positive": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 500
          }
        },
        "negative": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 500
          }
        },
        "question": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 500
          }
        }
      }
    },
    "variations": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 1000
      }
    },
    "relatedCollocationIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^col\\."
      }
    },
    "exampleIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^sent\\."
      }
    },
    "commonMistakeIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^err\\."
      }
    },
    "contrastTopicIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^gr\\."
      }
    },
    "dialogueIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^dlg\\."
      }
    },
    "prerequisiteIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^gr\\."
      }
    },
    "exerciseIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^ex\\."
      }
    }
  }
}
