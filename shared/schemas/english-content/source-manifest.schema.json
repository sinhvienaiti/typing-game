{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://typing-game.local/schemas/english-content/source-manifest.schema.json",
  "title": "English content source manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "sources"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "url",
          "license",
          "publishAllowed",
          "attributionRequired",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$",
            "maxLength": 80
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "url": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "license": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "publishAllowed": {
            "type": "boolean"
          },
          "attributionRequired": {
            "type": "boolean"
          },
          "status": {
            "type": "string",
            "enum": [
              "reference",
              "import-enabled",
              "blocked"
            ]
          },
          "snapshot": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 100
          },
          "notes": {
            "type": "string",
            "maxLength": 2000
          }
        }
      }
    }
  }
}
