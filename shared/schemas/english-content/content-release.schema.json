{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://typing-game.local/schemas/english-content/content-release.schema.json",
  "title": "English-content release note",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "contentVersion",
    "runtimeCounts",
    "batchStates",
    "migrationCount",
    "notes"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "contentVersion": {
      "type": "string",
      "pattern": "^\\d{4}\\.\\d{2}\\.\\d+$"
    },
    "runtimeCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dictionary",
        "grammar",
        "sentences",
        "phrases",
        "attribution"
      ],
      "properties": {
        "dictionary": {
          "type": "integer",
          "minimum": 0
        },
        "grammar": {
          "type": "integer",
          "minimum": 0
        },
        "sentences": {
          "type": "integer",
          "minimum": 0
        },
        "phrases": {
          "type": "integer",
          "minimum": 0
        },
        "attribution": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "batchStates": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "migrationCount": {
      "type": "integer",
      "minimum": 0
    },
    "notes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    }
  }
}
