    {
      "schemaVersion": 1,
      "id": "dlg.multiwoz.ssng0312.json",
      "scenario": "Trying to book Avalon and then looking for a similar guesthouse after the booking fails",
      "cefr": "B1",
      "turns": [
        {
          "speaker": "Learner",
          "text": "I'm looking for a hotel called Avalon. Can you help?"
        },
        {
          "speaker": "Assistant",
          "text": "Certainly. Avalon is a four-star guesthouse in the north and offers free Wi-Fi. Would you like the phone number or address?"
        },
        {
          "speaker": "Learner",
          "text": "I'd actually like to book rooms for eight people. Can I do that?"
        },
        {
          "speaker": "Assistant",
          "text": "Of course. What day would you like to arrive, and how many nights will you stay?"
        },
        {
          "speaker": "Learner",
          "text": "This Tuesday, for five nights."
        },
        {
          "speaker": "Assistant",
          "text": "I'm sorry, but the booking was unsuccessful. Would you like me to find another similar place to stay?"
        },
        {
          "speaker": "Learner",
          "text": "Yes, please. Can you find another place similar to Avalon?"
        },
        {
          "speaker": "Assistant",
          "text": "There are several similar guesthouses. What price range would you prefer?"
        },
        {
          "speaker": "Learner",
          "text": "I'd like to stay in the same price range as Avalon."
        },
        {
          "speaker": "Assistant",
          "text": "Acorn Guest House is a similar option. Would you like me to book it?"
        }
      ],
