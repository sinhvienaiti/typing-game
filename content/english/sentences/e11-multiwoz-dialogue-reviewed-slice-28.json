    {
      "schemaVersion": 1,
      "id": "dlg.multiwoz.sng0936.json",
      "scenario": "Booking a four-star hotel with free parking in central Cambridge",
      "cefr": "B1",
      "turns": [
        {
          "speaker": "Learner",
          "text": "Hi. I'm looking for a hotel near the centre. Internet is not important."
        },
        {
          "speaker": "Assistant",
          "text": "I have three hotels and two guesthouses that fit. Do you have a preferred price range?"
        },
        {
          "speaker": "Learner",
          "text": "Do any of them have free parking?"
        },
        {
          "speaker": "Assistant",
          "text": "Yes. Two cheap guesthouses and two expensive hotels in the centre have free parking. Do you have another preference?"
        },
        {
          "speaker": "Learner",
          "text": "I'd like a four-star hotel."
        },
        {
          "speaker": "Assistant",
          "text": "There is a four-star hotel in the centre that matches."
        },
        {
          "speaker": "Learner",
          "text": "Great. Please book it for two people for four nights starting Monday."
        },
        {
          "speaker": "Assistant",
          "text": "Your booking at University Arms Hotel was successful. Your reference number is UUZVCFBQ. Do you need anything else?"
        },
        {
          "speaker": "Learner",
          "text": "That's all, thanks."
        },
        {
          "speaker": "Assistant",
          "text": "You're welcome. Goodbye."
        }
      ],
