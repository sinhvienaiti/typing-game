    {
      "schemaVersion": 1,
      "id": "dlg.multiwoz.sng1144.json",
      "scenario": "Finding a museum in west Cambridge and asking for its address and entrance fee",
      "cefr": "A2",
      "turns": [
        {
          "speaker": "Learner",
          "text": "I'd like to visit a museum."
        },
        {
          "speaker": "Assistant",
          "text": "Great. Is there a particular area you prefer?"
        },
        {
          "speaker": "Learner",
          "text": "Any area is fine. Can you recommend one?"
        },
        {
          "speaker": "Assistant",
          "text": "The Cambridge and County Folk Museum is in the west. Would you like more information?"
        },
        {
          "speaker": "Learner",
          "text": "Yes, please. What is the address, and how much is the entrance fee?"
        },
        {
          "speaker": "Assistant",
          "text": "It is at 2–3 Castle Street, and the entrance fee is £3.50. Is there anything else?"
        },
        {
          "speaker": "Learner",
          "text": "That's great. Thank you very much."
        },
        {
          "speaker": "Assistant",
          "text": "You're welcome. Have a great day!"
        }
      ],
