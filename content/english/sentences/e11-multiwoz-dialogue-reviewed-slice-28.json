    {
      "schemaVersion": 1,
      "id": "dlg.multiwoz.ssng0071.json",
      "scenario": "Trying to book a North American restaurant in central Cambridge and handling unavailable alternatives",
      "cefr": "B1",
      "turns": [
        {
          "speaker": "Learner",
          "text": "I'd like to eat in the centre of town at a restaurant that serves North American food."
        },
        {
          "speaker": "Assistant",
          "text": "Gourmet Burger Kitchen is a North American restaurant in the centre."
        },
        {
          "speaker": "Learner",
          "text": "I'd like to book a table for five people at 13:00 on Saturday."
        },
        {
          "speaker": "Assistant",
          "text": "Unfortunately, it is fully booked at that time. Would you like me to try another restaurant?"
        },
        {
          "speaker": "Learner",
          "text": "Yes, please. Look for another place in the same area and price range."
        },
        {
          "speaker": "Assistant",
          "text": "I'm sorry, but Gourmet Burger Kitchen is the only North American restaurant in the centre. Would you like me to search another area?"
        },
        {
          "speaker": "Learner",
          "text": "Not right now. Thank you for your help."
        },
        {
          "speaker": "Assistant",
          "text": "You're welcome. Please let me know if you need anything else."
        }
      ],
