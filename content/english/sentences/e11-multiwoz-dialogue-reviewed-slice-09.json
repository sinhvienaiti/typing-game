    {
      "schemaVersion": 1,
      "id": "dlg.multiwoz.sng0382.json",
      "scenario": "Booking a Wednesday train from Cambridge to Ely for a group",
      "cefr": "B1",
      "turns": [
        {
          "speaker": "Learner",
          "text": "I'd like a train to Ely on Wednesday."
        },
        {
          "speaker": "Assistant",
          "text": "Sure. Where would you like to depart from?"
        },
        {
          "speaker": "Learner",
          "text": "Cambridge. I'd like to leave after 15:30."
        },
        {
          "speaker": "Assistant",
          "text": "Train TR6745 leaves Cambridge at 15:50 and arrives in Ely at 16:07. The fare is £4.40 per person. Would that work?"
        },
        {
          "speaker": "Learner",
          "text": "Yes. Please book it for eight people."
        },
        {
          "speaker": "Assistant",
          "text": "Your eight seats are booked on TR6745. The fare is £4.40 each, and you can pay at the station."
        },
        {
          "speaker": "Learner",
          "text": "Thank you. That's all I need. Goodbye."
        },
        {
          "speaker": "Assistant",
          "text": "You're welcome. Have a lovely day."
        }
      ],
