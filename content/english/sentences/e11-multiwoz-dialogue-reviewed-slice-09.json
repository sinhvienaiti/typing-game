    {
      "schemaVersion": 1,
      "id": "dlg.multiwoz.sng0385.json",
      "scenario": "Checking a Monday train from Birmingham New Street to Cambridge",
      "cefr": "A2",
      "turns": [
        {
          "speaker": "Learner",
          "text": "I'd like a train on Monday that arrives in Cambridge by 19:00."
        },
        {
          "speaker": "Assistant",
          "text": "Where will you be travelling from?"
        },
        {
          "speaker": "Learner",
          "text": "I'm departing from Birmingham New Street."
        },
        {
          "speaker": "Assistant",
          "text": "I found a train that leaves at 15:40 and arrives in Cambridge at 18:23. Would that work?"
        },
        {
          "speaker": "Learner",
          "text": "Yes. Could you tell me the train ID, travel time, and price?"
        },
        {
          "speaker": "Assistant",
          "text": "Train TR5385 takes 163 minutes. Would you like me to book tickets?"
        },
        {
          "speaker": "Learner",
          "text": "No, thank you. I just need the price."
        },
        {
          "speaker": "Assistant",
          "text": "The fare is £75.10 per ticket."
        },
        {
          "speaker": "Learner",
          "text": "Great. That's all I need. Thank you for your help."
        },
        {
          "speaker": "Assistant",
          "text": "You're welcome. Have a wonderful day!"
        }
      ],
