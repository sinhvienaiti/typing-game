    {
      "schemaVersion": 1,
      "id": "dlg.multiwoz.sng1311.json",
      "scenario": "Finding the postcode for Cambridge Contemporary Art",
      "cefr": "A2",
      "turns": [
        {
          "speaker": "Learner",
          "text": "I'm looking for a museum to visit."
        },
        {
          "speaker": "Assistant",
          "text": "There are several museums in town. Do you have an area preference?"
        },
        {
          "speaker": "Learner",
          "text": "No. What would you recommend?"
        },
        {
          "speaker": "Assistant",
          "text": "If you like modern art, Cambridge Contemporary Art is a good option, and admission is free."
