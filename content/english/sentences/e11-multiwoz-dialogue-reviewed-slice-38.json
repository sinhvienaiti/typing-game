    {
      "schemaVersion": 1,
      "id": "dlg.multiwoz.woz20295.json",
      "scenario": "Switching from unavailable cheap Malaysian food to a cheap Italian restaurant and getting Zizzi Cambridge contact details",
      "cefr": "B1",
      "turns": [
        {
          "speaker": "Learner",
          "text": "Hello. I am looking for a cheap restaurant that serves Malaysian food."
        },
        {
          "speaker": "Assistant",
          "text": "I’m sorry, but there are no matches for cheap Malaysian food."
        },
        {
          "speaker": "Learner",
          "text": "How about Italian food instead?"
        },
        {
          "speaker": "Assistant",
          "text": "Which area would you prefer?"
        },
        {
          "speaker": "Learner",
          "text": "I don’t have an area preference."
        },
        {
          "speaker": "Assistant",
          "text": "Zizzi Cambridge is a cheap Italian restaurant in the centre of the city."
        },
        {
          "speaker": "Learner",
          "text": "Could I have the address and phone number, please?"
        },
        {
          "speaker": "Assistant",
          "text": "Zizzi Cambridge is at 47–53 Regent Street, and the phone number is 01223 365599."
        },
        {
          "speaker": "Learner",
          "text": "Thank you. Goodbye."
        },
        {
          "speaker": "Assistant",
          "text": "You’re welcome. Have a great day."
        }
      ],
