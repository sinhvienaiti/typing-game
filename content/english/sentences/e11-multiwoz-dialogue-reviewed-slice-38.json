      "id": "dlg.multiwoz.woz20177.json",
      "scenario": "Finding a cheap Portuguese restaurant in central Cambridge and getting its address",
      "cefr": "A2",
      "turns": [
        {
          "speaker": "Learner",
          "text": "I would like a cheap restaurant that serves Portuguese food."
        },
        {
          "speaker": "Assistant",
          "text": "I found one in the south part of town and one in the centre."
        },
        {
          "speaker": "Learner",
          "text": "Could I have the address of the restaurant in the centre, please?"
        },
        {
          "speaker": "Assistant",
          "text": "Nandos is at 33–34 Saint Andrews Street."
        },
        {
          "speaker": "Learner",
          "text": "Thank you. Goodbye."
        },
        {
          "speaker": "Assistant",
          "text": "You’re welcome. Goodbye."
        }
      ],
