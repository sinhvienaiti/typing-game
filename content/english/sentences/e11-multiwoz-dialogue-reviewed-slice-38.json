    {
      "schemaVersion": 1,
      "id": "dlg.multiwoz.woz20447.json",
      "scenario": "Finding a moderately priced Indian restaurant in east Cambridge and getting Rajmahal contact details and postcode",
      "cefr": "B1",
      "turns": [
        {
          "speaker": "Learner",
          "text": "I’d like a moderately priced restaurant in the east part of town."
        },
        {
          "speaker": "Assistant",
          "text": "There are three moderately priced restaurants in the east. Would you prefer Indian or Italian food?"
        },
        {
          "speaker": "Learner",
          "text": "I don’t have a preference. Either one is fine."
        },
        {
          "speaker": "Assistant",
          "text": "Rajmahal is a moderately priced Indian restaurant in the east. Would you like more information?"
        },
        {
          "speaker": "Learner",
          "text": "Yes, please. Could I have the address, phone number, and postcode?"
        },
        {
          "speaker": "Assistant",
          "text": "Rajmahal is at 7 Barnwell Road, Fen Ditton. The phone number is 01223 244955, and the postcode is CB5 8RG."
        },
        {
          "speaker": "Learner",
          "text": "No, thank you. That’s all I need."
        },
        {
          "speaker": "Assistant",
          "text": "You’re welcome. Goodbye."
        }
      ],
