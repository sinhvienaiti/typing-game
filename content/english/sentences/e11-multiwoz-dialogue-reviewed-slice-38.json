    {
      "schemaVersion": 1,
      "id": "dlg.multiwoz.woz20559.json",
      "scenario": "Relaxing a French restaurant price preference and getting Cote contact details",
      "cefr": "B1",
      "turns": [
        {
          "speaker": "Learner",
          "text": "Can you recommend a French restaurant that is not too expensive?"
        },
        {
          "speaker": "Assistant",
          "text": "There are no French restaurants matching that request. Would you like to consider any price range?"
        },
        {
          "speaker": "Learner",
          "text": "Yes. How about a French restaurant in any price range?"
        },
        {
          "speaker": "Assistant",
          "text": "Cote is an expensive French restaurant in the city centre."
        },
        {
          "speaker": "Learner",
          "text": "Could you give me the address and phone number, please?"
        },
        {
          "speaker": "Assistant",
          "text": "Cote is on Bridge Street, City Centre, and the phone number is 01223 311053."
        },
        {
          "speaker": "Learner",
          "text": "Thank you. That is all I needed. Goodbye."
        },
        {
          "speaker": "Assistant",
          "text": "You’re welcome. Goodbye."
