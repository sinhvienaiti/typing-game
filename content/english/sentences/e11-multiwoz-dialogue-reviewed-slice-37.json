    {
      "schemaVersion": 1,
      "id": "dlg.multiwoz.sng1067.json",
      "scenario": "Finding Churchill College in west Cambridge and getting its address",
      "cefr": "A2",
      "turns": [
        {
          "speaker": "Learner",
          "text": "I'd like to visit a college in Cambridge. Can you recommend one?"
        },
        {
          "speaker": "Assistant",
          "text": "Of course. Do you have a preferred area?"
        },
        {
          "speaker": "Learner",
          "text": "No. Just tell me where your recommendation is located."
        },
        {
          "speaker": "Assistant",
          "text": "How about Churchill College? It's in the west."
        },
        {
          "speaker": "Learner",
          "text": "That sounds perfect. Thank you."
        },
        {
          "speaker": "Assistant",
          "text": "Churchill College is on Storey's Way. Do you need any more information?"
        },
        {
          "speaker": "Learner",
          "text": "No, I'm familiar with the area. Thanks for your help."
        },
        {
          "speaker": "Assistant",
          "text": "You're welcome. Enjoy your visit."
        }
      ],
