    {
      "schemaVersion": 1,
      "id": "dlg.multiwoz.woz20015.json",
      "scenario": "Switching from unavailable Swedish food to North American food and getting Gourmet Burger Kitchen contact details",
      "cefr": "B1",
      "turns": [
        {
          "speaker": "Learner",
          "text": "I'm looking for a restaurant that serves Swedish food."
        },
        {
          "speaker": "Assistant",
          "text": "I'm sorry, but there are no restaurants serving Swedish food. Would you like another type of food?"
        },
        {
          "speaker": "Learner",
          "text": "Yes. How about North American food? I also need the address, phone number, and postcode."
        },
        {
          "speaker": "Assistant",
          "text": "Gourmet Burger Kitchen is an expensive North American restaurant in the centre of town."
        },
        {
          "speaker": "Learner",
          "text": "Could you give me the contact details, please?"
        },
        {
          "speaker": "Assistant",
          "text": "The address is Regent Street, City Centre. The phone number is 01223 312598, and the postcode is CB2 1AB."
        },
        {
          "speaker": "Learner",
          "text": "Thank you. Goodbye."
        },
        {
          "speaker": "Assistant",
          "text": "You're welcome. Goodbye."
        }
      ],
