    {
      "schemaVersion": 1,
      "id": "dlg.multiwoz.sng1052.json",
      "scenario": "Getting the postcode for Riverboat Georgina",
      "cefr": "A2",
      "turns": [
        {
          "speaker": "Learner",
          "text": "I'm looking for boating activities in town."
        },
        {
          "speaker": "Assistant",
          "text": "There are several boating attractions. Do you have a preferred area?"
        },
        {
          "speaker": "Learner",
          "text": "No, I don't have a preference."
        },
        {
          "speaker": "Assistant",
          "text": "Options include Camboats, Riverboat Georgina, Scudamores Punting Co., and The Cambridge Punter."
        },
        {
          "speaker": "Learner",
          "text": "Could you give me the postcode for Riverboat Georgina, please?"
        },
        {
          "speaker": "Assistant",
          "text": "Yes. The postcode is CB4 3AX."
        },
        {
          "speaker": "Learner",
          "text": "Thank you. That's all I needed."
        },
        {
          "speaker": "Assistant",
          "text": "You're welcome. Have a great day."
        }
      ],
