    {
      "schemaVersion": 1,
      "id": "dlg.multiwoz.sng01296.json",
      "scenario": "Finding a four-star hotel after none match in north Cambridge and getting University Arms Hotel's address and postcode",
      "cefr": "B1",
      "turns": [
        {
          "speaker": "Learner",
          "text": "I'm looking for a four-star hotel. Free parking is not required."
        },
        {
          "speaker": "Assistant",
          "text": "Which area of town would you prefer?"
        },
        {
          "speaker": "Learner",
          "text": "Preferably the north side of town, or somewhere near a shopping centre."
        },
        {
          "speaker": "Assistant",
          "text": "I found several guesthouses, but no four-star hotels in the north. Would you consider another option?"
        },
        {
          "speaker": "Learner",
          "text": "I would prefer a hotel. Is there one with free Wi-Fi?"
        },
        {
          "speaker": "Assistant",
          "text": "University Arms Hotel is an option with free Wi-Fi."
        },
        {
          "speaker": "Learner",
          "text": "That sounds great. Could you give me the address and postcode?"
        },
        {
          "speaker": "Assistant",
          "text": "The address is Regent Street, and the postcode is CB2 1AD."
        },
        {
          "speaker": "Learner",
          "text": "Thanks. That's all. Goodbye."
        },
        {
          "speaker": "Assistant",
          "text": "You're welcome. Goodbye."
        }
      ],
