    {
      "schemaVersion": 1,
      "id": "dlg.multiwoz.mul1979.json",
      "scenario": "Getting the Fitzwilliam Museum postcode and then checking a train from Broxbourne to Cambridge",
      "cefr": "B1",
      "turns": [
        {
          "speaker": "Learner",
          "text": "I'm looking for the Fitzwilliam Museum."
        },
        {
          "speaker": "Assistant",
          "text": "The Fitzwilliam Museum is on Trumpington Street. Would you like any other information about it?"
        },
        {
          "speaker": "Learner",
          "text": "Could you give me the exact postcode, please?"
        },
        {
          "speaker": "Assistant",
          "text": "Yes. The postcode is CB2 1RB. Is there anything else I can help with?"
        },
        {
          "speaker": "Learner",
          "text": "Yes. I'm also looking for a train from Broxbourne to Cambridge."
        },
        {
          "speaker": "Assistant",
          "text": "Train TR5570 is an option for that journey."
        },
        {
          "speaker": "Learner",
          "text": "Great. Thank you very much for your help."
        },
        {
          "speaker": "Assistant",
          "text": "Is there anything else I can do for you today?"
        },
        {
          "speaker": "Learner",
          "text": "No, that's all. Thank you."
        },
        {
          "speaker": "Assistant",
          "text": "You're welcome. Have a wonderful day. Goodbye."
        }
      ],
