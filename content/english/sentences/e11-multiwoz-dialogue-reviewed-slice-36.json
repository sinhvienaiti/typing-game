    {
      "schemaVersion": 1,
      "id": "dlg.multiwoz.pmul4970.json",
      "scenario": "Finding a Sunday train from Cambridge to Peterborough and checking an east-side hotel",
      "cefr": "B1",
      "turns": [
        {
          "speaker": "Learner",
          "text": "I'm planning a trip in Cambridge."
        },
        {
          "speaker": "Assistant",
          "text": "That sounds like fun. What information can I help you find?"
        },
        {
          "speaker": "Learner",
          "text": "I need a train from Cambridge to Peterborough on Sunday that arrives by 21:45."
        },
        {
          "speaker": "Assistant",
          "text": "What station will you be departing from?"
        },
        {
          "speaker": "Learner",
          "text": "I'll be departing from Cambridge. I need the departure time, train ID, and fare."
        },
        {
          "speaker": "Assistant",
          "text": "Train TR6958 leaves Cambridge at 20:34 and arrives in Peterborough at 21:24. The fare is £13.20."
        },
        {
          "speaker": "Learner",
          "text": "Thanks. I'm also looking for a place to stay in the east."
        },
        {
          "speaker": "Assistant",
          "text": "Express by Holiday Inn Cambridge is a two-star expensive hotel in the east with free parking and internet. Its address is 15–17 Norman Way, Coldhams Business Park."
        }
