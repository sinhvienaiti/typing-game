      "schemaVersion": 1,
      "id": "dlg.multiwoz.pmul3773.json",
      "scenario": "Checking a Wednesday afternoon train from Cambridge to Birmingham New Street",
      "cefr": "A2",
      "turns": [
        {
          "speaker": "Learner",
          "text": "I need a train from Cambridge to Birmingham New Street on Wednesday, leaving after 13:45."
        },
        {
          "speaker": "Assistant",
          "text": "Train TR8860 leaves Cambridge at 14:01 and arrives at Birmingham New Street at 16:44."
        },
        {
          "speaker": "Learner",
          "text": "Could you tell me the train ID and fare, please?"
        },
        {
          "speaker": "Assistant",
          "text": "The train ID is TR8860, and the fare is £75.10."
        },
        {
          "speaker": "Learner",
          "text": "Great. That's all I needed. Thank you."
        },
        {
          "speaker": "Assistant",
          "text": "You're welcome. Have a good trip."
        }
      ],
