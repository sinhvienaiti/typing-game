      "scenario": "Finding a moderately priced restaurant in the south and getting its contact details",
      "cefr": "A2",
      "turns": [
        {
          "speaker": "Learner",
          "text": "I would like a moderately priced restaurant in the south part of town."
        },
        {
          "speaker": "Assistant",
          "text": "Restaurant Alimentum serves modern European food in the south and is in the moderate price range."
        },
        {
          "speaker": "Learner",
          "text": "Could you give me the address and phone number?"
        },
        {
          "speaker": "Assistant",
          "text": "The phone number is 01223 413000, and the address is 152-154 Hills Road."
        },
        {
          "speaker": "Learner",
          "text": "Thank you. Goodbye."
        },
        {
          "speaker": "Assistant",
          "text": "You're welcome. Have a great day!"
        }
