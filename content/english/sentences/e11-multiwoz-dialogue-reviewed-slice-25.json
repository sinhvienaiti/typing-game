      "turns": [
        {
          "speaker": "Learner",
          "text": "I'm looking for an expensive restaurant in the east part of town."
        },
        {
          "speaker": "Assistant",
          "text": "What type of food would you prefer?"
        },
        {
          "speaker": "Learner",
          "text": "I don't mind. I just need the address, phone number, and postcode, please."
        },
        {
