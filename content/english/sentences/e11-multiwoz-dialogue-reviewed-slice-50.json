      "scenario": "Checking Monday train departure options from Norwich to Cambridge before an 18:00 arrival cutoff",
      "cefr": "B1",
      "turns": [
        {
          "speaker": "Learner",
          "text": "I need a train from Norwich to Cambridge on Monday, arriving by 18:00."
        },
        {
          "speaker": "Assistant",
          "text": "There are 12 trains that meet that requirement."
        },
        {
          "speaker": "Learner",
          "text": "What are the earliest and latest departure times among those options?"
        },
        {
          "speaker": "Assistant",
          "text": "The first matching train leaves Norwich at 05:16, and the last one leaves at 16:16."
        },
        {
          "speaker": "Learner",
          "text": "I am not ready to book yet. Thanks for the information."
        },
        {
          "speaker": "Assistant",
          "text": "You’re welcome. Let me know if you need help booking later."
        }
