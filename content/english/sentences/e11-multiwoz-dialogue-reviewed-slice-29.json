      "id": "dlg.multiwoz.woz20135.json",
      "scenario": "Switching from unavailable Australasian food to a modern European restaurant and asking for its phone number",
      "cefr": "B1",
      "turns": [
        {
          "speaker": "Learner",
          "text": "I'm looking for a restaurant that serves Australasian food."
        },
        {
          "speaker": "Assistant",
          "text": "I'm sorry, but I couldn't find any restaurants serving Australasian food."
        },
        {
          "speaker": "Learner",
          "text": "Okay. How about modern European food?"
        },
        {
          "speaker": "Assistant",
          "text": "There are several restaurants serving modern European food. Do you have an area or price preference?"
        },
        {
          "speaker": "Learner",
          "text": "No, I don't have a preference."
        },
        {
          "speaker": "Assistant",
          "text": "Darrys Cookhouse and Wine Shop is one option you might enjoy."
        },
        {
          "speaker": "Learner",
          "text": "That sounds good. What is the phone number?"
        },
        {
          "speaker": "Assistant",
          "text": "The phone number is 01223 505015. Would you like any other information?"
        },
        {
          "speaker": "Learner",
          "text": "No, thank you. Goodbye!"
        },
        {
          "speaker": "Assistant",
          "text": "Goodbye."
        }
      ],
