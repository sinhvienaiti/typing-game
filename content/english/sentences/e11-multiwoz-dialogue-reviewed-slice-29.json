    {
      "schemaVersion": 1,
      "id": "dlg.multiwoz.woz20182.json",
      "scenario": "Switching from unavailable Cuban food to a moderately priced British restaurant and asking for its phone number",
      "cefr": "B1",
      "turns": [
        {
          "speaker": "Learner",
          "text": "I'm looking for a moderately priced restaurant that serves Cuban food."
        },
        {
          "speaker": "Assistant",
          "text": "I'm sorry, but there are no Cuban restaurants in the moderate price range. Would you like a different type of food?"
        },
        {
          "speaker": "Learner",
          "text": "Are there any restaurants that serve British food?"
        },
        {
          "speaker": "Assistant",
          "text": "Fitzbillies serves British food. Would you like more information about it?"
        },
        {
          "speaker": "Learner",
          "text": "Could I have the phone number?"
        },
        {
          "speaker": "Assistant",
          "text": "Fitzbillies' phone number is 01223 352500. Would you also like the address?"
        },
        {
          "speaker": "Learner",
          "text": "No, thanks. That's all I need."
        },
        {
          "speaker": "Assistant",
          "text": "You're welcome. Enjoy your meal."
        },
        {
          "speaker": "Learner",
          "text": "Thank you. Goodbye."
        },
        {
          "speaker": "Assistant",
          "text": "Goodbye."
        }
