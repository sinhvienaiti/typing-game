      "id": "dlg.multiwoz.pmul1292.json",
      "scenario": "Getting information about Lynne Strover Gallery and finding a Thursday train to Peterborough",
      "cefr": "B1",
      "turns": [
        {
          "speaker": "Learner",
          "text": "I'm looking for information about an attraction called Lynne Strover Gallery."
        },
        {
          "speaker": "Assistant",
          "text": "It is in the west, and admission is free. What else would you like to know?"
        },
        {
          "speaker": "Learner",
          "text": "What type of attraction is Lynne Strover Gallery, and what is its address?"
        },
        {
          "speaker": "Assistant",
          "text": "Lynne Strover Gallery is a museum at 23 High Street, Fen Ditton, postcode CB3 0AQ."
        },
