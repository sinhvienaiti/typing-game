    {
      "schemaVersion": 1,
      "id": "dlg.multiwoz.mul2641.json",
      "scenario": "Finding a two-star hotel in north Cambridge and then asking about a theatre",
      "cefr": "B1",
      "turns": [
        {
          "speaker": "Learner",
          "text": "Hi, can you help me find a hotel on the north side of town?"
        },
        {
          "speaker": "Assistant",
          "text": "Sure. Ashley Hotel and Lovell Lodge are both on the north side of town."
        },
        {
          "speaker": "Learner",
          "text": "Do either of them have two stars?"
        },
        {
          "speaker": "Assistant",
          "text": "Yes. They both have two stars."
        },
        {
          "speaker": "Learner",
          "text": "Can I get the postcode of one you would recommend?"
        },
        {
          "speaker": "Assistant",
          "text": "I recommend Lovell Lodge. Its postcode is CB4 1SR. Would you like more information or help booking a room?"
        },
        {
          "speaker": "Learner",
          "text": "Can you also tell me about a theatre in town?"
        },
        {
          "speaker": "Assistant",
          "text": "ADC Theatre is on Park Street, postcode CB5 8AS. There are four other theatres in Cambridge."
        },
        {
          "speaker": "Learner",
          "text": "Thank you. That's all I needed to know."
        },
        {
          "speaker": "Assistant",
          "text": "Excellent. Have a good day!"
        }
      ],
