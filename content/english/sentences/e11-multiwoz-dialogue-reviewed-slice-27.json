    {
      "schemaVersion": 1,
      "id": "dlg.multiwoz.pmul3368.json",
      "scenario": "Visiting Broughton House Gallery and booking a moderately priced Turkish restaurant in the same area",
      "cefr": "B1",
      "turns": [
        {
          "speaker": "Learner",
          "text": "I would like to find a museum in the centre."
        },
        {
          "speaker": "Assistant",
          "text": "How about Broughton House Gallery? Admission is free."
        },
        {
          "speaker": "Learner",
          "text": "Sure. What is the address of Broughton House Gallery?"
        },
