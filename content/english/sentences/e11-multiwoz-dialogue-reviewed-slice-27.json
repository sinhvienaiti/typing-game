        {
          "speaker": "Learner",
          "text": "I'm going to Peterborough on Thursday, and I need to leave after 16:30."
        },
        {
          "speaker": "Assistant",
          "text": "Train TR8132 leaves at 16:34. How many tickets do you need?"
        },
        {
          "speaker": "Learner",
          "text": "I would like four tickets, please."
        },
        {
          "speaker": "Assistant",
          "text": "The tickets cost £16.50 each. Would you like me to reserve them?"
        }
