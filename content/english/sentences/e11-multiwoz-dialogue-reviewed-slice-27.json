    {
      "schemaVersion": 1,
      "id": "dlg.multiwoz.mul0566.json",
      "scenario": "Booking a Saturday train from Stansted Airport to Cambridge and asking about Cambridge Book and Print Gallery",
      "cefr": "B1",
      "turns": [
        {
          "speaker": "Learner",
          "text": "I need to take a train on Saturday."
        },
        {
          "speaker": "Assistant",
          "text": "I can help with that. Where are you headed, and what time would you like to leave?"
        },
        {
          "speaker": "Learner",
          "text": "I'm headed to Cambridge, and the train needs to leave after 9:45."
        },
        {
          "speaker": "Assistant",
          "text": "I found 149 trains. Where will you be departing from?"
        },
        {
          "speaker": "Learner",
          "text": "I'd like to depart from Stansted Airport. Can you book a train for three people and provide the reference number?"
        },
        {
          "speaker": "Assistant",
          "text": "Sure. The train leaves at 10:24. Your reference number is MEFVDBWF. What else can I help with today?"
        },
        {
          "speaker": "Learner",
          "text": "I'm also looking for the Cambridge Book and Print Gallery."
        },
        {
          "speaker": "Assistant",
          "text": "The Cambridge Book and Print Gallery is a museum in the west area at 49 Newnham Road."
        },
        {
          "speaker": "Learner",
          "text": "That will be everything. Thank you!"
        },
        {
          "speaker": "Assistant",
          "text": "You're welcome. Goodbye."
        }
      ],
