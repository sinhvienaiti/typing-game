    {
      "schemaVersion": 1,
      "id": "dlg.multiwoz.woz20428.json",
      "scenario": "Switching from Lebanese to Chinese food in the east and asking for contact details",
      "cefr": "B1",
      "turns": [
        {
          "speaker": "Learner",
          "text": "I’m looking for a Lebanese restaurant in the east part of town."
        },
        {
          "speaker": "Assistant",
          "text": "There are no Lebanese restaurants in the east. Would you like to try another type of food?"
        },
        {
          "speaker": "Learner",
          "text": "How about Chinese food? I’d like the address, phone number, and postcode."
        },
        {
          "speaker": "Assistant",
          "text": "Yu Garden is at 529 Newmarket Road, Fen Ditton. The postcode is CB5 8PA, and the phone number is 01223 248882."
        },
        {
          "speaker": "Learner",
          "text": "Is it in the east part of town?"
        },
        {
          "speaker": "Assistant",
          "text": "Yes, Yu Garden is in the east part of town."
        },
        {
          "speaker": "Learner",
          "text": "That’s all I need. Thank you. Goodbye."
        },
        {
          "speaker": "Assistant",
          "text": "You’re welcome. Goodbye!"
        }
      ],
