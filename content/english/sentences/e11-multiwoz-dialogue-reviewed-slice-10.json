    {
      "schemaVersion": 1,
      "id": "dlg.multiwoz.woz20188.json",
      "scenario": "Comparing cheap restaurants in north Cambridge and getting Royal Spice contact details",
      "cefr": "B1",
      "turns": [
        {
          "speaker": "Learner",
          "text": "I would like a cheap restaurant in the north part of town, please."
        },
        {
          "speaker": "Assistant",
          "text": "Da Vinci Pizzeria is an Italian restaurant in the north part of town. Would you like its phone number or address?"
        },
        {
          "speaker": "Learner",
          "text": "Is there anything else?"
        },
        {
          "speaker": "Assistant",
          "text": "City Stop Restaurant is also in the north part of town and is in the cheap price range."
        },
        {
          "speaker": "Learner",
          "text": "Is there another cheap restaurant in the north?"
        },
        {
          "speaker": "Assistant",
          "text": "Royal Spice is a cheap restaurant in the north part of town. Would you like its address?"
        },
        {
          "speaker": "Learner",
          "text": "Yes, please. Could I have the address and phone number for Royal Spice?"
        },
        {
          "speaker": "Assistant",
          "text": "Royal Spice is at Victoria Avenue, Chesterton, and the phone number is 01733 553355."
        },
        {
          "speaker": "Learner",
          "text": "No, that's everything. Thank you. Goodbye."
        },
        {
          "speaker": "Assistant",
          "text": "Thank you. Goodbye."
        }
      ],
