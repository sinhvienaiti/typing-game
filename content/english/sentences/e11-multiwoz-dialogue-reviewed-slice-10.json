      "turns": [
        {
          "speaker": "Learner",
          "text": "I want to find a cheap restaurant in the east part of town."
        },
        {
          "speaker": "Assistant",
          "text": "The Missing Sock is a cheap restaurant in the east part of town."
        },
        {
          "speaker": "Learner",
          "text": "What is the address and phone number?"
        },
        {
          "speaker": "Assistant",
          "text": "The phone number is 01223 812660, and the address is Finders Corner, Newmarket Road."
        },
        {
          "speaker": "Learner",
          "text": "Okay, thanks. That's all I need."
        },
        {
          "speaker": "Assistant",
          "text": "You're welcome. Goodbye."
        }
