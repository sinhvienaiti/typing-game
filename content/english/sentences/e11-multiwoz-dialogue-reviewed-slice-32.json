      "id": "dlg.multiwoz.woz20548.json",
      "scenario": "Moving from a moderately priced European restaurant to Cambridge Lodge Restaurant and getting its address, postcode, and phone number",
      "cefr": "B1",
      "turns": [
        {
          "speaker": "Learner",
          "text": "I'm looking for a moderately priced restaurant that serves European food."
        },
        {
          "speaker": "Assistant",
          "text": "De Luca Cucina and Bar is a moderately priced European restaurant in the centre of town."
        },
        {
          "speaker": "Learner",
          "text": "Is there another European restaurant? Could I have its address and postcode, please?"
        },
        {
          "speaker": "Assistant",
          "text": "Cambridge Lodge Restaurant is an expensive European restaurant at Cambridge Lodge Hotel, 139 Huntingdon Road. Its postcode is CB3 0DQ."
        },
        {
          "speaker": "Learner",
          "text": "What is the phone number?"
        },
        {
          "speaker": "Assistant",
          "text": "The phone number is 01223 355166."
        },
        {
          "speaker": "Learner",
          "text": "Thank you. Goodbye."
        },
        {
          "speaker": "Assistant",
          "text": "You're welcome. Goodbye."
        }
      ],
