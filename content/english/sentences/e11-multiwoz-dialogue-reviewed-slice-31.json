      "id": "dlg.multiwoz.woz20263.json",
      "scenario": "Switching from unavailable Danish food to an international restaurant and getting its phone number and postcode",
      "cefr": "B1",
      "turns": [
        {
          "speaker": "Learner",
          "text": "Hello. I'm looking for a restaurant that serves Danish food."
        },
        {
          "speaker": "Assistant",
          "text": "I'm sorry, but there are no Danish restaurants listed. Would you like a different type of food?"
        },
        {
          "speaker": "Learner",
          "text": "How about international food?"
        },
        {
          "speaker": "Assistant",
          "text": "There are three international restaurants. Do you have a preferred price range?"
        },
        {
          "speaker": "Learner",
          "text": "No, I don't have a price preference."
        },
        {
          "speaker": "Assistant",
          "text": "Bloomsbury Restaurant is a moderately priced international restaurant in the centre."
        },
        {
          "speaker": "Learner",
          "text": "Could I have the phone number and postcode, please?"
        },
        {
          "speaker": "Assistant",
          "text": "The phone number is 0871 942 9180, and the postcode is CB2 3DT."
        },
        {
          "speaker": "Learner",
          "text": "Thank you. Goodbye."
        },
        {
          "speaker": "Assistant",
          "text": "You're welcome. Goodbye."
        }
      ],
