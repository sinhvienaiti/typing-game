      "scenario": "Getting contact details for an international restaurant without a price preference",
      "cefr": "A2",
      "turns": [
        {
          "speaker": "Learner",
          "text": "I'm looking for a restaurant serving international food anywhere in town."
        },
        {
          "speaker": "Assistant",
          "text": "There are three international restaurants. Do you have a price preference?"
        },
        {
          "speaker": "Learner",
          "text": "No, I don't mind the price."
        },
        {
          "speaker": "Assistant",
          "text": "Bloomsbury Restaurant serves international food. It is at Crowne Plaza Hotel, 20 Downing Street, and the phone number is 0871 942 9180. Can I help with anything else?"
        },
        {
          "speaker": "Learner",
          "text": "Thank you. Goodbye."
        },
        {
          "speaker": "Assistant",
          "text": "Thank you. Have a wonderful day!"
        }
