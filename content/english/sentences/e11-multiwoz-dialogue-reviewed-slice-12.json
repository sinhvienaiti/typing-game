    {
      "schemaVersion": 1,
      "id": "dlg.multiwoz.mul1781.json",
      "scenario": "Checking an early Sunday train from Kings Lynn to Cambridge and visiting the Regency Gallery",
      "cefr": "B1",
      "turns": [
        {
          "speaker": "Learner",
          "text": "Are there any trains from Kings Lynn to Cambridge on Sunday that arrive by 11:30?"
        },
        {
          "speaker": "Assistant",
          "text": "Yes. Train TR6003 leaves at 05:11 and arrives at 05:58, while TR0412 leaves at 06:11 and arrives at 06:58. Would you like to book either one?"
        },
        {
          "speaker": "Learner",
          "text": "No, thank you. I have the train information I need."
        },
        {
          "speaker": "Assistant",
          "text": "Is there anything else I can help you with?"
        },
        {
          "speaker": "Learner",
          "text": "Yes. I'd like information about the Regency Gallery."
        },
        {
          "speaker": "Assistant",
          "text": "The Regency Gallery is a museum in the centre at 39 Fitzroy Street. Admission is free."
        },
        {
          "speaker": "Learner",
          "text": "That's all I needed. Thank you so much!"
        },
        {
          "speaker": "Assistant",
          "text": "Happy to help. Enjoy your time in Cambridge!"
        }
      ],
