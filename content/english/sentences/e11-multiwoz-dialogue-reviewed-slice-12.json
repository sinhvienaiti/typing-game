      "id": "dlg.multiwoz.mul1424.json",
      "scenario": "Choosing a modern European restaurant and then checking a Wednesday train from Broxbourne to Cambridge",
      "cefr": "B1",
      "turns": [
        {
          "speaker": "Learner",
          "text": "I need a place to eat in the centre that serves modern European food."
        },
        {
          "speaker": "Assistant",
          "text": "There are four modern European restaurants in the centre. Darrys Cookhouse and Wine Shop is a popular option. Would you like a reservation?"
        },
        {
          "speaker": "Learner",
          "text": "Not right now. I also need a train from Broxbourne to Cambridge on Wednesday that leaves after 15:00."
        },
        {
          "speaker": "Assistant",
          "text": "Train TR5972 leaves Broxbourne at 15:32 and arrives in Cambridge at 16:32. Would you like to buy a ticket?"
        },
        {
          "speaker": "Learner",
          "text": "Not at this time, thanks. That's all I need today."
        },
        {
          "speaker": "Assistant",
          "text": "You're welcome. Have a lovely day."
        }
      ],
