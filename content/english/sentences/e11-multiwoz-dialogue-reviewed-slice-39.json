      "id": "dlg.multiwoz.pmul0777.json",
      "scenario": "Finding a Wednesday train from Kings Lynn to Cambridge after 11:45",
      "cefr": "B1",
      "turns": [
        {
          "speaker": "Learner",
          "text": "Can you help me find a train ticket for Wednesday?"
        },
        {
          "speaker": "Assistant",
          "text": "Of course. What time would you like to leave, and where are you travelling from and to?"
        },
        {
          "speaker": "Learner",
          "text": "I need to leave after 11:45 from Kings Lynn and travel to Cambridge."
        },
        {
          "speaker": "Assistant",
          "text": "Train TR7040 leaves Kings Lynn at 12:11 and arrives in Cambridge at 12:58."
        },
        {
          "speaker": "Learner",
          "text": "How much does the trip cost?"
        },
        {
          "speaker": "Assistant",
          "text": "The fare is £9.80."
        }
      ],
