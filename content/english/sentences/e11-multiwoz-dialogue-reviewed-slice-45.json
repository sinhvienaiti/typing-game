      "scenario": "Finding a moderately priced European restaurant and getting Hotel du Vin and Bistro contact details",
      "cefr": "A2",
      "turns": [
        {
          "speaker": "Learner",
          "text": "Hello, I'm looking for a moderately priced restaurant that serves European food."
        },
        {
          "speaker": "Assistant",
          "text": "Would the centre part of town be convenient for you?"
        },
        {
          "speaker": "Learner",
          "text": "The area doesn't matter."
        },
        {
          "speaker": "Assistant",
          "text": "May I suggest Hotel du Vin and Bistro?"
        },
        {
          "speaker": "Learner",
          "text": "Could you give me the address and phone number, please?"
        },
        {
          "speaker": "Assistant",
          "text": "The address is 15–19 Trumpington Street, and the phone number is 01223 227330."
        },
        {
          "speaker": "Learner",
          "text": "Thank you!"
        },
        {
          "speaker": "Assistant",
          "text": "You're welcome. Goodbye."
        }
