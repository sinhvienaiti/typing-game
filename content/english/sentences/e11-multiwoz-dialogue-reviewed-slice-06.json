    {
      "schemaVersion": 1,
      "id": "dlg.multiwoz.woz20292.json",
      "scenario": "Switching from vegetarian to Turkish food and asking for an address",
      "cefr": "B1",
      "turns": [
        {
          "speaker": "Learner",
          "text": "Hello. I'm looking for a restaurant that serves vegetarian food."
        },
        {
          "speaker": "Assistant",
          "text": "There are no restaurants listed as serving vegetarian food."
        },
        {
          "speaker": "Learner",
          "text": "How about Turkish food?"
        },
        {
          "speaker": "Assistant",
          "text": "There are three Turkish restaurants. Do you have a price preference?"
        },
        {
          "speaker": "Learner",
          "text": "I don't mind the price."
        },
        {
          "speaker": "Assistant",
          "text": "Anatolia is a Turkish restaurant in the moderate price range and is in the centre of town. Would you like the address and phone number?"
        },
        {
          "speaker": "Learner",
          "text": "Just the address, please."
        },
        {
          "speaker": "Assistant",
          "text": "Anatolia is at 30 Bridge Street, City Centre."
        },
        {
          "speaker": "Learner",
          "text": "Thank you. Goodbye."
        },
        {
          "speaker": "Assistant",
          "text": "You're welcome. Goodbye!"
        }
