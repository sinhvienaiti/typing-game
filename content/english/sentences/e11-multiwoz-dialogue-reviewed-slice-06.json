    {
      "schemaVersion": 1,
      "id": "dlg.multiwoz.sng1061.json",
      "scenario": "Finding a low-cost nightclub in the town centre",
      "cefr": "A2",
      "turns": [
        {
          "speaker": "Learner",
          "text": "I'm looking for a nightclub in the centre of town."
        },
        {
          "speaker": "Assistant",
          "text": "There are five nightclubs in the centre. Soul Tree Nightclub has the lowest entrance fee at £4."
        },
        {
          "speaker": "Learner",
          "text": "That sounds good. Could I have the address and postcode?"
        },
        {
          "speaker": "Assistant",
          "text": "Of course. It is at 1–6 Corn Exchange Street, and the postcode is CB2 3QF."
        },
        {
          "speaker": "Learner",
          "text": "No, that's all I need today. Thank you for your help!"
        },
        {
          "speaker": "Assistant",
          "text": "You're welcome! Have fun. Goodbye!"
        }
      ],
