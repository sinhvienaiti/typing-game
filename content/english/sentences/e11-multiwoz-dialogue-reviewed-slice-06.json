      "schemaVersion": 1,
      "id": "dlg.multiwoz.sng1054.json",
      "scenario": "Finding an entertainment attraction in east Cambridge",
      "cefr": "A2",
      "turns": [
        {
          "speaker": "Learner",
          "text": "I'd like to find somewhere to go in the east part of town."
        },
        {
          "speaker": "Assistant",
          "text": "I can suggest several options. Would you prefer an entertainment venue, a museum, a park, or something else?"
        },
        {
          "speaker": "Learner",
          "text": "Anything in the east is fine. Could you give me the address and type of one attraction?"
        },
        {
          "speaker": "Assistant",
          "text": "How about Funky Fun House? It is an entertainment venue at 8 Mercers Row, Mercers Row Industrial Estate."
        },
        {
          "speaker": "Learner",
          "text": "Sounds great. That's all I needed. Thank you!"
        },
        {
          "speaker": "Assistant",
          "text": "You're welcome. Have a good day. Goodbye!"
        }
      ],
