    {
      "schemaVersion": 1,
      "id": "dlg.multiwoz.woz20517.json",
      "scenario": "Choosing a moderately priced restaurant in east Cambridge and asking for an address",
      "cefr": "A2",
      "turns": [
        {
          "speaker": "Learner",
          "text": "Hello. I'm looking for a moderately priced restaurant in the east part of town."
        },
        {
          "speaker": "Assistant",
          "text": "Do you have a preference for the type of food?"
        },
        {
          "speaker": "Learner",
          "text": "No, I don't mind."
        },
        {
          "speaker": "Assistant",
          "text": "There are three options to choose from."
        },
        {
          "speaker": "Learner",
          "text": "Okay. What are they?"
        },
        {
          "speaker": "Assistant",
          "text": "Curry Prince and Rajmahal both serve Indian food, and Pizza Hut Fen Ditton serves Italian food."
        },
        {
          "speaker": "Learner",
          "text": "Could I get the address of one of them?"
        },
        {
          "speaker": "Assistant",
          "text": "Certainly. Curry Prince is at 451 Newmarket Road, Fen Ditton."
        },
        {
          "speaker": "Learner",
          "text": "Thank you. Goodbye."
        },
        {
          "speaker": "Assistant",
          "text": "You're welcome. Goodbye!"
        }
      ],
