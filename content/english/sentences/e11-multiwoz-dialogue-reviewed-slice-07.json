      "id": "dlg.multiwoz.woz20482.json",
      "scenario": "Getting the phone number for a moderately priced restaurant in east Cambridge",
      "cefr": "A2",
      "turns": [
        {
          "speaker": "Learner",
          "text": "Hello. I'm looking for a moderately priced restaurant in the east part of town."
        },
        {
          "speaker": "Assistant",
          "text": "Curry Prince is in the east part of town and is in the moderate price range."
        },
        {
          "speaker": "Learner",
          "text": "What is their phone number?"
        },
        {
          "speaker": "Assistant",
          "text": "Their phone number is 01223 566388."
        },
        {
          "speaker": "Learner",
          "text": "That's all I needed to know. Thank you."
        },
        {
          "speaker": "Assistant",
          "text": "You're welcome. Goodbye!"
        }
      ],
