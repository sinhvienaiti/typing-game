      "scenario": "Getting the address and entrance fee for People's Portraits Exhibition at Girton College",
      "cefr": "A2",
      "turns": [
        {
          "speaker": "Learner",
          "text": "I'm looking for People's Portraits Exhibition at Girton College. Could I have its address?"
        },
        {
          "speaker": "Assistant",
          "text": "It is at Girton College, Huntingdon Road, in the west part of town. The postcode is CB3 0JG."
        },
        {
          "speaker": "Learner",
          "text": "Is there an entrance fee?"
        },
        {
          "speaker": "Assistant",
          "text": "No, there is no entrance fee."
        },
        {
          "speaker": "Learner",
          "text": "That's all I need. Thank you."
        },
        {
          "speaker": "Assistant",
          "text": "You're welcome."
        }
      ],
