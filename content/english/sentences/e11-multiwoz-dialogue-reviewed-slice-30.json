      "id": "dlg.multiwoz.pmul4275.json",
      "scenario": "Finding a Monday train from Cambridge to Peterborough and a cheap guesthouse with Wi-Fi",
      "cefr": "B1",
      "turns": [
        {
          "speaker": "Learner",
          "text": "I need a train from Cambridge to Peterborough on Monday."
        },
        {
          "speaker": "Assistant",
          "text": "What time do you need to arrive?"
        },
        {
          "speaker": "Learner",
          "text": "I need to arrive by 15:30."
        },
        {
          "speaker": "Assistant",
          "text": "Train TR7786 arrives in Peterborough at 15:24."
        },
        {
          "speaker": "Learner",
          "text": "What is the travel time and fare?"
        },
        {
          "speaker": "Assistant",
          "text": "The journey takes 50 minutes, and the fare is £16.50."
        },
        {
          "speaker": "Learner",
          "text": "Great. I also need a cheap place to stay in Cambridge with free Wi-Fi."
        },
        {
          "speaker": "Assistant",
          "text": "Alexander Bed and Breakfast is a guesthouse at 56 Saint Barnabas Road. It offers free Wi-Fi and free parking."
        },
        {
          "speaker": "Learner",
          "text": "That sounds good. Thank you."
        },
        {
          "speaker": "Assistant",
          "text": "You're welcome."
        }
