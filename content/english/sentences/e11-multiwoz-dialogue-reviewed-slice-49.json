      "id": "dlg.multiwoz.sng01284.json",
      "scenario": "Checking a Saturday train from Bishops Stortford to Cambridge arriving before 08:15",
      "cefr": "A2",
      "turns": [
        {
          "speaker": "Learner",
          "text": "I'm looking for a train from Bishops Stortford to Cambridge on Saturday."
        },
        {
          "speaker": "Assistant",
          "text": "What time would you like to arrive in Cambridge?"
        },
        {
          "speaker": "Learner",
          "text": "I'd like to arrive by 08:15."
        },
        {
          "speaker": "Assistant",
          "text": "Train TR4162 arrives in Cambridge at 08:07. Would that suit you?"
        },
        {
          "speaker": "Learner",
          "text": "Yes. What time does it depart, and how long is the journey?"
        },
        {
          "speaker": "Assistant",
          "text": "TR4162 departs at 07:29, and the journey takes 38 minutes. Would you like to reserve a seat?"
        },
        {
          "speaker": "Learner",
          "text": "Not yet. I was only looking for information. Thank you."
        },
        {
          "speaker": "Assistant",
          "text": "You're welcome. Contact us again if you need anything else."
        }
      ],
