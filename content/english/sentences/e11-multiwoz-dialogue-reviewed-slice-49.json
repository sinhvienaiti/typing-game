    {
      "schemaVersion": 1,
      "id": "dlg.multiwoz.pmul3974.json",
      "scenario": "Booking a Sunday table for one at The Gandhi at 11:45",
      "cefr": "A2",
      "turns": [
        {
          "speaker": "Learner",
          "text": "I'm looking for a cheap Indian restaurant."
        },
        {
          "speaker": "Assistant",
          "text": "I have four options. Do you have a preferred area?"
        },
        {
          "speaker": "Learner",
          "text": "Which options are in the centre?"
        },
        {
          "speaker": "Assistant",
          "text": "The Gandhi, Kohinoor, and Mahal of Cambridge are all in the centre. Would you like more information about any of them?"
        },
        {
          "speaker": "Learner",
          "text": "I'd like to book The Gandhi for one person on Sunday at 11:45."
        },
        {
          "speaker": "Assistant",
          "text": "Your table is booked. The reference number is BXPQUZAN."
        },
        {
          "speaker": "Learner",
          "text": "That's all I needed. Thank you!"
        },
        {
          "speaker": "Assistant",
          "text": "You're welcome. Enjoy your meal!"
        }
      ],
