    {
      "schemaVersion": 1,
      "id": "dlg.multiwoz.sng01411.json",
      "scenario": "Getting the address for Ashley Hotel after checking parking and Wi-Fi",
      "cefr": "A2",
      "turns": [
        {
          "speaker": "Learner",
          "text": "I'm looking for a moderately priced two-star hotel with free parking."
        },
        {
          "speaker": "Assistant",
          "text": "Ashley Hotel matches those requirements."
        },
        {
          "speaker": "Learner",
          "text": "Does Ashley Hotel also have free Wi-Fi?"
        },
        {
          "speaker": "Assistant",
          "text": "Yes. Ashley Hotel has free internet and free parking."
        },
        {
          "speaker": "Learner",
          "text": "Great. What's the address?"
        },
        {
          "speaker": "Assistant",
          "text": "The address is 74 Chesterton Road, postcode CB4 1ER."
        },
        {
          "speaker": "Learner",
          "text": "That's all I needed. Thanks."
        },
        {
          "speaker": "Assistant",
          "text": "You're welcome."
        }
      ],
