    {
      "schemaVersion": 1,
      "id": "dlg.multiwoz.woz20408.json",
      "scenario": "Switching from unavailable Venetian food to an Indian restaurant in west Cambridge",
      "cefr": "B1",
      "turns": [
        {
          "speaker": "Learner",
          "text": "Hi. I'm looking for a restaurant that serves Venetian food in the west part of town. Could I have a phone number?"
        },
        {
          "speaker": "Assistant",
          "text": "I'm sorry, there are no restaurants serving Venetian food in the west. Would you like to try a different cuisine?"
        },
        {
          "speaker": "Learner",
          "text": "Yes. How about Indian food? Could I have the address and phone number of an Indian restaurant?"
        },
        {
          "speaker": "Assistant",
          "text": "Cocum is an Indian restaurant at 71 Castle Street, and the phone number is 01223 366668."
        },
        {
          "speaker": "Learner",
          "text": "Is it in the west part of town?"
        },
        {
          "speaker": "Assistant",
          "text": "Yes, it is in the west part of town."
        },
        {
          "speaker": "Learner",
          "text": "Great, thank you. That's all I needed."
        },
        {
          "speaker": "Assistant",
          "text": "You're welcome. Have a good evening."
        }
      ],
