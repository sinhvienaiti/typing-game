    {
      "schemaVersion": 1,
      "id": "dlg.multiwoz.woz20351.json",
      "scenario": "Finding a moderately priced Indian restaurant in east Cambridge and getting Rajmahal contact details",
      "cefr": "A2",
      "turns": [
        {
          "speaker": "Learner",
          "text": "I'm looking for a moderately priced restaurant in the east part of town."
        },
        {
          "speaker": "Assistant",
          "text": "There are three moderately priced restaurants in the east. Do you have a cuisine preference?"
        },
        {
          "speaker": "Learner",
          "text": "No, I don't mind."
        },
        {
          "speaker": "Assistant",
          "text": "I recommend Rajmahal, which serves Indian food. Would you like its contact details?"
        },
        {
          "speaker": "Learner",
          "text": "Yes, please. I'd like the address and phone number."
        },
        {
          "speaker": "Assistant",
          "text": "Rajmahal is at 7 Barnwell Road, Fen Ditton, and the phone number is 01223 244955. Is there anything else?"
        },
        {
          "speaker": "Learner",
          "text": "No, that's all. Thank you."
        },
        {
          "speaker": "Assistant",
          "text": "You're welcome."
        }
      ],
