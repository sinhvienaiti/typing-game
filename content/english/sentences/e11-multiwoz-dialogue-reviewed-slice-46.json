      "schemaVersion": 1,
      "id": "dlg.multiwoz.mul0400.json",
      "scenario": "Finding a Thursday train from Leicester to Cambridge and checking for an unusual-food restaurant",
      "cefr": "B1",
      "turns": [
        {
          "speaker": "Learner",
          "text": "I need a train from Leicester to Cambridge on Thursday, arriving by 12:30."
        },
        {
          "speaker": "Assistant",
          "text": "There are several trains that arrive by 12:30. Do you have a preferred departure time?"
        },
        {
          "speaker": "Learner",
          "text": "No. Could you give me the fare and train ID for one option?"
        },
        {
          "speaker": "Assistant",
          "text": "Train TR2058 leaves at 10:09 and arrives at 11:54. The fare is £37.80."
        },
        {
          "speaker": "Learner",
          "text": "Yes, please. I am also looking for a restaurant in east Cambridge that serves unusual food."
        },
        {
          "speaker": "Assistant",
          "text": "I'm sorry, but I couldn't find any restaurants in Cambridge serving unusual food. Would you like to try a different cuisine?"
        },
        {
          "speaker": "Learner",
          "text": "No, thank you. That's all I need."
        },
        {
          "speaker": "Assistant",
          "text": "You're welcome. Goodbye."
        }
      ],
