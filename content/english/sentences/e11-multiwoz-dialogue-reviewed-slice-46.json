      "id": "dlg.multiwoz.woz20012.json",
      "scenario": "Switching from an unavailable steakhouse to a moderately priced British restaurant and getting its phone number",
      "cefr": "A2",
      "turns": [
        {
          "speaker": "Learner",
          "text": "I'm looking for a moderately priced steakhouse."
        },
        {
          "speaker": "Assistant",
          "text": "I'm sorry, but there are no moderately priced steakhouses. Would you like to try a different cuisine?"
        },
        {
          "speaker": "Learner",
          "text": "How about moderately priced British food?"
        },
        {
          "speaker": "Assistant",
          "text": "There are several options. Restaurant One Seven is one of them."
        },
        {
          "speaker": "Learner",
          "text": "Could I have the phone number for Restaurant One Seven?"
        },
        {
          "speaker": "Assistant",
          "text": "The phone number is 01223 337766."
        },
        {
          "speaker": "Learner",
          "text": "Thank you. Goodbye."
        },
        {
          "speaker": "Assistant",
          "text": "You're welcome. Have a nice day."
        }
