      "id": "dlg.multiwoz.sng1303.json",
      "scenario": "Finding a Sunday train from Peterborough to Cambridge after 10:15",
      "cefr": "A2",
      "turns": [
        {
          "speaker": "Learner",
          "text": "I need a train from Peterborough to Cambridge on Sunday, leaving after 10:15."
        },
        {
          "speaker": "Assistant",
          "text": "Train TR8509 leaves Peterborough at 10:19."
        },
        {
          "speaker": "Learner",
          "text": "That works. How much is the fare?"
        },
        {
          "speaker": "Assistant",
          "text": "The fare is £13.20."
        },
        {
          "speaker": "Learner",
          "text": "Great. That's all I needed. Thank you."
        },
        {
          "speaker": "Assistant",
          "text": "You're welcome. Have a good trip."
        }
      ],
