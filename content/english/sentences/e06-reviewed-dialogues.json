    {
      "schemaVersion": 1,
      "id": "dlg.multiwoz.sng0312.json",
      "scenario": "Asking about a train fare and arrival time",
      "cefr": "A2",
      "turns": [
        {
          "speaker": "Learner",
          "text": "Hello, I'd like to find a train to Cambridge on Thursday, please."
        },
        {
          "speaker": "Assistant",
          "text": "Where will you be leaving from?"
        },
        {
          "speaker": "Learner",
          "text": "I'd like to leave from Stansted Airport after 11:45."
        },
        {
          "speaker": "Assistant",
          "text": "Train TR9775 leaves Stansted Airport for Cambridge at 12:24 on Thursday. Would that work?"
        },
        {
          "speaker": "Learner",
          "text": "How much does it cost, and when does it arrive?"
        },
        {
          "speaker": "Assistant",
          "text": "It arrives at 12:52 and costs 10.10 pounds. Would you like to book it?"
        },
        {
          "speaker": "Learner",
          "text": "Not at this time, thank you."
        },
        {
          "speaker": "Assistant",
          "text": "Okay. Is there anything else I can help you with today?"
        },
        {
          "speaker": "Learner",
          "text": "No, that's all I need. Thanks!"
        },
        {
          "speaker": "Assistant",
          "text": "You're welcome. Have a great day!"
        }
      ],
