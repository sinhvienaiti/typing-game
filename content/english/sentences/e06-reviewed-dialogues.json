    {
      "schemaVersion": 1,
      "id": "dlg.multiwoz.sng0309.json",
      "scenario": "Checking a train schedule",
      "cefr": "A2",
      "turns": [
        {
          "speaker": "Learner",
          "text": "I'm looking for a train."
        },
        {
          "speaker": "Assistant",
          "text": "I'd be happy to help. Where are you departing from, and where are you going?"
        },
        {
          "speaker": "Learner",
          "text": "I'd like to travel from Cambridge to London King's Cross."
        },
        {
          "speaker": "Assistant",
          "text": "There are many trains on that route. What day and time would you like to travel?"
        },
        {
          "speaker": "Learner",
          "text": "I'll be leaving on Friday after 12:45."
        },
        {
          "speaker": "Assistant",
          "text": "Train TR3685 leaves at 13:00, just 15 minutes later."
        },
        {
          "speaker": "Learner",
          "text": "That sounds great. I'll decide about the booking later. Have a nice day."
        },
        {
          "speaker": "Assistant",
          "text": "You're welcome. Have a great day. Goodbye."
        }
      ],
