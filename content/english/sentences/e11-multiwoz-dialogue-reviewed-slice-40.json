      "id": "dlg.multiwoz.sng1095.json",
      "scenario": "Getting the address, postcode, and entrance fee for Kambar",
      "cefr": "A2",
      "turns": [
        {
          "speaker": "Learner",
          "text": "Can you recommend a nightclub and give me its address, postcode, and entrance fee?"
        },
        {
          "speaker": "Assistant",
          "text": "Kambar is one option. It is at 1 Wheeler Street, postcode CB2 3QB."
        },
        {
          "speaker": "Learner",
          "text": "How much is the entrance fee?"
        },
        {
          "speaker": "Assistant",
          "text": "The entrance fee is £5."
        },
        {
          "speaker": "Learner",
          "text": "Great. That is all I needed. Thank you."
        },
        {
          "speaker": "Assistant",
          "text": "You’re welcome. Have a good evening."
        }
      ],
