    {
      "schemaVersion": 1,
      "id": "gr.a1.be-questions-short-answers",
      "cefr": "A1",
      "title": "Be: yes/no questions and short answers",
      "objective": "Ask and answer basic yes/no questions with be.",
      "concept": {
        "en": "Move am, is or are before the subject to make a yes/no question, and answer with the matching form of be.",
        "vi": "Đưa am, is hoặc are lên trước chủ ngữ để tạo câu hỏi yes/no và trả lời ngắn bằng đúng dạng của be."
      },
      "formulae": [
        "Am/Is/Are + subject + complement?",
        "Yes, subject pronoun + am/is/are.",
        "No, subject pronoun + am/is/are + not."
      ],
      "whenToUse": [
        "Check identity, description, state or location.",
        "Give a short yes/no answer without repeating the whole sentence."
      ],
      "forms": {
        "question": [
          "Are you ready for the lesson?",
          "Is Maya at home this evening?",
          "Are they students in this class?"
        ]
      },
      "variations": [
        "In negative short answers, isn't and aren't are common: No, he isn't. No, they aren't."
      ],
