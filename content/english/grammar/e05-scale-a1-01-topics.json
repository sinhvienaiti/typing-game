    {
      "schemaVersion": 1,
      "id": "gr.a1.be-negative",
      "cefr": "A1",
      "title": "Be: negatives",
      "objective": "Make negative statements with am not/isn't/aren't.",
      "concept": {
        "en": "Put not after am, is or are to make a negative statement with be.",
        "vi": "Đặt not sau am, is hoặc are để tạo câu phủ định với động từ be."
      },
      "formulae": [
        "I + am not + complement.",
        "He/She/It + is not (isn't) + complement.",
        "You/We/They + are not (aren't) + complement."
      ],
      "whenToUse": [
        "Say that an identity, description, state or location is not true."
      ],
      "forms": {
        "negative": [
          "I am not tired this morning.",
          "The small shop isn't open yet.",
          "They aren't late for class."
        ]
      },
      "variations": [
        "Amn't is not standard in most varieties of English; use am not."
      ],
