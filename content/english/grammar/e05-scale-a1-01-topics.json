    {
      "schemaVersion": 1,
      "id": "gr.a1.subject-pronouns",
      "cefr": "A1",
      "title": "Subject pronouns",
      "objective": "Choose I/you/he/she/it/we/they correctly as subjects.",
      "concept": {
        "en": "Use subject pronouns before the verb to show who or what performs the action or has the state.",
        "vi": "Dùng đại từ chủ ngữ trước động từ để chỉ người/vật thực hiện hành động hoặc mang trạng thái."
      },
      "formulae": [
        "I / you / he / she / it / we / they + verb or be form."
      ],
      "whenToUse": [
        "Avoid repeating a known person's or thing's name.",
        "Choose a pronoun that matches person and number."
      ],
      "forms": {
        "positive": [
          "She is my sister Anna.",
          "They live near this station.",
          "It is very small but useful."
        ]
      },
      "variations": [
        "Use it for one thing, animal or situation when gender is not relevant; use they for plural people or things."
      ],
