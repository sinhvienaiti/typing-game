    {
      "schemaVersion": 1,
      "id": "gr.a1.articles-a-an",
      "cefr": "A1",
      "title": "A/an for classification and first mention",
      "objective": "Use a/an with singular count nouns for non-specific reference.",
      "concept": {
        "en": "Use a or an before one non-specific singular count noun; choose an before a vowel sound and a before a consonant sound.",
        "vi": "Dùng a hoặc an trước một danh từ đếm được số ít chưa xác định; dùng an trước âm nguyên âm và a trước âm phụ âm."
      },
      "formulae": [
        "a + singular count noun beginning with a consonant sound",
        "an + singular count noun beginning with a vowel sound"
      ],
      "whenToUse": [
        "Classify a person or thing.",
        "Mention one non-specific singular count noun for the first time."
      ],
      "forms": {
        "positive": [
          "She is a doctor at this clinic.",
          "I have an umbrella in my bag.",
          "We have a small apartment near the station."
        ]
      },
      "variations": [
        "Choose a/an by sound, not simply by the first written letter."
      ],
