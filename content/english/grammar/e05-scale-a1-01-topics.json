    {
      "schemaVersion": 1,
      "id": "gr.a1.possessive-adjectives",
      "cefr": "A1",
      "title": "Possessive adjectives",
      "objective": "Use my/your/his/her/its/our/their before nouns.",
      "concept": {
        "en": "Use a possessive adjective before a noun to show who the noun belongs or relates to.",
        "vi": "Dùng tính từ sở hữu trước danh từ để chỉ danh từ đó thuộc về hoặc có liên hệ với ai."
      },
      "formulae": [
        "my/your/his/her/its/our/their + noun"
      ],
      "whenToUse": [
        "Show ownership or a close relationship before a noun."
      ],
      "forms": {
        "positive": [
          "My phone is new this week.",
          "His name is Daniel Park.",
          "Our classroom is upstairs on the left."
        ]
      },
      "variations": [
        "Possessive adjectives do not take an article before them: my bag, not the my bag."
      ],
