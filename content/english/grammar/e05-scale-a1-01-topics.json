    {
      "schemaVersion": 1,
      "id": "gr.a1.there-is-are",
      "cefr": "A1",
      "title": "There is / there are",
      "objective": "Introduce the existence and location of people and things.",
      "concept": {
        "en": "Use there is for one thing and there are for more than one thing when introducing what exists in a place or situation.",
        "vi": "Dùng there is với một vật và there are với nhiều vật để giới thiệu sự tồn tại của người/vật trong một nơi hoặc tình huống."
      },
      "formulae": [
        "There is + singular noun phrase.",
        "There are + plural noun phrase.",
        "Is there ...? / Are there ...?"
      ],
      "whenToUse": [
        "Say that something exists or is present.",
        "Introduce things in a place before giving more detail."
      ],
      "forms": {
        "positive": [
          "There is a bank near this station.",
          "There are two large windows in this classroom."
        ],
        "negative": [
          "There isn't a bus stop on this street."
        ],
        "question": [
          "Is there a pharmacy near this station?",
          "Are there any free seats in this room?"
        ]
      },
      "variations": [
        "Use there's as a common contraction of there is."
      ],
      "relatedCollocationIds": [],
      "exampleIds": [
        "sent.gra1.01.07.1",
        "sent.gra1.01.07.2",
