    {
      "schemaVersion": 1,
      "id": "gr.a1.demonstratives",
      "cefr": "A1",
      "title": "This/that/these/those",
      "objective": "Choose demonstratives for singular/plural and near/far reference.",
      "concept": {
        "en": "Use this/these for things that feel near and that/those for things that feel farther away; match singular and plural.",
        "vi": "Dùng this/these cho vật ở gần và that/those cho vật ở xa hơn; đồng thời chọn đúng dạng số ít hoặc số nhiều."
      },
      "formulae": [
        "this + singular noun",
        "that + singular noun",
        "these + plural noun",
        "those + plural noun"
      ],
      "whenToUse": [
        "Point to or identify people and things by distance and number."
      ],
      "forms": {
        "positive": [
          "This book is useful for beginners.",
          "That bus is full this morning.",
          "These apples are fresh today."
        ]
      },
      "variations": [
        "This and that are singular; these and those are plural."
      ],
