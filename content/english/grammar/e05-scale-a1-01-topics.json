    {
      "schemaVersion": 1,
      "id": "gr.a1.be-identification-description",
      "cefr": "A1",
      "title": "Be: identification and description",
      "objective": "Use am/is/are to identify people/things and give simple descriptions.",
      "concept": {
        "en": "Use am, is and are to identify people or things and to give simple descriptions.",
        "vi": "Dùng am, is và are để xác định người/vật hoặc đưa ra mô tả đơn giản."
      },
      "formulae": [
        "I + am + complement.",
        "He/She/It + is + complement.",
        "You/We/They + are + complement."
      ],
      "whenToUse": [
        "Say who or what someone/something is.",
        "Give a simple description, condition or location with be."
      ],
      "forms": {
        "positive": [
          "I am a student in this class.",
          "Leo is tall and friendly.",
          "We are ready for the lesson."
        ]
      },
      "variations": [
        "Use contracted forms I'm, he's, she's, it's, we're, you're and they're in common speech and informal writing."
      ],
      "relatedCollocationIds": [],
      "exampleIds": [
        "sent.gra1.01.01.1",
