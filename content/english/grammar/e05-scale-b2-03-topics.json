    {
      "schemaVersion": 1,
      "id": "gr.b2.neednt-vs-didnt-need",
      "cefr": "B2",
      "title": "Needn't have vs didn't need to",
      "objective": "Distinguish unnecessary action performed vs no necessity.",
      "concept": {
        "en": "Needn't have + past participle means an unnecessary action was actually done; didn't need to means there was no necessity and does not by itself say whether the action happened.",
        "vi": "Needn't have + quá khứ phân từ nghĩa là một hành động không cần thiết nhưng đã thực sự được làm; didn't need to chỉ nói không có sự cần thiết và không tự cho biết hành động có xảy ra hay không."
      },
      "formulae": [
        "needn't have + past participle = did it, unnecessary",
        "didn't need to + base verb = no necessity"
      ],
      "whenToUse": [
        "Distinguish unnecessary completed actions from lack of obligation."
      ],
      "forms": {
        "positive": [
          "You needn't have bought any milk; we had plenty.",
          "I didn't need to work yesterday, so I stayed home.",
          "She needn't have rushed; the train was late."
        ]
      },
      "variations": [],
      "relatedCollocationIds": [],
