      "id": "gr.b2.reporting-verbs-patterns",
      "cefr": "B2",
      "title": "Reporting verbs and complement patterns",
      "objective": "Use admit/deny/suggest/accuse/remind/warn with correct structures.",
      "concept": {
        "en": "Different reporting verbs select different complement patterns, such as admit doing, promise to do, warn someone not to do and suggest doing/that-clause.",
        "vi": "Các động từ tường thuật khác nhau chọn mẫu bổ ngữ khác nhau, như admit doing, promise to do, warn someone not to do và suggest doing/mệnh đề that."
      },
      "formulae": [
        "reporting verb + V-ing",
        "reporting verb + to-infinitive",
        "reporting verb + object + to-infinitive",
        "reporting verb + that-clause"
      ],
      "whenToUse": [
        "Choose the complement pattern required by the reporting verb."
      ],
      "forms": {
        "positive": [
          "He admitted taking the money.",
          "She promised to call.",
          "The guide warned us not to touch the plants."
