    {
      "schemaVersion": 1,
      "id": "gr.b2.passive-continuous-perfect",
      "cefr": "B2",
      "title": "Continuous and perfect passives",
      "objective": "Use is being done/has been done/had been done appropriately.",
      "concept": {
        "en": "Build continuous and perfect passives with be being + past participle and have/has/had been + past participle.",
        "vi": "Tạo bị động tiếp diễn và hoàn thành bằng be being + quá khứ phân từ và have/has/had been + quá khứ phân từ."
      },
      "formulae": [
        "continuous passive: be + being + past participle",
        "perfect passive: have/has/had + been + past participle"
      ],
      "whenToUse": [
        "Keep passive focus while expressing an action in progress or already completed relative to a reference point."
      ],
      "forms": {
        "positive": [
          "The eastbound railway bridge is being repaired after last week's storm.",
          "The documents have been sent.",
          "The room had been cleaned before we arrived."
        ]
      },
