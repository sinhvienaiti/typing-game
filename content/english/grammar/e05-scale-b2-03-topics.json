    {
      "schemaVersion": 1,
      "id": "gr.b2.causative-have-get",
      "cefr": "B2",
      "title": "Have/get something done",
      "objective": "Describe arranging for another person to perform a service/action.",
      "concept": {
        "en": "Use have/get + object + past participle when you arrange for another person to perform a service or when something happens to your property.",
        "vi": "Dùng have/get + tân ngữ + quá khứ phân từ khi bạn sắp xếp để người khác thực hiện dịch vụ hoặc khi một sự việc xảy ra với tài sản của mình."
      },
      "formulae": [
        "have/get + object + past participle"
      ],
      "whenToUse": [
        "Describe services arranged rather than performed personally, and sometimes unwanted experiences."
      ],
      "forms": {
        "positive": [
          "I had my hair cut yesterday.",
          "We're getting the kitchen painted.",
          "She had her bag stolen on the bus."
        ]
