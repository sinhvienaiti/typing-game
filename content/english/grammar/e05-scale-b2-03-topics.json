    {
      "schemaVersion": 1,
      "id": "gr.b2.get-passive",
      "cefr": "B2",
      "title": "Get-passive",
      "objective": "Use get + past participle in natural informal/eventive contexts.",
      "concept": {
        "en": "Use get + past participle in informal contexts for events that happen to someone or something, often emphasizing change, accident or involvement.",
        "vi": "Dùng get + quá khứ phân từ trong ngữ cảnh thân mật cho sự việc xảy đến với ai/vật, thường nhấn mạnh sự thay đổi, tai nạn hoặc sự tham gia."
      },
      "formulae": [
        "get + past participle"
      ],
      "whenToUse": [
        "Use a less formal alternative to be-passive for dynamic events."
      ],
      "forms": {
        "positive": [
          "My phone got stolen on the train.",
          "They got married last summer.",
          "Be careful not to get hurt."
        ]
      },
