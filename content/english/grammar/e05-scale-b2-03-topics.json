      "id": "gr.b2.relative-prepositions",
      "cefr": "B2",
      "title": "Relative clauses with prepositions",
      "objective": "Use formal preposition + whom/which and natural stranded-preposition alternatives.",
      "concept": {
        "en": "In formal relative clauses, a preposition can come before whom or which; in less formal clauses it often stays at the end.",
        "vi": "Trong mệnh đề quan hệ trang trọng, giới từ có thể đứng trước whom hoặc which; trong cách nói ít trang trọng hơn nó thường đứng cuối mệnh đề."
      },
      "formulae": [
        "preposition + whom/which",
        "who/that/which + clause + preposition"
      ],
      "whenToUse": [
        "Choose formal or neutral relative-clause preposition placement."
      ],
      "forms": {
