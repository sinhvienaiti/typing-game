    {
      "schemaVersion": 1,
      "id": "gr.b1.present-perfect-continuous-duration",
      "cefr": "B1",
      "title": "Present Perfect Continuous: duration",
      "objective": "Emphasize ongoing/recent activity over a period leading to now.",
      "concept": {
        "en": "Use the Present Perfect Continuous to emphasize the duration of an activity that began in the past and continues or has just stopped.",
        "vi": "Dùng Hiện tại hoàn thành tiếp diễn để nhấn mạnh thời lượng của một hoạt động bắt đầu trong quá khứ và vẫn tiếp tục hoặc vừa mới dừng."
      },
      "formulae": [
        "Subject + have/has been + verb-ing + for/since ..."
      ],
      "whenToUse": [
        "Focus on how long an activity has been in progress."
      ],
      "forms": {
        "positive": [
          "I've been studying for two hours.",
          "It has been raining since morning.",
          "They've been waiting for the bus for thirty minutes."
        ]
