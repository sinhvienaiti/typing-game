    {
      "schemaVersion": 1,
      "id": "gr.b1.present-perfect-unfinished-time",
      "cefr": "B1",
      "title": "Present Perfect: unfinished time periods",
      "objective": "Talk about events within time periods that continue to now.",
      "concept": {
        "en": "Use the Present Perfect for actions in a time period that has not finished yet.",
        "vi": "Dùng Hiện tại hoàn thành cho hành động xảy ra trong một khoảng thời gian vẫn chưa kết thúc."
      },
      "formulae": [
        "Subject + have/has + past participle + unfinished-time expression."
      ],
      "whenToUse": [
        "Use expressions such as today, this week or this year when that period is still continuing."
      ],
      "forms": {
        "positive": [
          "I've answered five emails today.",
          "Mina has read three chapters this week.",
          "We've had two meetings this month."
        ]
      },
