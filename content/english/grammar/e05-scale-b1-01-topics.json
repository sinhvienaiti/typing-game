    {
      "schemaVersion": 1,
      "id": "gr.b1.been-vs-gone",
      "cefr": "B1",
      "title": "Been vs gone",
      "objective": "Distinguish returned experience/location from still-being-away meaning.",
      "concept": {
        "en": "Use has/have been to mean someone went somewhere and returned; use has/have gone when the person is still away.",
        "vi": "Dùng has/have been khi ai đó đã đi đâu và đã quay về; dùng has/have gone khi người đó vẫn đang ở nơi khác."
      },
      "formulae": [
        "have/has been to + place = visited and returned",
        "have/has gone to + place = went and is still there"
      ],
      "whenToUse": [
        "Distinguish completed visits from a person's current absence."
      ],
      "forms": {
        "positive": [
          "Lena has been to Japan twice.",
          "Tom has gone to the bank; he'll be back soon.",
          "Have you ever been to Singapore?"
        ]
      },
