    {
      "schemaVersion": 1,
      "id": "gr.b1.have-had-duration",
      "cefr": "B1",
      "title": "Have had and other state verbs over time",
      "objective": "Use present perfect with possession and long-running states.",
      "concept": {
        "en": "Use have/has had with for or since when possession or a state began in the past and continues now.",
        "vi": "Dùng have/has had với for hoặc since khi việc sở hữu hay trạng thái bắt đầu trong quá khứ và vẫn tiếp tục đến hiện tại."
      },
      "formulae": [
        "Subject + have/has had + noun + for/since ..."
      ],
      "whenToUse": [
        "Describe how long a current possession, relationship or state has lasted."
      ],
      "forms": {
        "positive": [
          "I've had this laptop for three years.",
          "Sara has had that job since June.",
          "We've had the same teacher since September."
        ]
      },
