    {
      "schemaVersion": 1,
      "id": "gr.b1.past-perfect-vs-past-simple",
      "cefr": "B1",
      "title": "Past Perfect vs Past Simple",
      "objective": "Use past perfect only when earlier-past ordering needs marking.",
      "concept": {
        "en": "Use the Past Perfect for the earlier event and the Past Simple for the later event in a past sequence when the order needs clarification.",
        "vi": "Dùng Quá khứ hoàn thành cho sự kiện xảy ra trước và Quá khứ đơn cho sự kiện xảy ra sau khi cần làm rõ thứ tự trong quá khứ."
      },
      "formulae": [
        "earlier: had + past participle",
        "later: Past Simple"
      ],
      "whenToUse": [
        "Clarify the order of two completed past events."
      ],
      "forms": {
        "positive": [
          "After we had eaten, we went for a walk.",
          "When I got home, everyone had gone to bed.",
          "She had finished the report before the manager called."
        ]
      },
