    {
      "schemaVersion": 1,
      "id": "gr.b1.present-perfect-repeated-events",
      "cefr": "B1",
      "title": "Present Perfect: repeated events up to now",
      "objective": "Describe repeated actions whose time frame includes the present.",
      "concept": {
        "en": "Use the Present Perfect for repeated events up to now when the time period remains open.",
        "vi": "Dùng Hiện tại hoàn thành cho các sự kiện lặp lại tính đến hiện tại khi khoảng thời gian vẫn còn mở."
      },
      "formulae": [
        "Subject + have/has + past participle + number/frequency expression."
      ],
      "whenToUse": [
        "Count repeated experiences or events from the past up to the present."
      ],
      "forms": {
        "positive": [
          "We've visited that cafe four times.",
          "She has called me twice today.",
          "I've seen that film three times."
        ]
      },
