    {
      "schemaVersion": 1,
      "id": "gr.b1.past-perfect-earlier-past",
      "cefr": "B1",
      "title": "Past Perfect: earlier past",
      "objective": "Mark an event as earlier than another past reference point.",
      "concept": {
        "en": "Use the Past Perfect for an event completed before another past event or past reference point.",
        "vi": "Dùng Quá khứ hoàn thành cho một sự kiện đã hoàn tất trước một sự kiện hay mốc khác trong quá khứ."
      },
      "formulae": [
        "Subject + had + past participle."
      ],
      "whenToUse": [
        "Make the earlier of two past events clear."
      ],
      "forms": {
        "positive": [
          "The train had left before we reached the station.",
          "By the time I arrived, the meeting had started.",
          "She was tired because she hadn't slept well."
        ]
      },
