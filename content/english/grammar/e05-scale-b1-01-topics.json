    {
      "schemaVersion": 1,
      "id": "gr.b1.present-perfect-result-vs-event",
      "cefr": "B1",
      "title": "Present Perfect: result focus vs event focus",
      "objective": "Choose wording based on whether the current result or occurrence matters.",
      "concept": {
        "en": "Use the Present Perfect to focus on a present result and the Past Simple to tell a finished past event.",
        "vi": "Dùng Hiện tại hoàn thành để nhấn mạnh kết quả hiện tại và Quá khứ đơn để kể một sự kiện đã kết thúc trong quá khứ."
      },
      "formulae": [
        "present result: have/has + past participle",
        "finished event: Past Simple"
      ],
      "whenToUse": [
        "Choose the tense according to whether the focus is the current result or the past event itself."
      ],
      "forms": {
        "positive": [
          "I've lost my wallet, so I can't pay.",
          "I lost my wallet on the bus yesterday.",
          "She's broken her arm, so she can't drive."
        ]
      },
