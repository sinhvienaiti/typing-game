    {
      "schemaVersion": 1,
      "id": "gr.c1.complex-subject-agreement",
      "cefr": "C1",
      "title": "Agreement with complex subjects",
      "objective": "Handle intervening phrases, either/or, neither/nor and quantified noun phrases.",
      "concept": {
        "en": "Agreement with complex subjects depends on the grammatical head and on special coordination patterns, not simply the nearest noun.",
        "vi": "Hòa hợp với chủ ngữ phức phụ thuộc vào head ngữ pháp và các mẫu phối hợp đặc biệt, không chỉ danh từ gần động từ nhất."
      },
      "formulae": [
        "head noun + intervening phrase + agreeing verb",
        "either X or Y / neither X nor Y + proximity-sensitive agreement"
      ],
      "whenToUse": [
        "Identify the subject head before choosing verb number, then handle correlative coordination according to accepted register norms."
      ],
      "forms": {
        "positive": [
          "The quality of the supporting documents has improved substantially.",
          "Neither the regional offices nor the central unit has confirmed the figure.",
          "A series of unexpected delays has pushed the launch into the next quarter."
        ]
      },
