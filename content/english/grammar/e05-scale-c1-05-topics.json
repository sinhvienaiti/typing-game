    {
      "schemaVersion": 1,
      "id": "gr.c1.adjective-complementation",
      "cefr": "C1",
      "title": "Advanced adjective complementation",
      "objective": "Choose adjective + that-clause/to-infinitive/preposition patterns and understood subjects.",
      "concept": {
        "en": "Adjectives select different complement types and may assign the understood subject of an infinitive in different ways.",
        "vi": "Tính từ chọn các loại bổ ngữ khác nhau và có thể gán chủ ngữ ngầm của infinitive theo những cách khác nhau."
      },
      "formulae": [
        "adjective + that-clause",
        "adjective + to-infinitive",
        "adjective + preposition + -ing/noun"
      ],
      "whenToUse": [
        "Learn adjective-complement pairings and check who is understood to perform an infinitive action."
      ],
      "forms": {
        "positive": [
          "The board is reluctant to disclose the preliminary estimate before verification.",
          "We are confident that the revised procedure will withstand external scrutiny.",
          "She is concerned about relying on a single supplier for a critical component."
        ]
      },
