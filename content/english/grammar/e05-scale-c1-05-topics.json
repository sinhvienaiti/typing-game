    {
      "schemaVersion": 1,
      "id": "gr.c1.causative-ergative-alternation",
      "cefr": "C1",
      "title": "Causative and ergative alternation",
      "objective": "Distinguish verbs used transitively for causing change vs intransitively for change.",
      "concept": {
        "en": "Some change-of-state verbs alternate between a transitive causative use and an intransitive ergative use.",
        "vi": "Một số động từ chỉ thay đổi trạng thái luân phiên giữa cách dùng ngoại động gây biến đổi và nội động biểu thị tự thay đổi."
      },
      "formulae": [
        "agent/cause + change verb + object",
        "subject + same change verb"
      ],
      "whenToUse": [
        "Use the alternation when English allows the changed entity to appear either as object of a cause or as subject of the change."
      ],
      "forms": {
        "positive": [
          "The sudden temperature drop cracked the outer seal.",
          "The outer seal cracked during the overnight freeze.",
          "Higher interest rates have narrowed the gap, but the gap may widen again next year."
        ]
      },
