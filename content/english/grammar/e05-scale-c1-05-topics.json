    {
      "schemaVersion": 1,
      "id": "gr.c1.cohesion-reference-chains",
      "cefr": "C1",
      "title": "Cohesion and reference chains",
      "objective": "Maintain clear pronoun, demonstrative and lexical reference across paragraphs.",
      "concept": {
        "en": "Cohesive reference chains keep entities identifiable across sentences by controlling pronouns, demonstratives, repetition, and lexical reformulation.",
        "vi": "Chuỗi quy chiếu tạo liên kết giúp người đọc theo dõi thực thể qua nhiều câu bằng đại từ, từ chỉ định, lặp có kiểm soát và thay thế từ vựng."
      },
      "formulae": [
        "clear noun phrase → pronoun/demonstrative → lexical restatement"
      ],
      "whenToUse": [
        "Maintain an unambiguous antecedent whenever several possible referents are active in a paragraph."
      ],
      "forms": {
        "positive": [
          "The commission published two reports. The second document focuses on enforcement, and it recommends a new appeals process.",
          "A sensor and a controller failed simultaneously. This combination made the original diagnosis difficult.",
          "The proposal was revised twice. Those changes resolved the pricing issue but not the governance dispute."
        ]
