    {
      "schemaVersion": 1,
      "id": "gr.c1.formal-discourse-markers",
      "cefr": "C1",
      "title": "Formal discourse markers",
      "objective": "Organize arguments with moreover, nonetheless, conversely, hence and related markers.",
      "concept": {
        "en": "Formal discourse markers signal addition, concession, contrast, consequence, and inference between stretches of argument.",
        "vi": "Dấu nối diễn ngôn trang trọng biểu thị bổ sung, nhượng bộ, đối lập, hệ quả và suy luận giữa các phần lập luận."
      },
      "formulae": [
        "sentence connector, + clause",
        "clause; connector, clause"
      ],
      "whenToUse": [
        "Choose a connector whose logical relation matches the argument and whose register fits formal prose."
      ],
      "forms": {
        "positive": [
          "The intervention reduced waiting times; moreover, it improved continuity of care.",
          "The initial forecast was optimistic. Nonetheless, the reserve proved sufficient.",
          "The sample was not representative; hence, the estimate should not be generalized nationally."
        ]
      },
