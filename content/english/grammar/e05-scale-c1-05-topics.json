    {
      "schemaVersion": 1,
      "id": "gr.c1.notional-agreement",
      "cefr": "C1",
      "title": "Notional and proximity agreement",
      "objective": "Choose singular/plural agreement with collective and coordinated meanings by dialect/register.",
      "concept": {
        "en": "Notional agreement lets meaning, collectivity, or proximity influence number where grammar permits more than one convention.",
        "vi": "Notional agreement cho phép ý nghĩa, tính tập thể hoặc khoảng cách ảnh hưởng đến số của động từ khi ngữ pháp cho phép nhiều quy ước."
      },
      "formulae": [
        "collective noun + singular/plural verb by meaning and dialect",
        "notional plural with coordinated concepts"
      ],
      "whenToUse": [
        "Choose agreement consistently with dialect, register, and whether a group is conceptualized as one unit or as members."
      ],
      "forms": {
        "positive": [
          "The committee has reached its decision after three hours of debate.",
          "The committee are divided over how the new rule should be interpreted.",
          "Ten kilometres is too far to walk with this equipment."
        ]
      },
