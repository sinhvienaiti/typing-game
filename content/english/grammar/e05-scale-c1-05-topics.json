    {
      "schemaVersion": 1,
      "id": "gr.c1.resultative-constructions",
      "cefr": "C1",
      "title": "Resultative constructions",
      "objective": "Use patterns such as wipe it clean/paint it red where English licenses result states.",
      "concept": {
        "en": "Resultative constructions pair an action with a complement that names the state produced by that action.",
        "vi": "Resultative construction ghép một hành động với bổ ngữ chỉ trạng thái kết quả do hành động tạo ra."
      },
      "formulae": [
        "verb + object + result adjective/phrase"
      ],
      "whenToUse": [
        "Use resultatives only with combinations that English conventionally licenses; not every verb and adjective can combine productively."
      ],
      "forms": {
        "positive": [
          "The technicians wiped the sensor housing clean before reassembly.",
          "The heat warped the plastic panel out of shape.",
          "They hammered the damaged bracket flat enough to fit the replacement frame."
        ]
      },
