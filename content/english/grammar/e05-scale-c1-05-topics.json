      "id": "gr.c1.verb-complementation-advanced",
      "cefr": "C1",
      "title": "Advanced verb complementation",
      "objective": "Control complex patterns after perception, causative, reporting and attitude verbs.",
      "concept": {
        "en": "Advanced verb complementation distinguishes bare infinitives, to-infinitives, -ing clauses, and object-plus-complement patterns after particular verbs.",
        "vi": "Verb complementation nâng cao phân biệt bare infinitive, to-infinitive, -ing và mẫu object + complement sau từng động từ."
      },
      "formulae": [
        "verb + object + bare infinitive",
        "verb + object + to-infinitive",
        "verb + -ing"
      ],
      "whenToUse": [
        "Treat complement selection as part of the lexical grammar of the controlling verb."
      ],
      "forms": {
        "positive": [
          "The new evidence led the investigators to reconsider their original timeline.",
          "We observed the pressure fall steadily as the valve opened.",
          "The consultant advised the board to postpone the tender until the specifications were clearer."
