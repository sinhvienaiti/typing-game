    {
      "schemaVersion": 1,
      "id": "gr.a2.adverbs-manner",
      "cefr": "A2",
      "title": "Adverbs of manner",
      "objective": "Describe how actions happen and form common -ly adverbs.",
      "concept": {
        "en": "Use an adverb of manner to describe how an action happens; many are formed by adding -ly to an adjective.",
        "vi": "Dùng trạng từ chỉ cách thức để mô tả một hành động diễn ra như thế nào; nhiều trạng từ được tạo bằng cách thêm -ly vào tính từ."
      },
      "formulae": [
        "verb + adverb of manner",
        "adjective + -ly → adverb (common pattern)"
      ],
      "whenToUse": [
        "Describe the manner of speaking, moving, working or doing another action."
      ],
      "forms": {
        "positive": [
          "She speaks English clearly.",
          "The baby slept quietly.",
          "Please drive carefully."
        ]
      },
      "variations": [
        "Some adverbs are irregular or unchanged, such as well and fast."
      ],
