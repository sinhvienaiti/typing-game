    {
      "schemaVersion": 1,
      "id": "gr.a2.articles-generic-specific",
      "cefr": "A2",
      "title": "Articles: generic vs specific reference",
      "objective": "Choose a/an, the or plural reference in common generic/specific contexts.",
      "concept": {
        "en": "Use a/an when introducing one non-specific singular countable noun and the when both speaker and listener can identify the specific noun.",
        "vi": "Dùng a/an khi giới thiệu một danh từ đếm được số ít chưa xác định và the khi cả người nói lẫn người nghe có thể xác định danh từ cụ thể."
      },
      "formulae": [
        "first/non-specific mention: a/an + singular countable noun",
        "identified/specific mention: the + noun"
      ],
      "whenToUse": [
        "Move from introducing something to referring back to the same specific thing."
      ],
      "forms": {
        "positive": [
          "I saw a dog. The dog was very friendly.",
          "She bought a book. The book is on the table.",
          "We need a taxi. The taxi outside is free."
        ]
      },
      "variations": [
        "Specificity depends on shared context, not only on whether a noun was mentioned earlier."
      ],
