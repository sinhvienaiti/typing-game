    {
      "schemaVersion": 1,
      "id": "gr.a2.question-tags-basic",
      "cefr": "A2",
      "title": "Basic question tags",
      "objective": "Use common positive/negative tag patterns to check information.",
      "concept": {
        "en": "Use a short question tag with the opposite polarity of the statement to check or confirm information.",
        "vi": "Dùng câu hỏi đuôi ngắn có tính khẳng định/phủ định ngược với mệnh đề chính để kiểm tra hoặc xác nhận thông tin."
      },
      "formulae": [
        "positive statement, negative tag?",
        "negative statement, positive tag?"
      ],
      "whenToUse": [
        "Seek confirmation in simple statements with be, auxiliaries and common modal verbs."
      ],
      "forms": {
        "positive": [
          "It's cold today, isn't it?",
          "You like coffee, don't you?",
          "She can swim, can't she?"
        ]
      },
      "variations": [
        "The tag repeats the auxiliary or modal from the statement when one is present."
      ],
