    {
      "schemaVersion": 1,
      "id": "gr.a2.zero-article-generic",
      "cefr": "A2",
      "title": "Zero article with plural and uncountable nouns",
      "objective": "Make generic statements without an article where appropriate.",
      "concept": {
        "en": "Use no article with plural countable nouns and uncountable nouns when talking about things in general.",
        "vi": "Không dùng mạo từ với danh từ đếm được số nhiều và danh từ không đếm được khi nói chung về một loại hoặc khái niệm."
      },
      "formulae": [
        "plural countable noun (general): no article",
        "uncountable noun (general): no article"
      ],
      "whenToUse": [
        "Make general statements about categories, substances and abstract ideas."
      ],
      "forms": {
        "positive": [
          "Dogs need regular exercise.",
          "Milk is good for children.",
          "Life can be surprising."
        ]
      },
      "variations": [
        "Use the when the plural or uncountable noun is made specific by context."
      ],
