    {
      "schemaVersion": 1,
      "id": "gr.a2.basic-subordination",
      "cefr": "A2",
      "title": "Because, so, although and while",
      "objective": "Connect clauses for reason, result, contrast and simultaneous situations.",
      "concept": {
        "en": "Use basic subordinators such as because, although, before, after and when to connect a main clause with a dependent clause.",
        "vi": "Dùng các liên từ phụ thuộc cơ bản như because, although, before, after và when để nối mệnh đề chính với mệnh đề phụ."
      },
      "formulae": [
        "main clause + subordinator + dependent clause",
        "Subordinator + dependent clause, main clause"
      ],
      "whenToUse": [
        "Express reason, contrast, time and sequence with two related clauses."
      ],
      "forms": {
        "positive": [
          "I stayed home because I was sick.",
          "Although it was cold, we went for a walk.",
          "I called Sam before I left."
        ]
      },
      "variations": [
        "A comma is common when the dependent clause comes first."
      ],
