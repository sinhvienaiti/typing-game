    {
      "schemaVersion": 1,
      "id": "gr.a2.adjective-vs-adverb",
      "cefr": "A2",
      "title": "Adjective vs adverb",
      "objective": "Choose the correct form to modify nouns, verbs and adjectives.",
      "concept": {
        "en": "Use adjectives to describe nouns or follow linking verbs, and adverbs to modify ordinary action verbs.",
        "vi": "Dùng tính từ để mô tả danh từ hoặc sau động từ nối; dùng trạng từ để bổ nghĩa cho động từ hành động thông thường."
      },
      "formulae": [
        "adjective + noun / be + adjective",
        "action verb + adverb"
      ],
      "whenToUse": [
        "Choose between a quality of a person/thing and the manner of an action."
      ],
      "forms": {
        "positive": [
          "Mia is a careful driver.",
          "Mia drives carefully.",
          "The test was easy, and I finished it quickly."
        ]
      },
      "variations": [
        "Linking verbs such as be, seem and feel normally take adjectives rather than manner adverbs."
      ],
