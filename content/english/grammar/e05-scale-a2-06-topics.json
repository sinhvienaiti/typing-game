    {
      "schemaVersion": 1,
      "id": "gr.a2.reflexive-pronouns",
      "cefr": "A2",
      "title": "Reflexive pronouns",
      "objective": "Use myself/yourself/etc. when subject and object refer to the same participant.",
      "concept": {
        "en": "Use reflexive pronouns when the subject and object refer to the same person or group, or for emphasis.",
        "vi": "Dùng đại từ phản thân khi chủ ngữ và tân ngữ cùng chỉ một người/nhóm, hoặc để nhấn mạnh."
      },
      "formulae": [
        "I → myself, you → yourself/yourselves, he → himself, she → herself, we → ourselves, they → themselves"
      ],
      "whenToUse": [
        "Show that an action returns to the subject or emphasize who did it without help."
      ],
      "forms": {
        "positive": [
          "I cut myself while cooking.",
          "They made the cake themselves.",
          "She taught herself to play the guitar."
        ]
      },
      "variations": [
        "Reflexive pronouns are not used simply because the subject is a person; they need a reflexive or emphatic function."
      ],
