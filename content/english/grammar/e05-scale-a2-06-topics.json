    {
      "schemaVersion": 1,
      "id": "gr.a2.one-ones",
      "cefr": "A2",
      "title": "One/ones as substitutes",
      "objective": "Avoid repetition by substituting one/ones for count nouns.",
      "concept": {
        "en": "Use one or ones to avoid repeating a countable noun that is already clear from context.",
        "vi": "Dùng one hoặc ones để tránh lặp lại danh từ đếm được đã rõ từ ngữ cảnh."
      },
      "formulae": [
        "singular replacement: one",
        "plural replacement: ones"
      ],
      "whenToUse": [
        "Compare or choose among previously mentioned countable things without repeating the noun."
      ],
      "forms": {
        "positive": [
          "I like the red bag, not the blue one.",
          "These shoes are small; I need bigger ones.",
          "Which cake do you want? The chocolate one."
        ]
      },
      "variations": [
        "One/ones replace countable nouns, not uncountable nouns."
      ],
