    {
      "schemaVersion": 1,
      "id": "gr.b1.embedded-questions",
      "cefr": "B1",
      "title": "Embedded wh-clauses",
      "objective": "Use wh-clauses after verbs such as know, wonder and explain.",
      "concept": {
        "en": "Use an embedded question as a noun-like clause after verbs or expressions such as know, wonder, remember or I'm not sure, with statement word order.",
        "vi": "Dùng câu hỏi lồng như một mệnh đề danh từ sau các động từ/cụm như know, wonder, remember hoặc I'm not sure, với trật tự câu khẳng định."
      },
      "formulae": [
        "verb/expression + wh-word/if + subject + verb"
      ],
      "whenToUse": [
        "Put a question meaning inside a larger statement rather than asking directly."
      ],
      "forms": {
        "positive": [
          "I don't know where he lives.",
          "I wonder whether they have arrived.",
          "I'm not sure what this button does."
        ]
      },
      "variations": [],
