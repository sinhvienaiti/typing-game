    {
      "schemaVersion": 1,
      "id": "gr.b1.articles-geography",
      "cefr": "B1",
      "title": "Articles with geographical names",
      "objective": "Use the/zero article with countries, rivers, seas, mountains and regions.",
      "concept": {
        "en": "Use the with certain geographical names such as rivers, seas, oceans, deserts and plural country/group names, but usually no article with cities, most countries, lakes and individual mountains.",
        "vi": "Dùng the với một số tên địa lý như sông, biển, đại dương, sa mạc và tên quốc gia/nhóm ở dạng số nhiều; thường không dùng mạo từ với thành phố, đa số quốc gia, hồ và núi riêng lẻ."
      },
      "formulae": [
        "the + rivers/seas/oceans/deserts/ranges",
        "zero article + most cities/countries/lakes/mountains"
      ],
      "whenToUse": [
        "Apply common article patterns to geographical names."
      ],
      "forms": {
        "positive": [
          "The Nile flows through several countries.",
          "Japan is in Asia.",
