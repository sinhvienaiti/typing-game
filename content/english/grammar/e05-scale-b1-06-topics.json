    {
      "schemaVersion": 1,
      "id": "gr.b1.articles-institutions",
      "cefr": "B1",
      "title": "Articles with institutions and activities",
      "objective": "Distinguish school/work/home/bed as activities vs specific places.",
      "concept": {
        "en": "With institutions such as school, university, prison, hospital and bed, article choice can distinguish their normal purpose from the physical place or a specific building.",
        "vi": "Với các từ chỉ cơ sở như school, university, prison, hospital và bed, lựa chọn mạo từ có thể phân biệt chức năng thông thường với địa điểm/vật cụ thể."
      },
      "formulae": [
        "go to school/bed/prison for normal function",
        "go to the school/bed/building when referring to a specific place/object"
      ],
      "whenToUse": [
        "Choose zero article or the according to institutional function versus specific reference."
      ],
      "forms": {
        "positive": [
          "The children are at school.",
          "I went to the school to meet the teacher.",
          "It's late, so I'm going to bed."
        ]
      },
