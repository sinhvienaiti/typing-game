    {
      "schemaVersion": 1,
      "id": "gr.b1.so-such",
      "cefr": "B1",
      "title": "So and such",
      "objective": "Intensify adjective/adverb vs noun phrases correctly.",
      "concept": {
        "en": "Use so before an adjective/adverb and such before a noun phrase to emphasize degree or introduce a result.",
        "vi": "Dùng so trước tính từ/trạng từ và such trước cụm danh từ để nhấn mạnh mức độ hoặc dẫn tới một kết quả."
      },
      "formulae": [
        "so + adjective/adverb (+ that clause)",
        "such + (a/an) + adjective + noun (+ that clause)"
      ],
      "whenToUse": [
        "Choose the correct intensifier according to whether a noun phrase follows."
      ],
      "forms": {
        "positive": [
          "The film was so good that I watched it twice.",
          "It was such a good film that I watched it twice.",
          "She spoke so quietly that I couldn't hear."
        ]
      },
