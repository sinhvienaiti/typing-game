      "id": "gr.b1.both-either-neither",
      "cefr": "B1",
      "title": "Both/either/neither",
      "objective": "Refer to two people or things with correct agreement and meaning.",
      "concept": {
        "en": "Use both for two together, either for one of two, and neither for not one and not the other.",
        "vi": "Dùng both cho cả hai, either cho một trong hai và neither cho không cái nào trong hai."
      },
      "formulae": [
        "both (A and B)",
        "either (A or B)",
        "neither (A nor B)"
      ],
      "whenToUse": [
        "Refer precisely to a set of two people or things."
      ],
      "forms": {
        "positive": [
          "Both answers are correct.",
          "You can take either bus.",
