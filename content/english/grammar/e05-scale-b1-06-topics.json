    {
      "schemaVersion": 1,
      "id": "gr.b1.comparison-relations",
      "cefr": "B1",
      "title": "Same as, different from and similar to",
      "objective": "Express comparison relationships with correct prepositions.",
      "concept": {
        "en": "Use the same as, different from and similar to to express equality, difference and similarity between things.",
        "vi": "Dùng the same as, different from và similar to để diễn tả sự giống nhau, khác nhau và tương tự giữa các đối tượng."
      },
      "formulae": [
        "the same as",
        "different from",
        "similar to"
      ],
      "whenToUse": [
        "Compare relationships without using ordinary comparative adjectives."
      ],
      "forms": {
        "positive": [
          "My answer is the same as yours.",
          "This design is different from the old one.",
          "Her bag is similar to mine."
        ]
      },
