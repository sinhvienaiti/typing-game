    {
      "schemaVersion": 1,
      "id": "gr.b1.comparative-modifiers",
      "cefr": "B1",
      "title": "Comparative modifiers",
      "objective": "Use much/far/a lot/a bit/slightly with comparatives.",
      "concept": {
        "en": "Use words such as much, far, a lot, a bit and slightly before comparative forms to show the size of the difference.",
        "vi": "Dùng các từ như much, far, a lot, a bit và slightly trước dạng so sánh hơn để thể hiện mức độ chênh lệch."
      },
      "formulae": [
        "much/far/a lot + comparative",
        "a bit/slightly + comparative"
      ],
      "whenToUse": [
        "Make comparisons more precise by indicating a large or small difference."
      ],
      "forms": {
        "positive": [
          "This route is much faster.",
          "The blue room is slightly bigger than the green one.",
          "Her new job is a lot more interesting."
        ]
      },
