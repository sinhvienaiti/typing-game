    {
      "schemaVersion": 1,
      "id": "gr.b1.too-enough-nuance",
      "cefr": "B1",
      "title": "Too/enough: consequence and implication",
      "objective": "Use too/enough to imply whether an action/result is possible.",
      "concept": {
        "en": "Use too to show an excessive degree that causes a problem and enough to show sufficient degree or quantity; their position differs with adjectives and nouns.",
        "vi": "Dùng too để chỉ mức độ quá mức gây vấn đề và enough để chỉ mức độ/số lượng đủ; vị trí của enough khác nhau với tính từ và danh từ."
      },
      "formulae": [
        "too + adjective + to-infinitive",
        "adjective + enough + to-infinitive",
        "enough + noun"
      ],
      "whenToUse": [
        "Explain whether a degree or amount prevents or allows an action."
      ],
      "forms": {
        "positive": [
          "The box is too heavy for me to lift.",
          "She's experienced enough to lead the team.",
          "We have enough chairs for everyone."
        ]
      },
