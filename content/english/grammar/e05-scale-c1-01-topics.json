    {
      "schemaVersion": 1,
      "id": "gr.c1.conditional-inversion",
      "cefr": "C1",
      "title": "Conditional inversion with had/were/should",
      "objective": "Form formal conditionals without if.",
      "concept": {
        "en": "Formal conditionals can omit if by inverting had, were, or should before the subject.",
        "vi": "Trong câu điều kiện trang trọng, có thể bỏ if và đảo had, were hoặc should lên trước chủ ngữ."
      },
      "formulae": [
        "Had + subject + past participle, ...",
        "Were + subject + complement/to-infinitive, ...",
        "Should + subject + base verb, ..."
      ],
      "whenToUse": [
        "Use inversion in formal hypotheses, contingency clauses, and polished written argument."
      ],
      "forms": {
        "positive": [
          "Had the auditors raised the issue earlier, the board could have responded before publication.",
          "Were the subsidy to end next year, several regional services would become unviable.",
          "Should you require further documentation, please contact the compliance office."
        ]
      },
