    {
      "schemaVersion": 1,
      "id": "gr.c1.wh-clefts",
      "cefr": "C1",
      "title": "Wh-clefts and reversed clefts",
      "objective": "Use What...is... and related patterns to organize information and emphasis.",
      "concept": {
        "en": "Wh-clefts package a proposition into a wh-clause and place the focused information in a complement.",
        "vi": "Wh-cleft đóng gói thông tin nền trong mệnh đề wh- và đặt thông tin trọng tâm ở bổ ngữ."
      },
      "formulae": [
        "What + clause + be + focus",
        "Focus + be + what + clause"
      ],
      "whenToUse": [
        "Use wh-clefts to organize dense information and make the new or evaluative element prominent."
      ],
      "forms": {
        "positive": [
          "What the committee needs is a timetable that distinguishes urgent work from desirable work.",
          "A clearer account of the evidence is what the reviewers asked for.",
          "What surprised the analysts most was how quickly confidence returned."
        ]
      },
