    {
      "schemaVersion": 1,
      "id": "gr.c1.it-clefts",
      "cefr": "C1",
      "title": "It-clefts for focused emphasis",
      "objective": "Use It was X that/who... to focus a constituent.",
      "concept": {
        "en": "It-clefts isolate one constituent as the corrective or contrastive focus of a proposition.",
        "vi": "Câu chẻ it-cleft tách một thành phần làm tiêu điểm sửa sai hoặc đối lập của mệnh đề."
      },
      "formulae": [
        "It + be + focused element + that/who + clause"
      ],
      "whenToUse": [
        "Use an it-cleft to identify precisely who, what, when, or where carries the main contrast."
      ],
      "forms": {
        "positive": [
          "It was the procurement process that the inquiry criticized, not the final contract.",
          "It is senior management who must decide whether the residual risk is acceptable.",
          "It was after the second outage that the team changed its escalation procedure."
        ]
      },
