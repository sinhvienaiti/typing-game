    {
      "schemaVersion": 1,
      "id": "gr.c1.complex-reporting-passives",
      "cefr": "C1",
      "title": "Complex reporting passives",
      "objective": "Use passive reporting with perfect/continuous infinitives and appropriate evidential distance.",
      "concept": {
        "en": "Reporting passives can combine with perfect or continuous infinitives to locate the reported situation in time and distance the writer from the claim.",
        "vi": "Bị động tường thuật có thể đi với nguyên mẫu hoàn thành hoặc tiếp diễn để định vị thời gian và tạo khoảng cách với thông tin được thuật lại."
      },
      "formulae": [
        "subject + be + reported/believed + to have + past participle",
        "subject + be + thought + to be + -ing"
      ],
      "whenToUse": [
        "Use complex reporting passives in formal reporting when evidence is attributed rather than asserted directly."
      ],
      "forms": {
        "positive": [
          "The contractor is believed to have underestimated the maintenance cost by several million euros.",
          "The species is thought to be adapting more rapidly than earlier models predicted.",
          "Several files are reported to have been deleted before the inspection began."
        ]
      },
