    {
      "schemaVersion": 1,
      "id": "gr.c1.mandative-subjunctive",
      "cefr": "C1",
      "title": "Mandative subjunctive",
      "objective": "Use base-form subjunctives after recommendations, demands and necessity expressions.",
      "concept": {
        "en": "The mandative subjunctive uses the base form after verbs and nouns expressing recommendation, demand, or necessity.",
        "vi": "Mandative subjunctive dùng dạng nguyên mẫu không to sau các từ diễn đạt khuyến nghị, yêu cầu hoặc sự cần thiết."
      },
      "formulae": [
        "recommend/insist/request that + subject + base verb",
        "requirement that + subject + base verb"
      ],
      "whenToUse": [
        "Use the base-form subjunctive especially in formal AmE and international institutional English."
      ],
      "forms": {
        "positive": [
          "The ethics committee recommended that the protocol be revised before recruitment resumed.",
          "The contract requires that each subcontractor maintain separate audit records.",
          "Her proposal was that the decision remain confidential until Monday."
        ]
      },
