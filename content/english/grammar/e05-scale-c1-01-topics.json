    {
      "schemaVersion": 1,
      "id": "gr.c1.fronting-topicalization",
      "cefr": "C1",
      "title": "Fronting and topicalization",
      "objective": "Move constituents to the front to establish topic or contrast without losing clarity.",
      "concept": {
        "en": "Fronting moves a constituent to clause-initial position to establish topic, contrast, or a discourse frame.",
        "vi": "Fronting đưa một thành phần lên đầu câu để xác lập chủ đề, tạo đối lập hoặc khung diễn ngôn."
      },
      "formulae": [
        "Fronted object/complement + subject + verb",
        "Fronted adverbial + clause"
      ],
      "whenToUse": [
        "Use fronting when the moved material is already salient or needs deliberate contrast."
      ],
      "forms": {
        "positive": [
          "This distinction, many policy makers still fail to appreciate.",
          "More difficult to justify is the assumption that demand will remain constant.",
          "On the practical implications, the report has surprisingly little to say."
        ]
      },
