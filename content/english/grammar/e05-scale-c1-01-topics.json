    {
      "schemaVersion": 1,
      "id": "gr.c1.perfect-participle-clauses",
      "cefr": "C1",
      "title": "Perfect participle clauses",
      "objective": "Use having + past participle for earlier non-finite events.",
      "concept": {
        "en": "Perfect participle clauses mark a non-finite event as completed before the event in the main clause.",
        "vi": "Mệnh đề phân từ hoàn thành đánh dấu một sự việc không chia đã hoàn tất trước sự việc ở mệnh đề chính."
      },
      "formulae": [
        "Having + past participle, main clause",
        "Having been + past participle, main clause"
      ],
      "whenToUse": [
        "Use perfect participles when anteriority matters and the understood subject is shared with the main clause."
      ],
      "forms": {
        "positive": [
          "Having reviewed the raw data, the panel requested a second statistical analysis.",
          "Having been warned about the capacity limit, the organizers reduced registration.",
          "Having completed the pilot successfully, the laboratory moved to a larger trial."
        ]
      },
