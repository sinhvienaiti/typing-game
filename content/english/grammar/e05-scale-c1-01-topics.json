    {
      "schemaVersion": 1,
      "id": "gr.c1.participle-clause-control",
      "cefr": "C1",
      "title": "Participle clauses and subject control",
      "objective": "Avoid dangling or ambiguous participle clauses.",
      "concept": {
        "en": "A participle clause normally shares its understood subject with the subject of the main clause; mismatches create dangling modifiers.",
        "vi": "Mệnh đề phân từ thường có chủ ngữ ngầm trùng với chủ ngữ mệnh đề chính; lệch chủ ngữ tạo dangling modifier."
      },
      "formulae": [
        "Participle clause, same-subject main clause"
      ],
      "whenToUse": [
        "Check subject control whenever reducing a finite clause to an -ing or -ed participle clause."
      ],
      "forms": {
        "positive": [
          "Working from incomplete records, the investigators treated the early estimates cautiously.",
          "Designed for low-bandwidth environments, the application remains usable during network congestion.",
          "Not wishing to delay the vote, the chair shortened the final discussion."
        ]
      },
