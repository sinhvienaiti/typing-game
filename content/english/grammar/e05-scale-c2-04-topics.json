    {
      "schemaVersion": 1,
      "id": "gr.c2.dense-noun-phrases",
      "cefr": "C2",
      "title": "Dense noun phrases and noun stacks",
      "objective": "Parse and edit long premodification chains for clarity in technical/academic prose.",
      "concept": {
        "en": "Dense technical noun phrases can stack classifiers, nominal modifiers, participles, and postmodifiers, but excessive stacking hides semantic relations.",
        "vi": "Cụm danh từ kỹ thuật dày có thể chồng classifier, noun modifier, participle và hậu bổ nghĩa, nhưng chồng quá mức sẽ che quan hệ nghĩa."
      },
      "formulae": [
        "premodifier stack + head noun + postmodifier",
        "unpack noun stack with of/for/relative clause where needed"
      ],
      "whenToUse": [
        "Parse the head and modifier relations first, then unpack any stack whose interpretation is not immediate."
      ],
      "forms": {
        "positive": [
          "The committee approved the high-risk supplier data-retention policy review schedule.",
          "We revised the schedule for reviewing the data-retention policy applied to high-risk suppliers.",
          "The newly proposed cross-border payment fraud detection reporting standard requires further consultation."
        ]
      },
