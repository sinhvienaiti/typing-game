    {
      "schemaVersion": 1,
      "id": "gr.c2.evidential-distancing",
      "cefr": "C2",
      "title": "Evidential and reporting distance",
      "objective": "Attribute claims and manage commitment through reportedly, be said to, seem and related grammar.",
      "concept": {
        "en": "Evidential and reporting constructions identify the source or status of information and let writers calibrate responsibility for a claim.",
        "vi": "Cấu trúc evidential và reporting chỉ ra nguồn/trạng thái thông tin và cho phép người viết điều chỉnh trách nhiệm đối với một tuyên bố."
      },
      "formulae": [
        "reportedly/allegedly/apparently + clause",
        "be said/reported/thought + to-infinitive",
        "seem/appear + to-infinitive"
      ],
      "whenToUse": [
        "Choose distancing language that matches evidence strength and avoids presenting unattributed allegations as established fact."
      ],
      "forms": {
        "positive": [
          "The subsidiary is reported to have transferred the assets shortly before the investigation began.",
          "Reportedly, several bidders withdrew after the timetable was changed.",
          "The discrepancy appears to reflect a coding change rather than an underlying trend."
        ]
      },
