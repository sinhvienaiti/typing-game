    {
      "schemaVersion": 1,
      "id": "gr.c2.pragmatic-tense-modal",
      "cefr": "C2",
      "title": "Pragmatic meanings of tense and modality",
      "objective": "Use tense/modal choices for politeness, distancing, tentativeness and interpersonal stance.",
      "concept": {
        "en": "Tense and modal forms can encode interpersonal distance, politeness, tentativeness, and stance beyond their literal temporal or logical meanings.",
        "vi": "Thì và modal có thể mã hóa khoảng cách liên cá nhân, lịch sự, dè dặt và lập trường vượt ngoài nghĩa thời gian hay logic trực tiếp."
      },
      "formulae": [
        "past tense for social distance",
        "modal remoteness for tentative proposals",
        "progressive for softened intention"
      ],
      "whenToUse": [
        "Interpret tense/modality pragmatically when literal time alone does not explain the speaker's choice."
      ],
      "forms": {
        "positive": [
          "I was wondering whether you might have a moment to discuss the revised terms.",
          "We were hoping to avoid reopening the entire negotiation at this stage.",
          "Could we perhaps frame the recommendation more cautiously?"
        ]
      },
