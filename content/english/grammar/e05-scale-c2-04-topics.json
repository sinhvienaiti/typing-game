      "schemaVersion": 1,
      "id": "gr.c2.word-class-conversion",
      "cefr": "C2",
      "title": "Word-class conversion",
      "objective": "Recognize and use noun↔verb/adjective shifts without overt morphology in contemporary English.",
      "concept": {
        "en": "English freely converts forms between noun, verb, and adjective uses without overt derivational morphology when syntax and convention license the shift.",
        "vi": "Tiếng Anh thường chuyển đổi từ giữa danh từ, động từ và tính từ mà không thêm hình vị phái sinh khi cú pháp và quy ước cho phép."
      },
      "formulae": [
        "noun ↔ verb conversion",
        "adjective/noun used in newly licensed syntactic slot"
      ],
      "whenToUse": [
        "Use conversion where it is established or transparently productive, and avoid novel conversions that obscure meaning in formal prose."
      ],
      "forms": {
        "positive": [
          "The team benchmarked the new parser against three established systems.",
          "Please email the signed declaration to the secretariat before noon.",
          "The policy aims to mainstream accessibility rather than treat it as a late-stage check."
        ]
      },
