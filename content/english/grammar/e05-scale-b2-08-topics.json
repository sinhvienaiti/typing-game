    {
      "schemaVersion": 1,
      "id": "gr.b2.preposition-choice-meaning",
      "cefr": "B2",
      "title": "Preposition choice and meaning contrasts",
      "objective": "Distinguish near-synonymous prepositions in time, place, cause and method contexts.",
      "concept": {
        "en": "Near-synonymous prepositions encode different relations of point, area, agent, means, cause and method, so literal translation often selects the wrong one.",
        "vi": "Các giới từ gần nghĩa mã hóa những quan hệ khác nhau như điểm, vùng, tác nhân, phương tiện, nguyên nhân và cách thức; dịch sát từng từ thường dẫn đến chọn sai."
      },
      "formulae": [
        "arrive at/in",
        "by + agent/method",
        "with + instrument",
        "for + beneficiary/purpose"
      ],
      "whenToUse": [
        "Choose prepositions from the semantic relation and collocation rather than from a one-to-one translation equivalent."
      ],
      "forms": {
        "positive": [
          "We arrived at the station just before noon.",
          "The report was written by an independent consultant for the board.",
          "He solved the problem with a temporary workaround rather than by replacing the server."
        ]
      },
