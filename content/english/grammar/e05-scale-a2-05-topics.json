    {
      "schemaVersion": 1,
      "id": "gr.a2.preposition-ing",
      "cefr": "A2",
      "title": "Preposition + -ing",
      "objective": "Use gerunds after common prepositions.",
      "concept": {
        "en": "After a preposition, use a noun or an -ing form rather than a to-infinitive.",
        "vi": "Sau giới từ, dùng danh từ hoặc dạng V-ing thay vì to-infinitive."
      },
      "formulae": [
        "preposition + verb-ing"
      ],
      "whenToUse": [
        "Use verbs after prepositions such as at, for, without, before and after."
      ],
      "forms": {
        "positive": [
          "She's good at drawing.",
          "Thank you for helping me.",
          "He left without saying goodbye."
        ]
      },
      "variations": [
        "To can be a preposition in some patterns, but this A2 rule covers ordinary prepositions such as for and without."
      ],
