    {
      "schemaVersion": 1,
      "id": "gr.a2.infinitive-purpose",
      "cefr": "A2",
      "title": "To-infinitive for purpose",
      "objective": "Explain why someone does something using to + verb.",
      "concept": {
        "en": "Use to + base verb to explain the purpose of an action.",
        "vi": "Dùng to + động từ nguyên mẫu để giải thích mục đích của một hành động."
      },
      "formulae": [
        "main action + to + base verb (purpose)"
      ],
      "whenToUse": [
        "Answer the question why someone does something."
      ],
      "forms": {
        "positive": [
          "I went to the shop to buy milk.",
          "She called me to ask a question.",
          "We use this box to store tools."
        ]
      },
      "variations": [
        "For + noun can express purpose too, but for + base verb is not the same construction."
      ],
      "relatedCollocationIds": [],
      "exampleIds": [
