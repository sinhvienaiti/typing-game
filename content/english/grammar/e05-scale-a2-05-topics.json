    {
      "schemaVersion": 1,
      "id": "gr.a2.verb-ing-common",
      "cefr": "A2",
      "title": "Common verb + -ing patterns",
      "objective": "Use enjoy/finish/avoid/mind and similar verbs with -ing.",
      "concept": {
        "en": "Some common verbs such as enjoy, finish and avoid are followed by an -ing form.",
        "vi": "Một số động từ thông dụng như enjoy, finish và avoid được theo sau bởi dạng V-ing."
      },
      "formulae": [
        "verb + verb-ing"
      ],
      "whenToUse": [
        "Use the correct complement after common verbs that select an -ing form."
      ],
      "forms": {
        "positive": [
          "I enjoy cooking at home.",
          "Leo finished cleaning the kitchen.",
          "They avoid driving at night."
        ]
      },
      "variations": [
        "Learn the complement as part of each verb pattern."
