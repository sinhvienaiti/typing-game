    {
      "schemaVersion": 1,
      "id": "gr.a2.defining-relatives-basic",
      "cefr": "A2",
      "title": "Defining relative clauses: who/which/that",
      "objective": "Add essential information about people and things.",
      "concept": {
        "en": "Use who for people and that/which for things in a defining relative clause that identifies the noun.",
        "vi": "Dùng who cho người và that/which cho vật trong mệnh đề quan hệ xác định để nhận diện danh từ."
      },
      "formulae": [
        "person + who + clause",
        "thing + that/which + clause"
      ],
      "whenToUse": [
        "Add essential information that tells exactly which person or thing you mean."
      ],
      "forms": {
        "positive": [
          "A mechanic is a person who repairs cars.",
          "This is the book that I bought yesterday.",
          "The woman who lives next door is a nurse."
        ]
      },
      "variations": [
        "That can often refer to people or things in defining clauses, while who is the clearest choice for people."
      ],
