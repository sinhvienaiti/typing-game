    {
      "schemaVersion": 1,
      "id": "gr.a2.adjective-to-infinitive",
      "cefr": "A2",
      "title": "Adjective + to-infinitive",
      "objective": "Use common adjective complements such as happy to/helpful to/easy to.",
      "concept": {
        "en": "Use adjective + to-infinitive after many adjectives to describe feelings, reactions, difficulty or readiness.",
        "vi": "Dùng tính từ + to-infinitive sau nhiều tính từ để nói về cảm xúc, phản ứng, độ khó hoặc sự sẵn sàng."
      },
      "formulae": [
        "be + adjective + to + base verb"
      ],
      "whenToUse": [
        "Add an action after adjectives such as happy, easy, ready, surprised and difficult."
      ],
      "forms": {
        "positive": [
          "I'm happy to help.",
          "This book is easy to understand.",
          "We were surprised to see Ben."
        ]
      },
      "variations": [
        "The adjective describes the subject or the situation, while the infinitive names the related action."
      ],
