    {
      "schemaVersion": 1,
      "id": "gr.a2.phrasal-verbs-object-position",
      "cefr": "A2",
      "title": "Basic phrasal verbs and object position",
      "objective": "Place noun/pronoun objects correctly with common separable phrasal verbs.",
      "concept": {
        "en": "With separable phrasal verbs, a noun object may go before or after the particle, but a pronoun object normally goes between the verb and particle.",
        "vi": "Với cụm động từ có thể tách, tân ngữ danh từ có thể đứng trước hoặc sau tiểu từ, nhưng tân ngữ đại từ thường phải đứng giữa động từ và tiểu từ."
      },
      "formulae": [
        "verb + noun + particle / verb + particle + noun",
        "verb + pronoun + particle"
      ],
      "whenToUse": [
        "Place noun and pronoun objects correctly with common separable phrasal verbs."
      ],
      "forms": {
        "positive": [
          "Please turn the light off.",
          "Please turn it off.",
          "She picked the children up at four."
        ]
      },
      "variations": [
        "Not every phrasal verb is separable, so object position must be learned with the verb."
      ],
