    {
      "schemaVersion": 1,
      "id": "gr.a2.relative-where",
      "cefr": "A2",
      "title": "Relative clauses with where",
      "objective": "Describe places with where clauses.",
      "concept": {
        "en": "Use where in a defining relative clause to identify a place by what happens there.",
        "vi": "Dùng where trong mệnh đề quan hệ xác định để nhận diện một nơi thông qua việc xảy ra ở đó."
      },
      "formulae": [
        "place + where + subject + verb"
      ],
      "whenToUse": [
        "Combine a place noun with information about activities or events at that place."
      ],
      "forms": {
        "positive": [
          "This is the cafe where we first met.",
          "I know a park where children can play safely.",
          "That's the hotel where we stayed."
        ]
      },
      "variations": [
        "Where can often be paraphrased with in/at which at higher levels."
      ],
