    {
      "schemaVersion": 1,
      "id": "gr.a2.verb-to-infinitive-common",
      "cefr": "A2",
      "title": "Common verb + to-infinitive patterns",
      "objective": "Use want/hope/plan/decide/need and similar verbs with to-infinitives.",
      "concept": {
        "en": "Some common verbs such as want, decide, hope, plan and need are followed by to + base verb.",
        "vi": "Một số động từ thông dụng như want, decide, hope, plan và need được theo sau bởi to + động từ nguyên mẫu."
      },
      "formulae": [
        "verb + to + base verb"
      ],
      "whenToUse": [
        "Use the correct complement after common verbs that select the to-infinitive."
      ],
      "forms": {
        "positive": [
          "I want to learn Spanish.",
          "They decided to leave early.",
          "Mia hopes to find a new job."
        ]
      },
      "variations": [
        "Verb patterns must be learned with the verb because different verbs select different complements."
      ],
