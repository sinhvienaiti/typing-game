    {
      "schemaVersion": 1,
      "id": "gr.c1.stance-positioning",
      "cefr": "C1",
      "title": "Stance adverbials and writer positioning",
      "objective": "Signal confidence, evaluation and viewpoint in formal discourse.",
      "concept": {
        "en": "Stance adverbials position the writer toward the certainty, value, or interpretation of an entire proposition.",
        "vi": "Trạng ngữ lập trường đặt người viết vào một vị thế về độ chắc chắn, giá trị hoặc cách diễn giải của toàn mệnh đề."
      },
      "formulae": [
        "stance adverbial, + clause",
        "clause + stance adverbial in medial position"
      ],
      "whenToUse": [
        "Choose stance markers that make evaluation explicit without overstating the evidence."
      ],
      "forms": {
        "positive": [
          "Crucially, the comparison controls for differences in baseline risk.",
          "Admittedly, the proposed timetable leaves little room for unexpected delays.",
          "From a regulatory perspective, the distinction is difficult to defend."
        ]
      },
