    {
      "schemaVersion": 1,
      "id": "gr.c1.epistemic-hedging",
      "cefr": "C1",
      "title": "Epistemic hedging",
      "objective": "Calibrate certainty with seem, appear, tend to, may, arguably and related patterns.",
      "concept": {
        "en": "Epistemic hedges calibrate the writer's commitment to a proposition instead of presenting uncertain evidence as fact.",
        "vi": "Hedge nhận thức điều chỉnh mức độ cam kết của người viết với một mệnh đề thay vì trình bày bằng chứng chưa chắc chắn như sự thật."
      },
      "formulae": [
        "seem/appear/tend to + infinitive",
        "may/might + verb",
        "arguably/apparently + clause"
      ],
      "whenToUse": [
        "Use hedging when evidence is limited, probabilistic, contested, or based on interpretation."
      ],
      "forms": {
        "positive": [
          "The discrepancy appears to result from a change in the sampling procedure.",
          "The policy may have reduced short-term demand without affecting long-term behavior.",
          "Arguably, the strongest evidence comes from the longitudinal cohort."
        ]
      },
