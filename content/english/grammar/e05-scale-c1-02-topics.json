    {
      "schemaVersion": 1,
      "id": "gr.c1.sentential-relative-which",
      "cefr": "C1",
      "title": "Sentential which clauses",
      "objective": "Use which to comment on a preceding clause or proposition.",
      "concept": {
        "en": "A non-defining which clause can refer back to an entire preceding proposition and add a comment on it.",
        "vi": "Mệnh đề which không xác định có thể quy chiếu lại toàn bộ mệnh đề trước và bình luận về sự việc đó."
      },
      "formulae": [
        "main clause, which + verb/complement"
      ],
      "whenToUse": [
        "Use sentential which to add an evaluative consequence or comment without pretending which modifies only one noun."
      ],
      "forms": {
        "positive": [
          "The regulator postponed the hearing again, which frustrated several local groups.",
          "The data were released ahead of schedule, which allowed independent teams to replicate the analysis.",
          "The chair rejected both amendments, which was not what either side had expected."
        ]
      },
