    {
      "schemaVersion": 1,
      "id": "gr.c1.advanced-concession",
      "cefr": "C1",
      "title": "Advanced concession: even if/even though/much as",
      "objective": "Choose concessive structures based on fact vs hypothesis and register.",
      "concept": {
        "en": "Advanced concessive clauses distinguish factual concession from hypothetical concession and can encode formal rhetorical contrast.",
        "vi": "Cấu trúc nhượng bộ nâng cao phân biệt nhượng bộ sự thật với giả định và có thể tạo đối lập tu từ trang trọng."
      },
      "formulae": [
        "even though + factual clause",
        "even if + hypothetical clause",
        "much as + clause"
      ],
      "whenToUse": [
        "Select the concessive marker according to whether the obstacle is known to be true, hypothetical, or rhetorically acknowledged."
      ],
      "forms": {
        "positive": [
          "Even though the preliminary result is encouraging, the sample remains too small for a firm conclusion.",
          "Even if the appeal succeeds, the implementation timetable will still need revision.",
          "Much as I understand the concern, I cannot support the proposed exemption."
        ]
      },
