    {
      "schemaVersion": 1,
      "id": "gr.c1.advanced-reduced-relatives",
      "cefr": "C1",
      "title": "Advanced non-finite relative reduction",
      "objective": "Reduce relative clauses with participles/infinitives while preserving meaning.",
      "concept": {
        "en": "Relative clauses can be reduced to participle or infinitive clauses when the omitted subject and time/voice relation remain recoverable.",
        "vi": "Mệnh đề quan hệ có thể rút gọn thành phân từ hoặc nguyên mẫu khi chủ ngữ bị lược và quan hệ thời/voice vẫn rõ."
      },
      "formulae": [
        "noun + -ing clause",
        "noun + past-participle clause",
        "noun + to-infinitive"
      ],
      "whenToUse": [
        "Reduce relatives only when the result preserves the original voice and intended reference."
      ],
      "forms": {
        "positive": [
          "Researchers working on the replication project will meet on Friday.",
          "Applications received after the deadline will be considered only if places remain.",
          "The next witness to appear before the committee is the former finance director."
