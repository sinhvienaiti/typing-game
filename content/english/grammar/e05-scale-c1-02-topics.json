    {
      "schemaVersion": 1,
      "id": "gr.c1.free-choice-concession",
      "cefr": "C1",
      "title": "No matter and wh-ever concession",
      "objective": "Express unrestricted conditions such as no matter how/whatever happens.",
      "concept": {
        "en": "Free-choice concessives express that every value or outcome within a set leads to the same result.",
        "vi": "Nhượng bộ free-choice diễn đạt rằng dù lựa chọn hay kết quả nào trong một tập xảy ra thì kết quả chính vẫn không đổi."
      },
      "formulae": [
        "whatever/whichever/whoever + clause",
        "no matter + wh-word + clause"
      ],
      "whenToUse": [
        "Use free-choice concession to neutralize variation in person, option, degree, or circumstance."
      ],
      "forms": {
        "positive": [
          "Whatever the final estimate turns out to be, the reserve will cover the statutory minimum.",
          "No matter how carefully the model is calibrated, some uncertainty will remain.",
          "Whichever route the commission chooses, local consultation will be required."
        ]
      },
