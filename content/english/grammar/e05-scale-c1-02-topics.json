    {
      "schemaVersion": 1,
      "id": "gr.c1.modal-remoteness",
      "cefr": "C1",
      "title": "Modal remoteness and tentative meaning",
      "objective": "Use past/modal forms to soften stance, proposals and interpersonal claims.",
      "concept": {
        "en": "Past and modal forms can signal social or epistemic distance rather than literal past time.",
        "vi": "Dạng quá khứ và modal có thể biểu thị khoảng cách xã hội hoặc mức độ dè dặt, không nhất thiết chỉ thời gian quá khứ."
      },
      "formulae": [
        "I wondered if + past/modal clause",
        "It might be + adjective + to-infinitive"
      ],
      "whenToUse": [
        "Use modal remoteness to soften proposals, requests, and potentially face-threatening claims."
      ],
      "forms": {
        "positive": [
          "I wondered whether we might postpone the decision until the legal opinion arrives.",
          "It might be wiser to separate the two funding questions.",
          "I was hoping you could review the revised appendix before Thursday."
        ]
      },
