    {
      "schemaVersion": 1,
      "id": "gr.c1.mandative-should",
      "cefr": "C1",
      "title": "Mandative should",
      "objective": "Use should in formal recommendation/necessity clauses where natural.",
      "concept": {
        "en": "Mandative should is a formal alternative in recommendation and necessity clauses, particularly in British English.",
        "vi": "Mandative should là lựa chọn trang trọng trong mệnh đề khuyến nghị và sự cần thiết, đặc biệt phổ biến trong Anh-Anh."
      },
      "formulae": [
        "recommend/essential/important that + subject + should + base verb"
      ],
      "whenToUse": [
        "Use mandative should where the register or regional norm favors it over the bare subjunctive."
      ],
      "forms": {
        "positive": [
          "The panel recommended that an independent observer should attend every hearing.",
          "It is essential that the revised figures should reach investors before the announcement.",
          "The directors insisted that the matter should be reconsidered at the next meeting."
        ]
      },
