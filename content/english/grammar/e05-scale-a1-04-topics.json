 short phrases."],"relatedCollocationIds":[],"exampleIds":["sent.gra1.04.08.1","sent.gra1.04.08.2","sent.gra1.04.08.3"],"commonMistakeIds":["err.gra1.04.08"],"contrastTopicIds":[],"dialogueIds":[],"prerequisiteIds":[],"exerciseIds":["ex.cloze.gra1.04.08","ex.translation.gra1.04.08"],"quality":{"state":"draft","checks":{"schema":{"status":"pass","method":"e05-grammar-a1-scale-authoring-v1"},"grammar":{"status":"pending","method":"independent-grammar-review-required"},"exactDuplicate":{"status":"pass","method":"stable-id-and-local-exact-dedup-v1"},"nearDuplicate":{"status":"pending","method":"cross-runtime-near-dedup-review-required"},"naturalness":{"status":"pending","method":"editor-review-required"},"cefr":{"status":"pending","method":"cefr-review-required"},"license":{"status":"pending","method":"project-original-license-review-required"},"translation":{"status":"pending","method":"bilingual-concept-review-required"},"targetPresence":{"status":"pending","method":"linked-content-target-review-required"}}},"provenance":{"sources":[{"dataset":"project-original","sourceId":"gr.a1.coordinators","sourceUrl":"content/english/grammar/e05-scale-a1-04-topics.json","snapshot":"2026-10","license":"LicenseRef-Project-Original","modified":false}],"note":"Project-original controlled A1 grammar-body scale content; publication is review-ledger only."}}]}