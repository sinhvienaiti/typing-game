{"schemaVersion":1,"records":[{"schemaVersion":1,"id":"gr.a1.likes-gerund-noun","cefr":"A1","title":"Likes and dislikes with nouns and -ing forms","objective":"Talk about simple likes and dislikes with nouns and -ing forms.","concept":{"en":"Use like, love, enjoy and hate with a noun or an -ing form to talk about preferences.","vi":"Dùng like, love, enjoy và hate với danh từ hoặc dạng -ing để nói về sở thích."},"formulae":["Subject + like/love/enjoy/hate + noun.","Subject + like/love/enjoy/hate + verb-ing."],"whenToUse":["Talk about things or activities you like or dislike.","Ask and answer simple questions about preferences."],"forms":{"positive":["I like coffee.","Mina loves reading after dinner.","We enjoy playing board games."]},"variations":["With he, she and it in the present simple, use likes, loves, enjoys or hates."],"relatedCollocationIds":[],"exampleIds":["sent.gra1.04.01.1","sent.gra1.04.01.2","sent.gra1.04.01.3"],"commonMistakeIds":["err.gra1.04.01"],"contrastTopicIds":["gr.a1.present-simple-positive"],"dialogueIds":[],"prerequisiteIds":["gr.a1.present-simple-positive"],"exerciseIds":["ex.cloze.gra1.04.01","ex.translation.gra1.04.01"],"quality":{"state":"draft","checks":{"schema":{"status":"pass","method":"e05-grammar-a1-scale-authoring-v1"},"grammar":{"status":"pending","method":"independent-grammar-review-required"},"exactDuplicate":{"status":"pass","method":"stable-id-and-local-exact-dedup-v1"},"nearDuplicate":{"status":"pending","method":"cross-runtime-near-dedup-review-required"},"naturalness":{"status":"pending","method":"editor-review-required"},"cefr":{"status":"pending","method":"cefr-review-required"},"license":{"status":"pending","method":"project-original-license-review-required"},"translation":{"status":"pending","method":"bilingual-concept-review-required"},"targetPresence":{"status":"pending","method":"linked-content-target-review-required"}}},"provenance":{"sources":[{"dataset":"project-original","sourceId":"gr.a1.likes-gerund-noun","sourceUrl":"content/english/grammar/e05-scale-a1-04-topics.json","snapshot":"2026-10","license":"LicenseRef-Project-Original","modified":false}],"note":"Project-original controlled A1 grammar-body scale content; publication is review-ledger only."}},{"schemaVersion":1,"id":"gr.a1.want-need-infinitive","cefr":"A1","title":"Want and need + to-infinitive","objective":"Use want to and need to for simple wishes and necessities.","concept":{"en":"Use want to + base verb for wishes and need to + base verb for necessities.","vi":"Dùng want to + động từ nguyên mẫu để nói mong muốn và need to + động từ nguyên mẫu để nói điều cần thiết."},"formulae":["Subject + want(s) to + base verb.","Subject + need(s) to + base verb."],"whenToUse":["Say what you would like to do.","Say what is necessary to do."],"forms":{"positive":["I want to learn Spanish.","He needs to leave early.","We want to visit the museum."]},"variations":["With he, she and it in the present simple, use wants to and needs to."],"relatedCollocationIds":[],"exampleIds":["sent.gra1.04.02.1","sent.gra1.04.02.2","sent.gra1.04.02.3"],"commonMistakeIds":["err.gra1.04.02"],"contrastTopicIds":["gr.a1.can-ability"],"dialogueIds":[],"prerequisiteIds":["gr.a1.present-simple-positive"],"exerciseIds":["ex.cloze.gra1.04.02","ex.translation.gra1.04.02"],"quality":{"state":"draft","checks":{"schema":{"status":"pass","method":"e05-grammar-a1-scale-authoring-v1"},"grammar":{"status":"pending","method":"independent-grammar-review-required"},"exactDuplicate":{"status":"pass","method":"stable-id-and-local-exact-dedup-v1"},"nearDuplicate":{"status":"pending","method":"cross-runtime-near-dedup-review-required"},"naturalness":{"status":"pending","method":"editor-review-required"},"cefr":{"status":"pending","method":"cefr-review-required"},"license":{"status":"pending","method":"project-original-license-review-required"},"translation":{"status":"pending","method":"bilingual-concept-review-required"},"targetPresence":{"status":"pending","method