r":{"status":"pending","method":"cefr-review-required"},"license":{"status":"pending","method":"project-original-license-review-required"},"translation":{"status":"pending","method":"bilingual-concept-review-required"},"targetPresence":{"status":"pending","method":"linked-content-target-review-required"}}},"provenance":{"sources":[{"dataset":"project-original","sourceId":"gr.a1.place-prepositions","sourceUrl":"content/english/grammar/e05-scale-a1-04-topics.json","snapshot":"2026-10","license":"LicenseRef-Project-Original","modified":false}],"note":"Project-original controlled A1 grammar-body scale content; publication is review-ledger only."}},{"schemaVersion":1,"id":"gr.a1.movement-prepositions","cefr":"A1","title":"Movement prepositions: to, into, out of and from","objective":"Use basic prepositions to describe movement between places.","concept":{"en":"Use to for a destination, into for movement inside, out of for movement from inside, and from for a starting point.","vi":"Dùng to cho điểm đến, into cho chuyển động vào bên trong, out of cho chuyển động ra khỏi bên trong và from cho điểm xuất phát."},"formulae":["go/come + to + place","move/walk + into/out of + place","travel/come + from + place"],"whenToUse":["Say where someone is going.","Describe simple movement into or out of a place."],"forms":{"positive":["We walk to school.","She goes into the shop.","They come from Hanoi."]},"variations":["Do not normally use to before home after go/come: go home, come home."],"relatedCollocationIds":[],"exampleIds":["sent.gra1.04.05.1","sent.gra1.04.05.2","sent.gra1.04.05.3"],"commonMistakeIds":["err.gra1.04.05"],"contrastTopicIds":["gr.a1.place-prepositions"],"dialogueIds":[],"prerequisiteIds":["gr.a1.present-simple-positive"],"exerciseIds":["ex.cloze.gra1.04.05","ex.translation.gra1.04.05"],"quality":{"state":"draft","checks":{"schema":{"status":"pass","method":"e05-grammar-a1-scale-authoring-v1"},"grammar":{"status":"pending","method":"independent-grammar-review-required"},"exactDuplicate":{"status":"pass","method":"stable-id-and-local-exact-dedup-v1"},"nearDuplicate":{"status":"pending","method":"cross-runtime-near-dedup-review-required"},"naturalness":{"status":"pending","method":"editor-review-required"},"cefr":{"status":"pending","method":"cefr-review-required"},"license":{"status":"pending","method":"project-original-license-review-required"},"translation":{"status":"pending","method":"bilingual-concept-review-required"},"targetPresence":{"status":"pending","method":"linked-content-target-review-required"}}},"provenance":{"sources":[{"dataset":"project-original","sourceId":"gr.a1.movement-prepositions","sourceUrl":"content/english/grammar/e05-scale-a1-04-topics.json","snapshot":"2026-10","license":"LicenseRef-Project-Original","modified":false}],"note":"Project-original controlled A1 grammar-body scale content; publication is review-ledger only."}},{"schemaVersion":1,"id":"gr.a1.adjective-position","cefr":"A1","title":"Adjective position before nouns and after be","objective":"Put common adjectives in the correct position in simple sentences.","concept":{"en":"Put an adjective before a noun, or after be when the adjective describes the subject.","vi":"Đặt tính từ trước danh từ, hoặc sau động từ be khi tính từ miêu tả chủ ngữ."},"formulae":["adjective + noun","subject + be + adjective"],"whenToUse":["Describe people, places and things.","Add simple information about size, colour, quality or feeling."],"forms":{"positive":["It is a small room.","The room is small.","She has a blue bag."]},"variations":["English adjectives do not change for singular or plural nouns: a small room, two small rooms."],"relatedCollocationIds":[],"exampleIds":["sent.gra1.04.06.1","sent.gra1.04.06.2","sent.gra1.04.06.3"],"commonMistakeIds":["err.gra1.04.06"],"contrastTopicIds":[],"dialogueIds":[],"prerequisiteIds":["gr.a1.be-identification-description"],"exerciseIds":["ex.cloze.gra1.04.06","ex.translation.gra1.04.06"],"quality":{"state":"draft","chec