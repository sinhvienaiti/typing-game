    {
      "schemaVersion": 1,
      "id": "gr.a2.as-as",
      "cefr": "A2",
      "title": "As...as and not as...as",
      "objective": "Express equality and inequality.",
      "concept": {
        "en": "Use as + adjective/adverb + as to say two things are equal, and not as ... as to show inequality.",
        "vi": "Dùng as + tính từ/trạng từ + as để nói hai đối tượng ngang nhau và not as ... as để nói không ngang nhau."
      },
      "formulae": [
        "as + adjective/adverb + as",
        "not as + adjective/adverb + as"
      ],
      "whenToUse": [
        "Compare equality or difference without using -er/more."
      ],
      "forms": {
        "positive": [
          "This room is as quiet as the library.",
          "My phone isn't as expensive as yours.",
          "Tom runs as fast as Ben."
        ]
      },
      "variations": [
        "As ... as can compare adjectives or adverbs."
      ],
      "relatedCollocationIds": [],
