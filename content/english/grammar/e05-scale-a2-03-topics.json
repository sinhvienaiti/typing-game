    {
      "schemaVersion": 1,
      "id": "gr.a2.going-to-evidence",
      "cefr": "A2",
      "title": "Going to: evidence-based predictions",
      "objective": "Predict a near future result based on present evidence.",
      "concept": {
        "en": "Use be going to for a prediction based on present evidence that you can see or know now.",
        "vi": "Dùng be going to cho dự đoán dựa trên bằng chứng hiện tại mà ta có thể thấy hoặc biết ngay lúc này."
      },
      "formulae": [
        "Subject + am/is/are going to + base verb."
      ],
      "whenToUse": [
        "Predict a likely near-future event from visible present evidence."
      ],
      "forms": {
        "positive": [
          "Look at those clouds. It's going to rain.",
          "Be careful! You're going to drop that glass.",
          "The baby is yawning; she's going to fall asleep."
        ]
      },
      "variations": [
        "Going to can express both prior intentions and evidence-based predictions."
      ],
