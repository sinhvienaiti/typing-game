    {
      "schemaVersion": 1,
      "id": "gr.a2.too-much-many-enough-noun",
      "cefr": "A2",
      "title": "Too much/too many/enough + noun",
      "objective": "Express excess or sufficiency with nouns.",
      "concept": {
        "en": "Use too much with uncountable nouns, too many with plural countable nouns, and enough before nouns for sufficient quantity.",
        "vi": "Dùng too much với danh từ không đếm được, too many với danh từ đếm được số nhiều và enough trước danh từ để chỉ lượng đủ."
      },
      "formulae": [
        "too much + uncountable noun",
        "too many + plural countable noun",
        "enough + noun"
      ],
      "whenToUse": [
        "Judge whether a quantity is excessive or sufficient."
      ],
      "forms": {
        "positive": [
          "There is too much sugar in this tea.",
          "We have too many bags.",
          "There aren't enough chairs for everyone."
        ]
      },
      "variations": [
        "Enough comes before a noun but after an adjective."
      ],
