    {
      "schemaVersion": 1,
      "id": "gr.a2.too-enough-adjective",
      "cefr": "A2",
      "title": "Too and enough with adjectives/adverbs",
      "objective": "Express excess and sufficiency.",
      "concept": {
        "en": "Use too + adjective for more than is acceptable and adjective + enough for a sufficient degree.",
        "vi": "Dùng too + tính từ cho mức độ quá mức và tính từ + enough cho mức độ đủ."
      },
      "formulae": [
        "too + adjective (+ to-infinitive)",
        "adjective + enough (+ to-infinitive)"
      ],
      "whenToUse": [
        "Explain why something is impossible, difficult or possible because of degree."
      ],
      "forms": {
        "positive": [
          "This box is too heavy to carry.",
          "The water is warm enough to swim in.",
          "He isn't old enough to drive."
        ]
      },
      "variations": [
        "Too usually expresses an excessive, often problematic degree."
      ],
      "relatedCollocationIds": [],
