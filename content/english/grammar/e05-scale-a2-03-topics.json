    {
      "schemaVersion": 1,
      "id": "gr.a2.future-forms-basic-contrast",
      "cefr": "A2",
      "title": "Future forms: plans, arrangements, schedules and predictions",
      "objective": "Choose among going to, present continuous, present simple and will.",
      "concept": {
        "en": "Choose going to for prior intentions, Present Continuous for arranged plans, Present Simple for schedules and will for opinion-based predictions or immediate decisions.",
        "vi": "Chọn going to cho ý định đã có, Hiện tại tiếp diễn cho sắp xếp đã chốt, Hiện tại đơn cho lịch trình và will cho dự đoán theo ý kiến hoặc quyết định tức thời."
      },
      "formulae": [
        "intention: be going to + verb",
        "arrangement: be + verb-ing",
        "schedule: Present Simple",
        "prediction/instant decision: will + verb"
      ],
      "whenToUse": [
        "Select a basic future form according to meaning rather than using one future form for every situation."
      ],
      "forms": {
        "positive": [
          "I'm going to study medicine after school.",
          "I'm meeting the teacher at three tomorrow.",
          "I think the test will be difficult."
        ]
      },
      "variations": [
        "The same future event can sometimes be framed differently depending on intention, arrangement or prediction."
      ],
