    {
      "schemaVersion": 1,
      "id": "gr.a2.present-continuous-arrangements",
      "cefr": "A2",
      "title": "Present Continuous: future arrangements",
      "objective": "Talk about personal arrangements already organized.",
      "concept": {
        "en": "Use the Present Continuous for a future arrangement that has already been organized, often with a specific time or person.",
        "vi": "Dùng Hiện tại tiếp diễn cho một sắp xếp tương lai đã được tổ chức, thường có thời gian hoặc người liên quan cụ thể."
      },
      "formulae": [
        "Subject + am/is/are + verb-ing + future time."
      ],
      "whenToUse": [
        "Talk about fixed personal arrangements such as meetings, visits or travel."
      ],
      "forms": {
        "positive": [
          "I'm meeting Ana at six.",
          "We're having dinner with Sam tomorrow.",
          "They are flying to Bangkok on Friday."
        ]
      },
      "variations": [
        "A future time expression makes the future meaning clear."
      ],
