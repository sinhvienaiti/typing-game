    {
      "schemaVersion": 1,
      "id": "gr.a2.will-predictions",
      "cefr": "A2",
      "title": "Will: predictions",
      "objective": "Make neutral predictions about the future.",
      "concept": {
        "en": "Use will + base verb for a prediction based mainly on opinion, belief or expectation.",
        "vi": "Dùng will + động từ nguyên mẫu cho dự đoán chủ yếu dựa trên ý kiến, niềm tin hoặc kỳ vọng."
      },
      "formulae": [
        "Subject + will + base verb.",
        "Subject + probably will / will probably + base verb."
      ],
      "whenToUse": [
        "Make general future predictions when there is no present visible evidence."
      ],
      "forms": {
        "positive": [
          "I think our team will win.",
          "It will probably rain this evening.",
          "People will use less paper in the future."
        ]
      },
      "variations": [
        "Expressions such as I think, probably and maybe often accompany predictions."
      ],
