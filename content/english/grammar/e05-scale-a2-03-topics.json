      "id": "gr.a2.present-simple-schedules",
      "cefr": "A2",
      "title": "Present Simple: timetables and schedules",
      "objective": "Use present simple for fixed future schedules.",
      "concept": {
        "en": "Use the Present Simple for timetables and fixed public schedules.",
        "vi": "Dùng Hiện tại đơn cho thời khóa biểu, lịch trình và giờ cố định được công bố."
      },
      "formulae": [
        "Scheduled subject + Present Simple + future time."
      ],
      "whenToUse": [
        "State train, bus, film, class or event times that are fixed by a schedule."
      ],
      "forms": {
        "positive": [
          "The train leaves at 7:30 tomorrow.",
          "The film starts at eight.",
          "Our class finishes at noon."
        ]
      },
      "variations": [
        "This use is common for transport and official timetables."
