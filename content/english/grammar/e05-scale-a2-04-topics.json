    {
      "schemaVersion": 1,
      "id": "gr.a2.zero-conditional",
      "cefr": "A2",
      "title": "Zero Conditional",
      "objective": "Describe general truths, rules and repeated cause-effect.",
      "concept": {
        "en": "Use the Zero Conditional for facts, routines and results that are generally true whenever the condition happens.",
        "vi": "Dùng Câu điều kiện loại 0 cho sự thật, thói quen và kết quả thường đúng mỗi khi điều kiện xảy ra."
      },
      "formulae": [
        "If + Present Simple, Present Simple."
      ],
      "whenToUse": [
        "State general truths, instructions or repeated cause-and-effect relationships."
      ],
      "forms": {
        "positive": [
          "If you heat ice, it melts.",
          "If I don't sleep enough, I feel tired.",
          "Plants die if they don't get water."
        ]
      },
      "variations": [
        "Both clauses normally use the Present Simple because the result is general, not a one-time future prediction."
      ],
