    {
      "schemaVersion": 1,
      "id": "gr.a2.should-advice",
      "cefr": "A2",
      "title": "Should/shouldn't: advice",
      "objective": "Give and ask for everyday advice.",
      "concept": {
        "en": "Use should or shouldn't + base verb to give or ask for advice.",
        "vi": "Dùng should hoặc shouldn't + động từ nguyên mẫu để đưa ra hoặc hỏi lời khuyên."
      },
      "formulae": [
        "Subject + should/shouldn't + base verb.",
        "Should + subject + base verb?"
      ],
      "whenToUse": [
        "Recommend a sensible action without expressing a strict rule."
      ],
      "forms": {
        "positive": [
          "You should drink more water.",
          "He shouldn't stay up so late.",
          "Should I call the doctor?"
        ]
      },
      "variations": [
        "Should gives advice; must expresses stronger obligation."
      ],
