    {
      "schemaVersion": 1,
      "id": "gr.a2.future-time-clauses",
      "cefr": "A2",
      "title": "Future time clauses with when/as soon as/until",
      "objective": "Use present forms after future time conjunctions.",
      "concept": {
        "en": "Use a present tense after when, after, before, until and as soon as to refer to the future; use will in the main clause when needed.",
        "vi": "Dùng thì hiện tại sau when, after, before, until và as soon as để nói về tương lai; dùng will ở mệnh đề chính khi cần."
      },
      "formulae": [
        "will + verb + when/after/before/until + Present Simple",
        "When/After + Present Simple, will + verb"
      ],
      "whenToUse": [
        "Describe the timing of future actions."
      ],
      "forms": {
        "positive": [
          "I'll call you when I arrive.",
          "We'll eat after Dad gets home.",
          "Please wait here until the bus comes."
        ]
      },
      "variations": [
        "The main clause may use will, an imperative or another suitable future form."
      ],
