    {
      "schemaVersion": 1,
      "id": "gr.a2.could-past-ability",
      "cefr": "A2",
      "title": "Can/could: present and past ability",
      "objective": "Contrast present ability with general past ability.",
      "concept": {
        "en": "Use could or couldn't to describe general ability in the past.",
        "vi": "Dùng could hoặc couldn't để nói về khả năng chung trong quá khứ."
      },
      "formulae": [
        "Subject + could/couldn't + base verb."
      ],
      "whenToUse": [
        "Say what someone was generally able or unable to do at an earlier age or period."
      ],
      "forms": {
        "positive": [
          "I could swim when I was five.",
          "She couldn't read before she started school.",
          "Could you ride a bike at six?"
        ]
      },
      "variations": [
        "For one successful event, later levels often prefer was/were able to rather than could."
      ],
      "relatedCollocationIds": [],
