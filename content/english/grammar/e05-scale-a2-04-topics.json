    {
      "schemaVersion": 1,
      "id": "gr.a2.must-have-to",
      "cefr": "A2",
      "title": "Must and have to: obligation",
      "objective": "Express internal/external obligation in common contexts.",
      "concept": {
        "en": "Use must for strong speaker-imposed necessity and have to for necessity caused by rules or circumstances.",
        "vi": "Dùng must cho sự bắt buộc mạnh do người nói nhấn mạnh và have to cho sự bắt buộc do quy định hoặc hoàn cảnh."
      },
      "formulae": [
        "Subject + must + base verb.",
        "Subject + have/has to + base verb."
      ],
      "whenToUse": [
        "Express obligation and necessity in everyday rules and situations."
      ],
      "forms": {
        "positive": [
          "You must wear a seat belt.",
          "I have to start work at eight.",
          "We had to wait outside."
        ]
      },
      "variations": [
        "Past necessity is normally expressed with had to, not must."
      ],
