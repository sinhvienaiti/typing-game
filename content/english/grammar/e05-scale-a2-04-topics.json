    {
      "schemaVersion": 1,
      "id": "gr.a2.may-might-possibility",
      "cefr": "A2",
      "title": "May/might: possibility",
      "objective": "Express uncertain present or future possibilities.",
      "concept": {
        "en": "Use may or might + base verb to say something is possible but not certain.",
        "vi": "Dùng may hoặc might + động từ nguyên mẫu để nói điều gì đó có thể xảy ra nhưng không chắc chắn."
      },
      "formulae": [
        "Subject + may/might + base verb.",
        "Subject + may/might not + base verb."
      ],
      "whenToUse": [
        "Express uncertain present or future possibility."
      ],
      "forms": {
        "positive": [
          "It may rain later.",
          "Sara might be at home.",
          "We might not finish today."
        ]
      },
      "variations": [
        "At A2, may and might can usually be treated as similar markers of possibility."
      ],
