    {
      "schemaVersion": 1,
      "id": "gr.a2.mustnt-vs-dont-have-to",
      "cefr": "A2",
      "title": "Mustn't vs don't have to",
      "objective": "Distinguish prohibition from lack of necessity.",
      "concept": {
        "en": "Use mustn't for prohibition and don't/doesn't have to for lack of necessity.",
        "vi": "Dùng mustn't cho điều bị cấm và don't/doesn't have to cho điều không bắt buộc."
      },
      "formulae": [
        "mustn't + base verb = prohibited",
        "don't/doesn't have to + base verb = not necessary"
      ],
      "whenToUse": [
        "Distinguish something forbidden from something optional."
      ],
      "forms": {
        "positive": [
          "You mustn't touch that wire.",
          "You don't have to come early.",
          "Students mustn't use phones during the test."
        ]
      },
      "variations": [
        "The two negative-looking forms have very different meanings."
      ],
