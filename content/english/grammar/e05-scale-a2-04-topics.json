    {
      "schemaVersion": 1,
      "id": "gr.a2.polite-requests-permission",
      "cefr": "A2",
      "title": "Could/may: polite requests and permission",
      "objective": "Make more polite requests and ask/give permission.",
      "concept": {
        "en": "Use could/can for polite requests and may/can for asking permission, with could and may often sounding more formal.",
        "vi": "Dùng could/can cho lời nhờ lịch sự và may/can để xin phép; could và may thường trang trọng hơn."
      },
      "formulae": [
        "Could/Can you + base verb, please?",
        "May/Can I + base verb?"
      ],
      "whenToUse": [
        "Ask someone to do something or ask permission politely."
      ],
      "forms": {
        "positive": [
          "Could you open the window, please?",
          "May I use your phone?",
          "Can I sit here?"
        ]
      },
      "variations": [
        "Please can be added to requests; may is common for more formal permission."
      ],
