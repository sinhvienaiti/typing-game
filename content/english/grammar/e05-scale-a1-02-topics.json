    {
      "schemaVersion": 1,
      "id": "gr.a1.some-any-basic",
      "cefr": "A1",
      "title": "Some and any: basics",
      "objective": "Use some and any in simple affirmative, negative and question contexts.",
      "concept": {
        "en": "Use some mainly in affirmative statements and any mainly in negatives and questions when talking about an unspecified quantity or number.",
        "vi": "Dùng some chủ yếu trong câu khẳng định và any chủ yếu trong câu phủ định hoặc câu hỏi khi nói về số lượng không xác định."
      },
      "formulae": [
        "affirmative: some + plural count/uncountable noun",
        "negative: not ... any + plural count/uncountable noun",
        "question: any + plural count/uncountable noun"
      ],
      "whenToUse": [
        "Talk about an unspecified amount or number.",
        "Ask whether an amount or number exists."
      ],
      "forms": {
        "positive": [
          "We have some eggs in the fridge."
        ],
        "negative": [
          "We don't have any milk."
        ],
        "question": [
          "Do you have any questions?"
        ]
      },
      "variations": [
        "Some is also common in offers and requests such as Would you like some water?, but the basic A1 contrast is affirmative some vs negative/question any."
      ],
      "relatedCollocationIds": [],
      "exampleIds": [
        "sent.gra1.02.04.1",
