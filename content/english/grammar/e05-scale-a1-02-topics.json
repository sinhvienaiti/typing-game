    {
      "schemaVersion": 1,
      "id": "gr.a1.article-the-basic",
      "cefr": "A1",
      "title": "The for basic specific reference",
      "objective": "Use the when speaker and listener can identify the referent.",
      "concept": {
        "en": "Use the before a noun when the speaker and listener can identify the specific person or thing.",
        "vi": "Dùng the trước danh từ khi cả người nói và người nghe đều xác định được người hoặc vật cụ thể đang được nhắc tới."
      },
      "formulae": [
        "the + singular count noun",
        "the + plural noun",
        "the + uncountable noun when the reference is specific"
      ],
      "whenToUse": [
        "Refer to something already mentioned.",
        "Refer to a person or thing that is clear from the situation."
      ],
      "forms": {
        "positive": [
          "I saw a dog. The dog was very friendly.",
          "Please close the window near the door.",
          "The water in this bottle is cold."
        ]
      },
      "variations": [
        "Do not use the just because a noun is singular; use it when the reference is specific and identifiable."
      ],
