    {
      "schemaVersion": 1,
      "id": "gr.a1.present-simple-facts-states",
      "cefr": "A1",
      "title": "Present Simple: facts and states",
      "objective": "Describe general truths, stable situations and common states.",
      "concept": {
        "en": "Use the Present Simple for facts, general truths and states that are normally true, not only for repeated routines.",
        "vi": "Dùng Hiện tại đơn cho sự thật, chân lý chung và trạng thái thường đúng, không chỉ cho thói quen lặp lại."
      },
      "formulae": [
        "Subject + base verb (+ s/es with he/she/it)."
      ],
      "whenToUse": [
        "State facts and general truths.",
        "Describe stable situations, preferences or knowledge."
      ],
      "forms": {
        "positive": [
          "Water boils at 100°C at sea level.",
          "My parents live in Hanoi.",
          "She likes quiet cafés."
        ]
      },
      "variations": [
        "State verbs such as know, like and want are commonly used in the Present Simple for basic state meanings."
      ],
