    {
      "schemaVersion": 1,
      "id": "gr.a1.possessive-s",
      "cefr": "A1",
      "title": "Possessive 's",
      "objective": "Show ownership and relationships with noun + ’s.",
      "concept": {
        "en": "Add 's to a singular noun or name to show ownership or a relationship.",
        "vi": "Thêm 's vào danh từ số ít hoặc tên riêng để thể hiện sự sở hữu hoặc mối quan hệ."
      },
      "formulae": [
        "singular noun/name + 's + possessed noun",
        "plural noun ending in -s + ' + possessed noun"
      ],
      "whenToUse": [
        "Show that something belongs to a person or animal.",
        "Express common relationships such as family or roles."
      ],
      "forms": {
        "positive": [
          "This is Anna's bag.",
          "My brother's room is upstairs.",
          "The students' books are on the table."
        ]
      },
      "variations": [
        "For a regular plural already ending in -s, add only an apostrophe: the students' books."
      ],
