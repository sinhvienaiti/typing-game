    {
      "schemaVersion": 1,
      "id": "gr.a1.present-simple-third-person",
      "cefr": "A1",
      "title": "Present Simple: third-person -s",
      "objective": "Form he/she/it verb forms accurately.",
      "concept": {
        "en": "In affirmative Present Simple clauses, add -s or -es to the main verb when the subject is he, she, it or a singular noun.",
        "vi": "Trong câu khẳng định ở Hiện tại đơn, thêm -s hoặc -es vào động từ chính khi chủ ngữ là he, she, it hoặc danh từ số ít."
      },
      "formulae": [
        "He/She/It + verb-s/es.",
        "consonant + y: y → ies in common verbs such as study → studies"
      ],
      "whenToUse": [
        "Make affirmative Present Simple verbs agree with a third-person singular subject."
      ],
      "forms": {
        "positive": [
          "He works near the station.",
          "Mina watches the news at night.",
          "My sister studies English every day."
        ]
      },
      "variations": [
        "After does or does not, use the base verb: Does he work? / He does not work."
      ],
