    {
      "schemaVersion": 1,
      "id": "gr.a1.have-possession",
      "cefr": "A1",
      "title": "Have/has for possession",
      "objective": "Express possession and basic relationships with have/has.",
      "concept": {
        "en": "Use have with I/you/we/they and has with he/she/it to say that someone owns, possesses or has a relationship with something or someone.",
        "vi": "Dùng have với I/you/we/they và has với he/she/it để diễn tả sự sở hữu, có một vật, hoặc có một mối quan hệ với ai đó."
      },
      "formulae": [
        "I/You/We/They + have + noun.",
        "He/She/It + has + noun."
      ],
      "whenToUse": [
        "Talk about possessions.",
        "Talk about family, features and other simple relationships."
      ],
      "forms": {
        "positive": [
          "I have a new phone.",
          "Maya has two brothers.",
          "Our apartment has a small balcony."
        ]
      },
      "variations": [
        "In standard Present Simple questions and negatives, use do/does: Do you have...? / She does not have...."
      ],
