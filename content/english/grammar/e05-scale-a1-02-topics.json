    {
      "schemaVersion": 1,
      "id": "gr.a1.noun-number",
      "cefr": "A1",
      "title": "Singular and plural nouns",
      "objective": "Form regular plurals and high-frequency irregular plurals.",
      "concept": {
        "en": "Use a singular noun for one countable item and a plural noun for more than one; many plurals take -s or -es, while some common nouns are irregular.",
        "vi": "Dùng danh từ số ít cho một vật đếm được và danh từ số nhiều cho nhiều hơn một; nhiều danh từ thêm -s hoặc -es, còn một số danh từ thông dụng có dạng bất quy tắc."
      },
      "formulae": [
        "one + singular count noun",
        "two/many + plural count noun",
        "most nouns: noun + s",
        "-s/-sh/-ch/-x endings: noun + es"
      ],
      "whenToUse": [
        "Match the noun form to the number of countable people or things.",
        "Use common irregular plurals such as children, men and women when needed."
      ],
      "forms": {
        "positive": [
          "There is one book on the desk.",
          "There are three buses outside.",
          "Two children are playing in the park."
        ]
      },
      "variations": [
        "Spelling can change in some plurals, so learners should store high-frequency irregular forms as vocabulary."
      ],
