    {
      "schemaVersion": 1,
      "id": "gr.a1.countability-basic",
      "cefr": "A1",
      "title": "Countable and uncountable nouns: basics",
      "objective": "Distinguish common count and mass nouns in simple contexts.",
      "concept": {
        "en": "Countable nouns can be counted as separate items and have singular/plural forms; uncountable nouns are normally treated as a mass and do not use a/an or a regular plural in their basic meaning.",
        "vi": "Danh từ đếm được có thể đếm thành từng đơn vị và có dạng số ít/số nhiều; danh từ không đếm được thường được xem như một khối và không dùng a/an hay dạng số nhiều thông thường trong nghĩa cơ bản."
      },
      "formulae": [
        "countable: a/an + singular noun; number + plural noun",
        "uncountable: some + noun; much + noun"
      ],
      "whenToUse": [
        "Choose articles and quantity words that match whether a noun is countable.",
        "Treat common mass nouns such as water, rice and information as uncountable in basic use."
      ],
      "forms": {
        "positive": [
          "I need an apple and some water.",
          "We bought two chairs for the room.",
          "She gave me some useful information."
        ]
      },
      "variations": [
        "Some nouns can be countable or uncountable with different meanings; this A1 topic focuses on their most common basic use."
      ],
