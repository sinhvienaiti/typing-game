      "schemaVersion": 1,
      "id": "gr.b1.reason-result-linkers",
      "cefr": "B1",
      "title": "Because of, therefore and as a result",
      "objective": "Connect causes and consequences across sentence structures.",
      "concept": {
        "en": "Use because/since/as to introduce reasons and so/therefore/as a result to express results, with different punctuation and clause patterns.",
        "vi": "Dùng because/since/as để giới thiệu lý do và so/therefore/as a result để diễn tả kết quả, với cách nối câu và dấu câu khác nhau."
      },
      "formulae": [
        "because/since/as + reason clause",
        "result clause with so / therefore / as a result"
      ],
      "whenToUse": [
        "Link causes and consequences clearly."
      ],
      "forms": {
        "positive": [
          "We stayed home because it was raining.",
          "It was raining, so we stayed home.",
          "The road was closed; therefore, we took another route."
        ]
      },
