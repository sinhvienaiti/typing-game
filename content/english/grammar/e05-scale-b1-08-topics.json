    {
      "schemaVersion": 1,
      "id": "gr.b1.narrative-linkers",
      "cefr": "B1",
      "title": "Narrative sequencing and discourse markers",
      "objective": "Organize spoken/written stories with before, after, then, eventually and meanwhile.",
      "concept": {
        "en": "Use linkers such as first, then, after that, meanwhile, eventually and in the end to organize events and show sequence in a narrative.",
        "vi": "Dùng các từ nối như first, then, after that, meanwhile, eventually và in the end để tổ chức sự kiện và thể hiện trình tự trong câu chuyện."
      },
      "formulae": [
        "sequence linker + clause/sentence",
        "meanwhile + simultaneous event"
      ],
      "whenToUse": [
        "Make a story easier to follow by signaling order and simultaneous events."
      ],
      "forms": {
        "positive": [
          "First, we checked the map; then we started walking.",
          "Meanwhile, the others were preparing dinner.",
          "Eventually, we found the right path."
        ]
      },
