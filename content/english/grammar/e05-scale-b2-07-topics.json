    {
      "schemaVersion": 1,
      "id": "gr.b2.concession-discourse",
      "cefr": "B2",
      "title": "Whereas, while, nevertheless and despite",
      "objective": "Express contrast/concession with appropriate syntax and register.",
      "concept": {
        "en": "Concession and contrast can be expressed with conjunctions, prepositions and discourse adverbs, but each requires a different syntactic frame.",
        "vi": "Quan hệ nhượng bộ và tương phản có thể được diễn đạt bằng liên từ, giới từ và trạng từ diễn ngôn, nhưng mỗi loại cần một khung cú pháp khác nhau."
      },
      "formulae": [
        "although/while + clause",
        "despite/in spite of + noun/-ing",
        "clause; nevertheless, clause",
        "whereas + clause"
      ],
      "whenToUse": [
        "Choose a connector that matches both the intended contrast and the grammatical form that follows it."
      ],
      "forms": {
        "positive": [
          "Although the plan is expensive, it could save money in the long term.",
          "Despite the initial resistance, the new system was adopted successfully.",
          "The northern region grew rapidly, whereas demand in the south remained stable."
        ]
      },
