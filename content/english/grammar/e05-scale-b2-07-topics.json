      "id": "gr.b2.spoken-ellipsis-tags",
      "cefr": "B2",
      "title": "Spoken ellipsis, response forms and conversational tags",
      "objective": "Use natural omissions and short follow-up structures in conversation.",
      "concept": {
        "en": "Informal conversation often omits recoverable subjects or auxiliaries and uses short response forms and tags to maintain interaction.",
        "vi": "Hội thoại thân mật thường lược chủ ngữ hoặc trợ động từ có thể suy ra và dùng câu đáp ngắn hay question tag để duy trì tương tác."
      },
      "formulae": [
        "(Are you) coming ...?",
        "(Do you) need ...?",
        "statement + auxiliary tag"
      ],
      "whenToUse": [
        "Recognize and produce natural spoken reductions while keeping the intended tense, polarity and tag auxiliary clear."
      ],
      "forms": {
        "positive": [
          "Coming with us after work?",
          "Sounds good, doesn't it?",
          "Need any help with those boxes?"
