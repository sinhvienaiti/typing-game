    {
      "schemaVersion": 1,
      "id": "gr.b2.purpose-result-clauses",
      "cefr": "B2",
      "title": "In order to, so as to and so that",
      "objective": "Express purpose while controlling subject and clause structure.",
      "concept": {
        "en": "Purpose can be expressed with infinitive phrases when the understood subject is controlled, or with so that + clause when an explicit subject or modal is needed.",
        "vi": "Mục đích có thể được diễn đạt bằng cụm infinitive khi chủ ngữ ngầm được kiểm soát, hoặc bằng so that + mệnh đề khi cần chủ ngữ hay modal rõ ràng."
      },
      "formulae": [
        "in order to/so as to + base verb",
        "so that + subject + modal/verb"
      ],
      "whenToUse": [
        "Choose a purpose structure according to whether the purpose shares the main-clause subject and whether an explicit result subject is needed."
      ],
      "forms": {
        "positive": [
          "We changed the schedule in order to give the team more time.",
          "She spoke quietly so that the children wouldn't wake up.",
          "The instructions were simplified so as to reduce confusion."
        ]
      },
