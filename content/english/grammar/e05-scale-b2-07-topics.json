    {
      "schemaVersion": 1,
      "id": "gr.b2.discourse-reference",
      "cefr": "B2",
      "title": "This/that/such as discourse reference",
      "objective": "Refer back to propositions and situations coherently.",
      "concept": {
        "en": "This, that and such can refer back not only to nouns but also to whole propositions, events or situations in the preceding discourse.",
        "vi": "This, that và such có thể quy chiếu không chỉ về danh từ mà còn về cả mệnh đề, sự kiện hoặc tình huống đã nêu trước đó."
      },
      "formulae": [
        "statement. This/That + verb ...",
        "such + noun phrase"
      ],
      "whenToUse": [
        "Create coherent links across sentences by packaging an earlier proposition or situation as a new discourse referent."
      ],
      "forms": {
        "positive": [
          "The supplier missed two deadlines. This has delayed the entire project.",
          "The committee rejected the proposal, and that surprised several observers.",
          "The system requires daily manual checks. Such a process is difficult to scale."
        ]
      },
