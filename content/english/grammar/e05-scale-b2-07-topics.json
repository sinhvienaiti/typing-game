    {
      "schemaVersion": 1,
      "id": "gr.b2.formal-informal-requests",
      "cefr": "B2",
      "title": "Formal vs informal requests and hedging",
      "objective": "Adjust modal, question and softening choices to social context.",
      "concept": {
        "en": "Request forms vary in directness and social distance; modals, past forms and hedging can soften a request without changing its practical goal.",
        "vi": "Cách yêu cầu thay đổi theo mức độ trực tiếp và khoảng cách xã hội; modal, dạng quá khứ và từ giảm nhẹ giúp làm mềm yêu cầu mà không đổi mục đích thực tế."
      },
      "formulae": [
        "Can you ...?",
        "Could you possibly ...?",
        "I was wondering if you could ..."
      ],
      "whenToUse": [
        "Adjust request wording to the relationship, medium and degree of imposition, especially in professional communication."
      ],
      "forms": {
        "positive": [
          "Could you possibly send me the revised figures by noon?",
          "I was wondering if you could clarify the final requirement.",
          "Can you send me the link?"
        ]
