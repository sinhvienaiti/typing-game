    {
      "schemaVersion": 1,
      "id": "gr.b2.lexical-collocation-core",
      "cefr": "B2",
      "title": "High-value make/do/take/have collocations",
      "objective": "Choose natural light-verb collocations rather than literal alternatives.",
      "concept": {
        "en": "Light verbs such as make, do, take and have combine with particular nouns in conventional collocations that are not reliably predictable from literal meaning.",
        "vi": "Các động từ nhẹ như make, do, take và have kết hợp với những danh từ nhất định theo collocation quy ước, không thể luôn đoán đúng từ nghĩa đen."
      },
      "formulae": [
        "make a decision",
        "take responsibility",
        "have an impact",
        "do research"
      ],
      "whenToUse": [
        "Choose the conventional light verb that native usage strongly associates with the noun."
      ],
      "forms": {
        "positive": [
          "The board made a decision after reviewing the evidence.",
          "We need to take responsibility for the delay.",
          "The new process has had a significant impact on response times."
        ]
      },
