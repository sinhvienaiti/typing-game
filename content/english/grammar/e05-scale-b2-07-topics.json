    {
      "schemaVersion": 1,
      "id": "gr.b2.cause-effect-formal",
      "cefr": "B2",
      "title": "Due to, owing to, consequently and as a result",
      "objective": "Express cause/effect in neutral and formal registers.",
      "concept": {
        "en": "Formal cause-and-effect language distinguishes prepositional cause markers such as due to/owing to from clause-linking result markers such as consequently and as a result.",
        "vi": "Ngôn ngữ nguyên nhân-kết quả trang trọng phân biệt cụm giới từ chỉ nguyên nhân như due to/owing to với từ nối kết quả như consequently và as a result."
      },
      "formulae": [
        "due to/owing to + noun phrase",
        "clause; consequently, clause",
        "clause. As a result, clause"
      ],
      "whenToUse": [
        "Express causal relationships with syntax and register appropriate to reports, explanations and formal argument."
      ],
      "forms": {
        "positive": [
          "The flight was cancelled owing to severe weather.",
          "The server failed unexpectedly; consequently, several services were unavailable.",
          "Production costs rose, and as a result the company increased its prices."
        ]
      },
