    {
      "schemaVersion": 1,
      "id": "gr.b2.substitution-ellipsis",
      "cefr": "B2",
      "title": "Substitution and ellipsis with do/so/neither/nor",
      "objective": "Avoid repetition while preserving grammatical meaning.",
      "concept": {
        "en": "Substitution and ellipsis use forms such as do, so, neither and nor to avoid repeating material that is recoverable from context.",
        "vi": "Phép thế và lược bỏ dùng các dạng như do, so, neither và nor để tránh lặp lại phần nội dung có thể suy ra từ ngữ cảnh."
      },
      "formulae": [
        "subject + auxiliary/do + too",
        "think/hope/say + so",
        "neither/nor + auxiliary + subject"
      ],
      "whenToUse": [
        "Avoid unnecessary repetition while preserving tense, polarity and agreement through the appropriate substitute or auxiliary."
      ],
      "forms": {
        "positive": [
          "I prefer the earlier design, and the client does too.",
          "She said the deadline was flexible, but I don't think so.",
          "We haven't received the data, and neither has the research team."
        ]
      },
