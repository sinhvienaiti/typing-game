    {
      "schemaVersion": 1,
      "id": "gr.b2.modal-perfect-possibility",
      "cefr": "B2",
      "title": "Could have/might have",
      "objective": "Express unrealized options and uncertain past possibilities.",
      "concept": {
        "en": "Use may/might/could have + past participle for uncertain possibilities about what happened in the past.",
        "vi": "Dùng may/might/could have + quá khứ phân từ để nói về những khả năng không chắc chắn đã xảy ra trong quá khứ."
      },
      "formulae": [
        "may/might/could have + past participle"
      ],
      "whenToUse": [
        "Suggest possible explanations for a past event without claiming certainty."
      ],
      "forms": {
        "positive": [
          "She might have missed the bus.",
          "The email could have gone to spam.",
          "They may have taken a different road."
        ]
