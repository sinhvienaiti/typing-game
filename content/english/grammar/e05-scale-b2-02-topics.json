    {
      "schemaVersion": 1,
      "id": "gr.b2.deduction-past",
      "cefr": "B2",
      "title": "Must have/might have/can't have",
      "objective": "Make deductions about past events with graded certainty.",
      "concept": {
        "en": "Use must have + past participle for a strong positive deduction about the past and can't/couldn't have + past participle for a strong negative deduction.",
        "vi": "Dùng must have + quá khứ phân từ cho suy đoán khẳng định rất chắc về quá khứ và can't/couldn't have + quá khứ phân từ cho suy đoán phủ định rất chắc."
      },
      "formulae": [
        "must have + past participle",
        "can't/couldn't have + past participle"
      ],
      "whenToUse": [
        "Infer what probably did or did not happen from evidence available now."
      ],
      "forms": {
        "positive": [
          "She must have forgotten the meeting.",
          "They can't have left already; their car is still here.",
          "He must have been exhausted after the race."
        ]
      },
      "variations": [],
