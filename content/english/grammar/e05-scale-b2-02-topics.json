    {
      "schemaVersion": 1,
      "id": "gr.b2.wish-would-annoyance",
      "cefr": "B2",
      "title": "Wish/if only + would",
      "objective": "Express desired change or annoyance about controllable behavior.",
      "concept": {
        "en": "Use wish + would to complain about repeated behavior or a situation you want someone or something to change.",
        "vi": "Dùng wish + would để phàn nàn về hành vi lặp lại hoặc tình huống mà bạn muốn người/vật thay đổi."
      },
      "formulae": [
        "wish + subject + would + base verb"
      ],
      "whenToUse": [
        "Express irritation or desire for a future change, especially when the subject is not normally the speaker."
      ],
      "forms": {
        "positive": [
          "I wish the neighbors would turn the music down.",
          "She wishes her phone would stop ringing.",
          "I wish you wouldn't interrupt me."
        ]
      },
