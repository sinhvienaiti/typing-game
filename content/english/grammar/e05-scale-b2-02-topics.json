    {
      "schemaVersion": 1,
      "id": "gr.b2.unreal-past-time-as-if",
      "cefr": "B2",
      "title": "Unreal past after It's time / as if / as though",
      "objective": "Use past forms for remoteness, criticism or unreal comparison.",
      "concept": {
        "en": "Use a past form after as if/as though to show that a present appearance or comparison is unreal or unlikely.",
        "vi": "Dùng dạng quá khứ sau as if/as though để cho thấy một vẻ ngoài hoặc phép so sánh ở hiện tại là không thật hoặc khó xảy ra."
      },
      "formulae": [
        "present verb + as if/as though + Past Simple",
        "as if/as though + were for formal unreal comparison"
      ],
      "whenToUse": [
        "Describe an unreal present impression rather than a factual comparison."
      ],
      "forms": {
        "positive": [
          "He talks as if he knew everything.",
          "She spends money as though she were rich.",
          "You look as if you hadn't slept."
        ]
      },
