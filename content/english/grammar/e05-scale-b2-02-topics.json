    {
      "schemaVersion": 1,
      "id": "gr.b2.wish-past-regret",
      "cefr": "B2",
      "title": "Wish/if only + past perfect",
      "objective": "Express regret about past events.",
      "concept": {
        "en": "Use wish + Past Perfect to express regret that a past event happened differently from what you wanted.",
        "vi": "Dùng wish + Past Perfect để diễn tả tiếc nuối vì một sự kiện quá khứ đã xảy ra khác điều mong muốn."
      },
      "formulae": [
        "wish + subject + had + past participle"
      ],
      "whenToUse": [
        "Imagine a different past and express regret about something that can no longer be changed."
      ],
      "forms": {
        "positive": [
          "I wish I'd studied harder.",
          "She wishes she hadn't said that.",
          "We wish we'd booked earlier."
        ]
      },
      "variations": [],
