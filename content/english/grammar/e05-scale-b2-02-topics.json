    {
      "schemaVersion": 1,
      "id": "gr.b2.would-rather",
      "cefr": "B2",
      "title": "Would rather / would sooner",
      "objective": "Express preferences about one's own or another person's actions.",
      "concept": {
        "en": "Use would rather + bare infinitive for your preference and would rather + subject + Past Simple for what you prefer another person to do.",
        "vi": "Dùng would rather + động từ nguyên mẫu không to cho sở thích của chính mình và would rather + chủ ngữ + Past Simple cho điều bạn muốn người khác làm."
      },
      "formulae": [
        "would rather + base verb",
        "would rather + subject + Past Simple"
      ],
      "whenToUse": [
        "Express preferences about present or future choices."
      ],
      "forms": {
        "positive": [
          "I'd rather stay home tonight.",
          "I'd rather you came tomorrow.",
          "Would you rather eat now or later?"
        ]
      },
