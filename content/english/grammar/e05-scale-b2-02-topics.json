    {
      "schemaVersion": 1,
      "id": "gr.b2.mixed-conditional-present-past",
      "cefr": "B2",
      "title": "Mixed Conditional: present state → past result",
      "objective": "Connect an unreal present/general condition to a past consequence.",
      "concept": {
        "en": "Use a mixed conditional with an unreal present state and a past result when a different present characteristic would have changed a past event.",
        "vi": "Dùng câu điều kiện hỗn hợp với trạng thái hiện tại không có thật và kết quả quá khứ khi một đặc điểm hiện tại khác đi sẽ làm thay đổi một sự kiện trong quá khứ."
      },
      "formulae": [
        "If + Past Simple, would have + past participle."
      ],
      "whenToUse": [
        "Connect a continuing present condition or characteristic with an imagined past consequence."
      ],
      "forms": {
        "positive": [
          "If I were more organized, I wouldn't have missed the deadline.",
          "If he spoke Spanish, he could have taken that job.",
          "If we lived closer, we would have visited more often."
        ]
      },
      "variations": [],
