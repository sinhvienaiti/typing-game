    {
      "schemaVersion": 1,
      "id": "gr.b2.modal-perfect-criticism",
      "cefr": "B2",
      "title": "Should have/ought to have",
      "objective": "Express criticism, regret and unfulfilled expectation.",
      "concept": {
        "en": "Use should have or ought to have + past participle to criticize a past action or say what would have been better; shouldn't have marks an action that was a mistake.",
        "vi": "Dùng should have hoặc ought to have + quá khứ phân từ để phê bình hành động quá khứ hoặc nói điều lẽ ra tốt hơn; shouldn't have chỉ một hành động đã làm nhưng là sai lầm."
      },
      "formulae": [
        "should/ought to have + past participle",
        "shouldn't have + past participle"
      ],
      "whenToUse": [
        "Evaluate past behavior after the opportunity has passed."
      ],
      "forms": {
        "positive": [
          "You should have told me earlier.",
          "I shouldn't have stayed up so late.",
          "They ought to have checked the address."
        ]
      },
