    {
      "schemaVersion": 1,
      "id": "gr.a1.can-ability",
      "cefr": "A1",
      "title": "Can/can't: ability",
      "objective": "Talk about present ability and inability.",
      "concept": {
        "en": "Use can + base verb for present ability and can't/cannot + base verb for present inability.",
        "vi": "Dùng can + động từ nguyên mẫu để nói về khả năng hiện tại và can't/cannot + động từ nguyên mẫu để nói về việc không có khả năng."
      },
      "formulae": [
        "Subject + can + base verb.",
        "Subject + can't/cannot + base verb.",
        "Can + subject + base verb?"
      ],
      "whenToUse": [
        "Say what someone is able or unable to do now.",
        "Ask about a person's present ability."
      ],
      "forms": {
        "positive": [
          "I can swim across the pool."
        ],
        "negative": [
          "My little brother can't ride a bike yet."
        ],
        "question": [
          "Can you use this camera?"
        ]
      },
      "variations": [
        "Can does not change with he/she/it, and the following verb stays in the base form."
      ],
      "relatedCollocationIds": [],
      "exampleIds": [
        "sent.gra1.03.05.1",
