    {
      "schemaVersion": 1,
      "id": "gr.a1.imperatives",
      "cefr": "A1",
      "title": "Imperatives and instructions",
      "objective": "Give simple commands, directions and instructions.",
      "concept": {
        "en": "Use the base verb without an expressed subject for a simple command or instruction; use don't + base verb for a negative imperative.",
        "vi": "Dùng động từ dạng cơ bản mà không cần nêu chủ ngữ để đưa ra mệnh lệnh hoặc hướng dẫn đơn giản; dùng don't + động từ cơ bản cho câu mệnh lệnh phủ định."
      },
      "formulae": [
        "Base verb + ...",
        "Please + base verb + ...",
        "Don't + base verb + ..."
      ],
      "whenToUse": [
        "Give simple directions or instructions.",
        "Ask someone to do or not do something directly."
      ],
      "forms": {
        "positive": [
          "Please close the door quietly.",
          "Turn left at the next corner."
        ],
        "negative": [
          "Don't touch that hot pan."
        ]
      },
      "variations": [
        "Please can soften a direct instruction; the grammatical verb form remains the base form."
      ],
      "relatedCollocationIds": [],
      "exampleIds": [
