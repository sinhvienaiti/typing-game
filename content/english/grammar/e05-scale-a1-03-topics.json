    {
      "schemaVersion": 1,
      "id": "gr.a1.object-pronouns",
      "cefr": "A1",
      "title": "Object pronouns",
      "objective": "Use me/you/him/her/it/us/them after verbs and prepositions.",
      "concept": {
        "en": "Use object pronouns such as me, him, her, us and them when the pronoun receives the action or follows a preposition.",
        "vi": "Dùng đại từ tân ngữ như me, him, her, us và them khi đại từ nhận tác động của hành động hoặc đứng sau giới từ."
      },
      "formulae": [
        "verb + me/you/him/her/it/us/them",
        "preposition + me/you/him/her/it/us/them"
      ],
      "whenToUse": [
        "Replace a known person or thing after a verb.",
        "Use the correct pronoun after a preposition."
      ],
      "forms": {
        "positive": [
          "Please call me after work.",
          "I see her at the gym every morning.",
          "The teacher gives us homework every Friday."
        ]
      },
      "variations": [
        "You and it have the same subject and object forms; the other common personal pronouns change form."
