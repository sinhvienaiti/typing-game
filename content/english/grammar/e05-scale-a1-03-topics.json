    {
      "schemaVersion": 1,
      "id": "gr.a1.present-simple-questions",
      "cefr": "A1",
      "title": "Present Simple: yes/no questions",
      "objective": "Form Do/Does questions and short answers.",
      "concept": {
        "en": "Use do before I/you/we/they and does before he/she/it to make Present Simple yes/no questions; use the base form of the main verb.",
        "vi": "Dùng do trước I/you/we/they và does trước he/she/it để tạo câu hỏi yes/no ở Hiện tại đơn; động từ chính dùng dạng cơ bản."
      },
      "formulae": [
        "Do + I/you/we/they + base verb?",
        "Does + he/she/it + base verb?",
        "Yes, subject + do/does. / No, subject + don't/doesn't."
      ],
      "whenToUse": [
        "Ask whether a routine, fact, preference or state is true.",
        "Give a short yes/no answer without repeating the full clause."
      ],
      "forms": {
        "question": [
          "Do you walk to work every day?",
          "Does Leo play tennis after school?",
          "Do they need a ticket for this bus?"
        ]
      },
      "variations": [
        "After does, use the base verb: Does she live here?, not Does she lives here?"
      ],
      "relatedCollocationIds": [],
      "exampleIds": [
        "sent.gra1.03.02.1",
        "sent.gra1.03.02.2",
