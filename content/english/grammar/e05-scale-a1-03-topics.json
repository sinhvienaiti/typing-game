    {
      "schemaVersion": 1,
      "id": "gr.a1.wh-questions-present",
      "cefr": "A1",
      "title": "Present Simple: wh- questions",
      "objective": "Ask for basic information with who/what/where/when/why/how.",
      "concept": {
        "en": "Put a wh-word before a Present Simple question to ask for specific information such as place, time, reason or manner.",
        "vi": "Đặt từ để hỏi trước câu hỏi ở Hiện tại đơn để hỏi thông tin cụ thể như nơi chốn, thời gian, lý do hoặc cách thức."
      },
      "formulae": [
        "Wh-word + do + I/you/we/they + base verb?",
        "Wh-word + does + he/she/it + base verb?"
      ],
      "whenToUse": [
        "Ask for a missing piece of basic information.",
        "Ask about routines, facts and regular activities."
      ],
      "forms": {
        "question": [
          "Where do you buy your groceries?",
          "What does Maya do after class?",
          "When do the shops close?"
        ]
      },
      "variations": [
        "When who or what is the subject, do/does may not appear; that subject-question pattern is treated separately from this basic object/adverbial pattern."
      ],
      "relatedCollocationIds": [],
      "exampleIds": [
