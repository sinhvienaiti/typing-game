    {
      "schemaVersion": 1,
      "id": "gr.a1.present-simple-negative",
      "cefr": "A1",
      "title": "Present Simple: negatives",
      "objective": "Use don't/doesn't + base verb.",
      "concept": {
        "en": "Use don't with I/you/we/they and doesn't with he/she/it to make negative Present Simple statements; keep the main verb in the base form.",
        "vi": "Dùng don't với I/you/we/they và doesn't với he/she/it để tạo câu phủ định ở Hiện tại đơn; động từ chính giữ nguyên dạng cơ bản."
      },
      "formulae": [
        "I/You/We/They + don't + base verb.",
        "He/She/It + doesn't + base verb."
      ],
      "whenToUse": [
        "Say that a routine, fact, preference or state is not true.",
        "Contrast a negative Present Simple statement with an affirmative one."
      ],
      "forms": {
        "negative": [
          "I don't drink coffee after dinner.",
          "Mina doesn't work on Saturdays.",
          "They don't live near the station."
        ]
      },
      "variations": [
        "Do not add third-person -s after doesn't: she doesn't work, not she doesn't works."
      ],
      "relatedCollocationIds": [],
      "exampleIds": [
        "sent.gra1.03.01.1",
        "sent.gra1.03.01.2",
        "sent.gra1.03.01.3"
