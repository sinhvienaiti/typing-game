    {
      "schemaVersion": 1,
      "id": "gr.a1.can-permission-requests",
      "cefr": "A1",
      "title": "Can: permission and simple requests",
      "objective": "Ask for permission and make simple requests with can.",
      "concept": {
        "en": "Use Can I...? to ask for permission and Can you...? to make a simple request; can can also give basic permission.",
        "vi": "Dùng Can I...? để xin phép và Can you...? để đưa ra yêu cầu đơn giản; can cũng có thể dùng để cho phép ở mức cơ bản."
      },
      "formulae": [
        "Can I + base verb ...?",
        "Can you + base verb ...?",
        "You can + base verb ..."
      ],
      "whenToUse": [
        "Ask whether you may do something.",
        "Ask another person to do something simple.",
        "Give basic permission."
      ],
      "forms": {
        "question": [
          "Can I open the window?",
          "Can you help me with this bag, please?"
        ],
        "positive": [
          "You can use my phone if you need it."
        ]
      },
      "variations": [
        "Please can make a request sound friendlier, but can is still less formal than could or may."
      ],
      "relatedCollocationIds": [],
      "exampleIds": [
        "sent.gra1.03.06.1",
