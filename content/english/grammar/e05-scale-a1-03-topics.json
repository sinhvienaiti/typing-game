    {
      "schemaVersion": 1,
      "id": "gr.a1.frequency-adverbs",
      "cefr": "A1",
      "title": "Adverbs of frequency",
      "objective": "Place always/usually/often/sometimes/never naturally.",
      "concept": {
        "en": "Frequency adverbs such as always, usually, often, sometimes and never normally go before a main verb but after the verb be.",
        "vi": "Trạng từ tần suất như always, usually, often, sometimes và never thường đứng trước động từ thường nhưng đứng sau động từ be."
      },
      "formulae": [
        "Subject + frequency adverb + main verb.",
        "Subject + be + frequency adverb + complement."
      ],
      "whenToUse": [
        "Say how often a routine or repeated action happens.",
        "Describe how often a state with be is true."
      ],
      "forms": {
        "positive": [
          "I usually eat breakfast at home.",
          "She is often busy on Monday mornings.",
          "We never watch TV during dinner."
        ]
      },
      "variations": [
        "Sometimes can also appear at the beginning or end of a clause, but the mid-position pattern is the core A1 rule."
      ],
      "relatedCollocationIds": [],
      "exampleIds": [
