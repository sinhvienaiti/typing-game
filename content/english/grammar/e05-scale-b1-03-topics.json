    {
      "schemaVersion": 1,
      "id": "gr.b1.deduction-present",
      "cefr": "B1",
      "title": "Must/might/can't: present deduction",
      "objective": "Infer present situations with different confidence levels.",
      "concept": {
        "en": "Use must for a strong positive deduction and can't for a strong negative deduction about the present.",
        "vi": "Dùng must cho suy đoán khẳng định rất chắc và can't cho suy đoán phủ định rất chắc về hiện tại."
      },
      "formulae": [
        "must + base verb/be",
        "can't + base verb/be"
      ],
      "whenToUse": [
        "Make logical conclusions from present evidence."
      ],
      "forms": {
        "positive": [
          "The lights are on, so Maya must be home.",
          "That can't be Ben; he's abroad.",
          "You worked all night, so you must be tired."
        ]
      },
