    {
      "schemaVersion": 1,
      "id": "gr.b1.possibility-modals",
      "cefr": "B1",
      "title": "May/might/could: degrees and contexts of possibility",
      "objective": "Express uncertain possibilities with natural modal choices.",
      "concept": {
        "en": "Use may, might and could to express present or future possibility with uncertainty.",
        "vi": "Dùng may, might và could để diễn tả khả năng ở hiện tại hoặc tương lai nhưng không chắc chắn."
      },
      "formulae": [
        "may/might/could + base verb",
        "may/might not + base verb"
      ],
      "whenToUse": [
        "Show that something is possible rather than certain."
      ],
      "forms": {
        "positive": [
          "We might go out later.",
          "The answer could be correct.",
          "Mina may not come tonight."
        ]
      },
