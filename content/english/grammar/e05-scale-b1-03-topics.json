    {
      "schemaVersion": 1,
      "id": "gr.b1.obligation-need",
      "cefr": "B1",
      "title": "Have to, must and need to",
      "objective": "Distinguish sources and strengths of obligation/necessity.",
      "concept": {
        "en": "Use must, have to and need to for necessity, and don't need to or don't have to when something is not necessary.",
        "vi": "Dùng must, have to và need to cho sự cần thiết; dùng don't need to hoặc don't have to khi điều gì đó không cần thiết."
      },
      "formulae": [
        "must/have to/need to + base verb",
        "don't need to/don't have to + base verb"
      ],
      "whenToUse": [
        "Express different everyday kinds of obligation and lack of necessity."
      ],
      "forms": {
        "positive": [
          "You need to bring your passport.",
          "We have to leave by six.",
          "You don't need to print the form."
        ]
      },
