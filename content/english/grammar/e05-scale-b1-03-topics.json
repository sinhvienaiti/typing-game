      "id": "gr.b1.gerund-infinitive-similar",
      "cefr": "B1",
      "title": "Gerund vs infinitive after verbs with little meaning change",
      "objective": "Use common verbs that accept both patterns naturally.",
      "concept": {
        "en": "Some verbs such as like, love, hate, start and begin can take either an -ing form or a to-infinitive with little change in basic meaning.",
        "vi": "Một số động từ như like, love, hate, start và begin có thể đi với V-ing hoặc to-infinitive mà nghĩa cơ bản thay đổi rất ít."
      },
      "formulae": [
        "verb + verb-ing",
        "verb + to + base verb"
      ],
      "whenToUse": [
        "Recognize common verbs that accept both complement patterns."
      ],
      "forms": {
        "positive": [
          "I like reading before bed.",
          "I like to read before bed.",
          "It started raining after lunch."
        ]
