    {
      "schemaVersion": 1,
      "id": "gr.b1.advice-strength",
      "cefr": "B1",
      "title": "Should, ought to and had better",
      "objective": "Adjust the strength and consequence implied by advice.",
      "concept": {
        "en": "Use should or ought to for normal advice and had better for stronger advice with a possible negative consequence.",
        "vi": "Dùng should hoặc ought to cho lời khuyên thông thường và had better cho lời khuyên mạnh hơn khi có thể có hậu quả xấu."
      },
      "formulae": [
        "should/ought to + base verb",
        "had better + base verb"
      ],
      "whenToUse": [
        "Choose the strength of advice according to the situation."
      ],
      "forms": {
        "positive": [
          "You should get more sleep.",
          "You ought to talk to your manager.",
          "You'd better take an umbrella; the sky is very dark."
        ]
