    {
      "schemaVersion": 1,
      "id": "gr.b1.remember-forget-gerund-infinitive",
      "cefr": "B1",
      "title": "Remember/forget + -ing vs to-infinitive",
      "objective": "Distinguish memory of past action from remembering a duty.",
      "concept": {
        "en": "Remember/forget + to-infinitive refers to remembering or forgetting a necessary action; remember/forget + -ing refers to a memory of an earlier event.",
        "vi": "Remember/forget + to-infinitive nói về việc nhớ hoặc quên làm một việc cần làm; remember/forget + V-ing nói về ký ức của một việc đã xảy ra."
      },
      "formulae": [
        "remember/forget to do = action still to perform",
        "remember/forget doing = memory of past event"
      ],
      "whenToUse": [
        "Distinguish a duty from a memory."
      ],
      "forms": {
        "positive": [
          "Remember to lock the door.",
          "I remember meeting her years ago.",
          "He forgot to send the email."
        ]
      },
