    {
      "schemaVersion": 1,
      "id": "gr.b1.permission-allowed",
      "cefr": "B1",
      "title": "Can/could/be allowed to",
      "objective": "Express permission across present, past and more formal contexts.",
      "concept": {
        "en": "Use can/could/may for permission and be allowed to when another tense or form is needed.",
        "vi": "Dùng can/could/may để nói hoặc xin phép và be allowed to khi cần một thì hoặc dạng khác."
      },
      "formulae": [
        "can/may + base verb",
        "be allowed to + base verb"
      ],
      "whenToUse": [
        "Talk about permission in present, past and future contexts."
      ],
      "forms": {
        "positive": [
          "You can use my laptop.",
          "We weren't allowed to enter the room.",
          "Will visitors be allowed to take photos?"
        ]
