    {
      "schemaVersion": 1,
      "id": "gr.b1.hope-vs-wish",
      "cefr": "B1",
      "title": "Hope vs wish",
      "objective": "Choose realistic desired outcomes vs counterfactual/regret meanings.",
      "concept": {
        "en": "Use hope for a real or possible situation and wish for an unreal, regretted or desired different situation.",
        "vi": "Dùng hope cho tình huống có thật hoặc có khả năng xảy ra và wish cho điều không thực, đáng tiếc hoặc mong muốn khác với thực tế."
      },
      "formulae": [
        "hope + present/future clause",
        "wish + Past Simple for unreal present"
      ],
      "whenToUse": [
        "Distinguish realistic hopes from wishes about unreal situations."
      ],
      "forms": {
        "positive": [
          "I hope the weather is good tomorrow.",
          "I wish I had more free time.",
          "We hope you can come to the party."
        ]
      },
      "variations": [],
