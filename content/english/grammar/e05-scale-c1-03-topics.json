    {
      "schemaVersion": 1,
      "id": "gr.c1.appositive-that-clauses",
      "cefr": "C1",
      "title": "Appositive that-clauses",
      "objective": "Use clauses after nouns such as fact, idea, claim and possibility.",
      "concept": {
        "en": "Appositive that-clauses specify the content of abstract nouns such as fact, claim, possibility, and assumption.",
        "vi": "Mệnh đề that đồng vị nêu nội dung của các danh từ trừu tượng như fact, claim, possibility và assumption."
      },
      "formulae": [
        "abstract noun + that + finite clause"
      ],
      "whenToUse": [
        "Use an appositive clause when the following clause states the content of the noun rather than modifying a participant."
      ],
      "forms": {
        "positive": [
          "The assumption that prices would stabilize by June proved unrealistic.",
          "We cannot ignore the possibility that the two failures share a common cause.",
          "The claim that the measure is cost-neutral depends on several disputed forecasts."
        ]
      },
      "variations": [],
