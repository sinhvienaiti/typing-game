    {
      "schemaVersion": 1,
      "id": "gr.c1.be-to-formal-future",
      "cefr": "C1",
      "title": "Be to for official plans and instructions",
      "objective": "Use be to for formal schedules, requirements and planned events.",
      "concept": {
        "en": "Be to expresses officially arranged events, formal instructions, and requirements in institutional registers.",
        "vi": "Be to diễn đạt sự kiện được sắp xếp chính thức, chỉ thị và yêu cầu trong văn phong thể chế."
      },
      "formulae": [
        "subject + be + to-infinitive"
      ],
      "whenToUse": [
        "Use be to where the future event is fixed by authority, schedule, or formal arrangement."
      ],
      "forms": {
        "positive": [
          "The minister is to address the assembly after the afternoon vote.",
          "All contractors are to submit revised insurance certificates by Friday.",
          "The two delegations are to meet in Geneva early next month."
        ]
