    {
      "schemaVersion": 1,
      "id": "gr.c1.noun-complement-clauses",
      "cefr": "C1",
      "title": "Noun complement patterns",
      "objective": "Choose that/of -ing/to-infinitive/preposition complements after abstract nouns.",
      "concept": {
        "en": "Abstract nouns license different complement patterns, including that-clauses, of -ing, to-infinitives, and prepositional complements.",
        "vi": "Danh từ trừu tượng chọn các mẫu bổ ngữ khác nhau như that-clause, of -ing, to-infinitive và cụm giới từ."
      },
      "formulae": [
        "noun + that-clause",
        "noun + of + -ing",
        "noun + to-infinitive"
      ],
      "whenToUse": [
        "Learn the complement pattern with the noun rather than translating a preposition mechanically."
      ],
      "forms": {
        "positive": [
          "There is little prospect of the dispute being resolved before winter.",
          "The decision to postpone the launch was taken after the security review.",
          "Their insistence that every exception be documented slowed the rollout."
        ]
      },
