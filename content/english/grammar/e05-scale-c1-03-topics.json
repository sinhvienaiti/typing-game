    {
      "schemaVersion": 1,
      "id": "gr.c1.future-periphrases",
      "cefr": "C1",
      "title": "Be due/about/bound/likely to",
      "objective": "Express imminence, schedule and probability with nuanced future periphrases.",
      "concept": {
        "en": "Periphrastic future expressions distinguish imminence, schedule, expectation, and strong probability.",
        "vi": "Các cấu trúc tương lai ngoại vi phân biệt tính sắp xảy ra, lịch định sẵn, kỳ vọng và xác suất cao."
      },
      "formulae": [
        "be about to + verb",
        "be due to + verb",
        "be likely/bound to + verb"
      ],
      "whenToUse": [
        "Choose the expression according to temporal imminence, scheduling, or strength of prediction."
      ],
      "forms": {
        "positive": [
          "The central bank is due to publish its quarterly forecast on Thursday.",
          "The negotiations are about to enter their most difficult phase.",
          "Without additional capacity, the service is bound to face longer queues."
        ]
