    {
      "schemaVersion": 1,
      "id": "gr.c1.future-perfect-continuous",
      "cefr": "C1",
      "title": "Future Perfect Continuous",
      "objective": "Emphasize duration of activity up to a future point.",
      "concept": {
        "en": "The Future Perfect Continuous measures the duration of an activity up to a specified future reference point.",
        "vi": "Future Perfect Continuous nhấn mạnh khoảng thời gian một hoạt động kéo dài cho đến một mốc tương lai."
      },
      "formulae": [
        "will have been + verb-ing"
      ],
      "whenToUse": [
        "Use it when duration up to a future point matters more than simple completion."
      ],
      "forms": {
        "positive": [
          "By next September, the research team will have been monitoring the wetland for a full decade.",
          "At midnight, engineers will have been testing the failover system for twelve hours.",
          "By the time the review ends, she will have been leading the unit for nearly five years."
        ]
      },
