    {
      "schemaVersion": 1,
      "id": "gr.c1.preposition-wh-clauses",
      "cefr": "C1",
      "title": "Prepositions + wh-clauses",
      "objective": "Use structures such as about what, on whether and by how naturally.",
      "concept": {
        "en": "A preposition can take an embedded wh-clause or whether-clause as its complement in formal and neutral English.",
        "vi": "Giới từ có thể nhận mệnh đề wh- hoặc whether làm bổ ngữ trong văn phong trung tính và trang trọng."
      },
      "formulae": [
        "preposition + what/where/how/whether + clause"
      ],
      "whenToUse": [
        "Use preposition + embedded question to package complex unknown information as a noun-like complement."
      ],
      "forms": {
        "positive": [
          "The investigation focused on whether the disclosure rules had been followed consistently.",
          "There is disagreement about what the revised standard actually requires.",
          "The outcome will depend on how the tribunal interprets the exemption."
        ]
      },
