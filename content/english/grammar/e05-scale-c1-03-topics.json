    {
      "schemaVersion": 1,
      "id": "gr.c1.modal-perfect-continuous",
      "cefr": "C1",
      "title": "Modal perfect continuous",
      "objective": "Reason about past ongoing activity with must/might/could have been + -ing.",
      "concept": {
        "en": "Modal perfect continuous forms allow deduction or speculation about an activity that was ongoing in the past.",
        "vi": "Modal perfect continuous cho phép suy luận hoặc phỏng đoán về một hoạt động đã đang diễn ra trong quá khứ."
      },
      "formulae": [
        "must/might/could/can't + have been + verb-ing"
      ],
      "whenToUse": [
        "Use the form when both past time and ongoing duration/activity are relevant to the inference."
      ],
      "forms": {
        "positive": [
          "The server must have been processing a large backup when the response time suddenly increased.",
          "They may have been negotiating privately before the public talks began.",
          "The sensor could have been transmitting faulty readings for several hours."
        ]
      },
