    {
      "schemaVersion": 1,
      "id": "gr.c1.counterfactual-modal-nuance",
      "cefr": "C1",
      "title": "Counterfactual modal nuance",
      "objective": "Distinguish would/could/might have in unreal past results.",
      "concept": {
        "en": "Would have, could have, and might have encode different unreal-past meanings: expected result, unrealized ability/option, and uncertain possibility.",
        "vi": "Would have, could have và might have mang sắc thái quá khứ phản thực khác nhau: kết quả kỳ vọng, khả năng/lựa chọn không thực hiện và khả năng chưa chắc."
      },
      "formulae": [
        "would/could/might + have + past participle"
      ],
      "whenToUse": [
        "Choose the result modal according to certainty, ability, permission, or possibility in the imagined past."
      ],
      "forms": {
        "positive": [
          "With a larger sample, the study might have detected a smaller effect.",
          "A second pump could have prevented the basement from flooding.",
          "Had the warning arrived in time, we would have suspended the release."
        ]
      },
