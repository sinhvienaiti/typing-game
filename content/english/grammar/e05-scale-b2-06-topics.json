    {
      "schemaVersion": 1,
      "id": "gr.b2.dependent-prepositions-adjectives",
      "cefr": "B2",
      "title": "Advanced adjective + preposition patterns",
      "objective": "Master less predictable adjective complement choices and meaning changes.",
      "concept": {
        "en": "Many adjectives select a particular preposition, and changing that preposition can be ungrammatical or alter the intended relation.",
        "vi": "Nhiều tính từ đòi hỏi một giới từ cụ thể; đổi giới từ có thể làm câu sai hoặc thay đổi quan hệ nghĩa."
      },
      "formulae": [
        "aware of",
        "consistent with",
        "capable of",
        "responsible for"
      ],
      "whenToUse": [
        "Learn adjective-preposition combinations as lexical patterns rather than translating the preposition literally."
      ],
      "forms": {
        "positive": [
          "The committee is aware of the risks involved.",
          "This approach is consistent with our long-term strategy.",
          "She is capable of handling the negotiation herself."
        ]
      },
