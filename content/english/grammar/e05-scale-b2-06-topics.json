    {
      "schemaVersion": 1,
      "id": "gr.b2.stance-adverbs",
      "cefr": "B2",
      "title": "Stance adverbs",
      "objective": "Use apparently, obviously, fortunately, arguably and similar items to mark speaker stance.",
      "concept": {
        "en": "Stance adverbs comment on the speaker's certainty, evaluation or attitude toward the whole proposition.",
        "vi": "Trạng từ lập trường cho biết mức độ chắc chắn, đánh giá hoặc thái độ của người nói đối với toàn bộ mệnh đề."
      },
      "formulae": [
        "stance adverb + comma + clause",
        "clause-medial stance adverb where natural"
      ],
      "whenToUse": [
        "Signal evidence, evaluation or viewpoint explicitly without changing the core event described."
      ],
      "forms": {
        "positive": [
          "Apparently, the supplier has changed its delivery schedule.",
          "Fortunately, nobody was injured in the accident.",
          "Arguably, this is the most important finding in the report."
        ]
      },
