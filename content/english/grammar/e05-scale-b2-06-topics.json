    {
      "schemaVersion": 1,
      "id": "gr.b2.multiword-verbs",
      "cefr": "B2",
      "title": "Phrasal-prepositional and multiword verbs",
      "objective": "Distinguish particle, preposition and three-word verb patterns.",
      "concept": {
        "en": "Multiword verbs combine a lexical verb with particles and/or prepositions; the whole combination controls meaning, object position and complement pattern.",
        "vi": "Động từ nhiều từ kết hợp động từ chính với tiểu từ và/hoặc giới từ; toàn bộ cụm quyết định nghĩa, vị trí tân ngữ và kiểu bổ ngữ."
      },
      "formulae": [
        "verb + particle + preposition",
        "verb + particle",
        "inseparable multiword verb + object"
      ],
      "whenToUse": [
        "Recognize a multiword verb as one lexical unit and preserve the particles/prepositions required by that unit."
      ],
      "forms": {
        "positive": [
          "We need to come up with a more flexible backup plan.",
          "The investigation brought about several changes in procedure.",
          "I can't put up with that level of noise for long."
