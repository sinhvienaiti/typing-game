    {
      "schemaVersion": 1,
      "id": "gr.b2.gradable-intensifiers",
      "cefr": "B2",
      "title": "Gradable vs non-gradable adjectives and intensifiers",
      "objective": "Choose very, absolutely, completely, highly, deeply and similar modifiers naturally.",
      "concept": {
        "en": "Gradable adjectives combine with degree modifiers such as very or extremely, while non-gradable extremes often prefer absolutely, completely or similar intensifiers.",
        "vi": "Tính từ có thang độ kết hợp với very, extremely..., còn tính từ cực trị/không có thang độ thường hợp với absolutely, completely... hơn."
      },
      "formulae": [
        "very/extremely + gradable adjective",
        "absolutely/completely + extreme adjective",
        "deeply/highly + selected adjective collocations"
      ],
      "whenToUse": [
        "Choose an intensifier that matches both the adjective's scale and its common collocational behavior."
      ],
      "forms": {
        "positive": [
          "The instructions are absolutely essential for safe operation.",
          "I was deeply disappointed by the decision.",
          "The final stage is extremely difficult but not impossible."
        ]
      },
