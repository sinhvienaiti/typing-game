    {
      "schemaVersion": 1,
      "id": "gr.b2.dependent-prepositions-verbs",
      "cefr": "B2",
      "title": "Advanced verb + preposition patterns",
      "objective": "Master verb-preposition combinations whose meaning depends on the preposition.",
      "concept": {
        "en": "Many verbs form meaning-specific patterns with a required preposition that should be learned together with the verb.",
        "vi": "Nhiều động từ tạo thành mẫu nghĩa cụ thể với một giới từ bắt buộc và nên được học như một đơn vị cùng với động từ."
      },
      "formulae": [
        "distinguish between",
        "depend on",
        "object to",
        "result in/from"
      ],
      "whenToUse": [
        "Choose the preposition licensed by the verb and intended meaning instead of translating a Vietnamese preposition word-for-word."
      ],
      "forms": {
        "positive": [
          "We need to distinguish between temporary failures and structural problems.",
          "The success of the campaign depends on sustained public support.",
