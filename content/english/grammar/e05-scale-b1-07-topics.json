    {
      "schemaVersion": 1,
      "id": "gr.b1.other-forms",
      "cefr": "B1",
      "title": "Another/other/others/the other",
      "objective": "Refer to additional and remaining people/things accurately.",
      "concept": {
        "en": "Use another for one more singular item, other before plural/uncountable nouns, the other for the remaining specific one, and others as a pronoun.",
        "vi": "Dùng another cho thêm một vật số ít, other trước danh từ số nhiều/không đếm được, the other cho vật cụ thể còn lại và others như đại từ."
      },
      "formulae": [
        "another + singular noun",
        "other + plural/uncountable noun",
        "the other + singular noun",
        "others = other ones"
      ],
      "whenToUse": [
        "Avoid repeating nouns while distinguishing additional and remaining items."
      ],
      "forms": {
        "positive": [
          "Can I have another cup?",
          "Some students stayed; others went home.",
          "I have two bags: one is black and the other is blue."
        ]
      },
      "variations": [],
