      "id": "gr.b1.concession-linkers",
      "cefr": "B1",
      "title": "Although, despite and in spite of",
      "objective": "Express concession with correct clause or noun/-ing complements.",
      "concept": {
        "en": "Use although, even though, though and despite/in spite of to express a contrast between an expected result and what actually happens.",
        "vi": "Dùng although, even though, though và despite/in spite of để diễn tả sự tương phản giữa điều được mong đợi và điều thực tế xảy ra."
      },
      "formulae": [
        "although/even though + clause",
        "despite/in spite of + noun/-ing"
      ],
      "whenToUse": [
        "Connect contrasting ideas with the correct clause or noun pattern."
      ],
      "forms": {
        "positive": [
          "Although it was raining, we went out.",
          "Despite the rain, we went out.",
          "She finished the race even though she was tired."
        ]
