      "schemaVersion": 1,
      "id": "gr.b1.each-every-all",
      "cefr": "B1",
      "title": "Each, every and all",
      "objective": "Choose distributive vs group reference.",
      "concept": {
        "en": "Use each to focus on members individually, every for all members considered one by one, and all for the whole group or quantity.",
        "vi": "Dùng each để nhấn từng thành viên riêng lẻ, every cho tất cả thành viên xét từng người/vật, và all cho toàn bộ nhóm hoặc lượng."
      },
      "formulae": [
        "each/every + singular countable noun",
        "all + plural countable or uncountable noun"
      ],
      "whenToUse": [
        "Choose a quantifier according to individual versus collective focus."
      ],
      "forms": {
        "positive": [
          "Each student has a locker.",
          "Every room has a window.",
          "All students need an ID card."
        ]
      },
