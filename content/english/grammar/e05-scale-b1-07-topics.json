      "id": "gr.b1.phrasal-verb-separability",
      "cefr": "B1",
      "title": "Phrasal verbs: separable vs inseparable",
      "objective": "Place objects correctly and identify particle/preposition behavior.",
      "concept": {
        "en": "Distinguish separable phrasal verbs, where an object can split verb and particle, from inseparable phrasal verbs, where it cannot.",
        "vi": "Phân biệt cụm động từ tách được, nơi tân ngữ có thể đứng giữa động từ và tiểu từ, với cụm không tách được."
      },
      "formulae": [
        "separable: verb + object + particle / verb + particle + noun",
        "inseparable: verb + particle + object"
      ],
      "whenToUse": [
        "Place noun and pronoun objects correctly with different phrasal verbs."
      ],
      "forms": {
        "positive": [
          "Please turn the radio off.",
          "Please turn it off.",
          "I ran into an old friend yesterday."
