    {
      "schemaVersion": 1,
      "id": "gr.b1.quantifiers-most-enough-plenty",
      "cefr": "B1",
      "title": "Most, enough and plenty of",
      "objective": "Express broad proportions and sufficiency naturally.",
      "concept": {
        "en": "Use most for the majority, enough for a sufficient amount and plenty of for more than enough.",
        "vi": "Dùng most cho phần lớn, enough cho lượng đủ và plenty of cho lượng nhiều hơn đủ."
      },
      "formulae": [
        "most + plural/uncountable noun",
        "enough + noun",
        "plenty of + noun"
      ],
      "whenToUse": [
        "Describe majority, sufficiency and abundance."
      ],
      "forms": {
        "positive": [
          "Most people use smartphones.",
          "We have enough food for everyone.",
          "There's plenty of time."
