    {
      "schemaVersion": 1,
      "id": "gr.a2.superlatives",
      "cefr": "A2",
      "title": "Superlatives",
      "objective": "Identify the highest/lowest degree in a group.",
      "concept": {
        "en": "Use the superlative to identify the highest or lowest degree within a group.",
        "vi": "Dùng so sánh nhất để chỉ mức độ cao nhất hoặc thấp nhất trong một nhóm."
      },
      "formulae": [
        "the + short adjective-est",
        "the most + longer adjective"
      ],
      "whenToUse": [
        "Compare one member with a group of three or more."
      ],
      "forms": {
        "positive": [
          "Mount Everest is the highest mountain in the world.",
          "This is the easiest question on the page.",
          "Mia is the most careful driver in our family."
        ]
      },
      "variations": [
        "Irregular forms include best and worst."
      ],
