    {
      "schemaVersion": 1,
      "id": "gr.a2.comparatives",
      "cefr": "A2",
      "title": "Comparative adjectives and adverbs",
      "objective": "Compare two people, things or actions.",
      "concept": {
        "en": "Use comparative adjectives with than to compare two people, things or situations.",
        "vi": "Dùng tính từ so sánh hơn với than để so sánh hai người, vật hoặc tình huống."
      },
      "formulae": [
        "short adjective + -er + than",
        "more + longer adjective + than"
      ],
      "whenToUse": [
        "Compare two items by one quality."
      ],
      "forms": {
        "positive": [
          "This bag is cheaper than that one.",
          "My sister is taller than me.",
          "This chair is more comfortable than that chair."
        ]
      },
      "variations": [
        "Some common comparatives are irregular, such as good → better and bad → worse."
      ],
