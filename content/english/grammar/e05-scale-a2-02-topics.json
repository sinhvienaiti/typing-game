    {
      "schemaVersion": 1,
      "id": "gr.a2.present-perfect-since-for",
      "cefr": "A2",
      "title": "Present Perfect with since/for",
      "objective": "Express duration from a starting point or over a period.",
      "concept": {
        "en": "Use since for a starting point and for for a duration with a situation continuing up to now.",
        "vi": "Dùng since cho mốc bắt đầu và for cho khoảng thời gian khi tình huống kéo dài đến hiện tại."
      },
      "formulae": [
        "have/has + past participle + since + starting point",
        "have/has + past participle + for + duration"
      ],
      "whenToUse": [
        "Say how long a current situation has continued."
      ],
      "forms": {
        "positive": [
          "I've lived here for three years.",
          "She has worked here since May.",
          "They've known each other for a long time."
        ]
      },
      "variations": [
        "Use since with points such as Monday, 2024 or I was a child."
      ],
