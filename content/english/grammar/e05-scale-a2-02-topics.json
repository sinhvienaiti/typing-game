    {
      "schemaVersion": 1,
      "id": "gr.a2.indefinite-pronouns",
      "cefr": "A2",
      "title": "Some/any/no/every compounds",
      "objective": "Use someone/anything/nothing/everywhere and related forms.",
      "concept": {
        "en": "Use indefinite pronouns such as someone, anyone, everyone, something and nothing when the exact person or thing is not named.",
        "vi": "Dùng đại từ bất định như someone, anyone, everyone, something và nothing khi không nêu chính xác người hoặc vật."
      },
      "formulae": [
        "some- forms often in affirmative statements",
        "any- forms often in questions/negatives",
        "every-/no- forms for all or none"
      ],
      "whenToUse": [
        "Refer to unspecified people, things or places."
      ],
      "forms": {
        "positive": [
          "Someone is at the door.",
          "I didn't see anyone in the room.",
          "Everything is ready."
        ]
      },
      "variations": [
        "Indefinite pronouns normally take a singular verb: Everyone is ready."
      ],
