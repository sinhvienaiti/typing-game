    {
      "schemaVersion": 1,
      "id": "gr.a2.present-perfect-just",
      "cefr": "A2",
      "title": "Present Perfect with just",
      "objective": "Describe very recent completed events.",
      "concept": {
        "en": "Use just with the Present Perfect for an action completed a very short time ago.",
        "vi": "Dùng just với Hiện tại hoàn thành cho hành động vừa mới hoàn tất cách đây rất ngắn."
      },
      "formulae": [
        "Subject + have/has just + past participle."
      ],
      "whenToUse": [
        "Report very recent news or actions."
      ],
      "forms": {
        "positive": [
          "I've just eaten lunch.",
          "The train has just left.",
          "Mia has just called me."
        ]
      },
      "variations": [
        "In standard British-style usage, just commonly appears with the Present Perfect."
      ],
