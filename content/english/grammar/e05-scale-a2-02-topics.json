    {
      "schemaVersion": 1,
      "id": "gr.a2.few-little",
      "cefr": "A2",
      "title": "A few/few and a little/little",
      "objective": "Express positive or insufficient small quantities.",
      "concept": {
        "en": "Use a few with countable plural nouns and a little with uncountable nouns for small but positive amounts.",
        "vi": "Dùng a few với danh từ đếm được số nhiều và a little với danh từ không đếm được để chỉ lượng nhỏ nhưng vẫn có."
      },
      "formulae": [
        "a few + plural countable noun",
        "a little + uncountable noun"
      ],
      "whenToUse": [
        "Describe small quantities without meaning zero."
      ],
      "forms": {
        "positive": [
          "I have a few questions.",
          "There is a little milk left.",
          "We have a few minutes before class."
        ]
      },
      "variations": [
        "Few/little without a usually sound more negative: almost not enough."
      ],
