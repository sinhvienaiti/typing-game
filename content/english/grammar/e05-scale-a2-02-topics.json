    {
      "schemaVersion": 1,
      "id": "gr.a2.present-perfect-vs-past-simple",
      "cefr": "A2",
      "title": "Present Perfect vs Past Simple: basic contrast",
      "objective": "Choose unspecified/current relevance vs finished past time.",
      "concept": {
        "en": "Use the Present Perfect for an unfinished time or experience connected to now, and the Past Simple with a finished past time.",
        "vi": "Dùng Hiện tại hoàn thành cho khoảng thời gian chưa kết thúc hoặc trải nghiệm liên quan hiện tại; dùng Quá khứ đơn với thời gian quá khứ đã kết thúc."
      },
      "formulae": [
        "Present Perfect: have/has + past participle",
        "Past Simple: past form + finished-time expression"
      ],
      "whenToUse": [
        "Choose between present relevance and a specific finished past event."
      ],
      "forms": {
        "positive": [
          "I've visited Hue twice.",
          "I visited Hue last summer.",
          "Have you seen this film? I saw it yesterday."
        ]
      },
      "variations": [
        "Do not combine the Present Perfect with explicit finished times such as yesterday or last year."
      ],
      "relatedCollocationIds": [],
