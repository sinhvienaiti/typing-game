    {
      "schemaVersion": 1,
      "id": "gr.a2.quantifiers-much-many-lot",
      "cefr": "A2",
      "title": "Much, many and a lot of",
      "objective": "Choose quantity expressions for countable and uncountable nouns.",
      "concept": {
        "en": "Use many with countable plural nouns, much with uncountable nouns, and a lot of with both in common affirmative sentences.",
        "vi": "Dùng many với danh từ đếm được số nhiều, much với danh từ không đếm được và a lot of với cả hai trong nhiều câu khẳng định thông dụng."
      },
      "formulae": [
        "many + plural countable noun",
        "much + uncountable noun",
        "a lot of + countable/uncountable noun"
      ],
      "whenToUse": [
        "Talk about large quantities and ask how much or how many."
      ],
      "forms": {
        "positive": [
          "How many books do you have?",
          "We don't have much time.",
          "There are a lot of people here."
        ]
      },
      "variations": [
        "Much is less common than a lot of in affirmative informal statements."
      ],
