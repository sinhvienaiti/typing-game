    {
      "schemaVersion": 1,
      "id": "gr.b1.reported-questions",
      "cefr": "B1",
      "title": "Reported questions",
      "objective": "Use statement word order in reported yes/no and wh-questions.",
      "concept": {
        "en": "Report questions with statement word order and no do/does/did auxiliary; use if/whether for yes-no questions.",
        "vi": "Tường thuật câu hỏi bằng trật tự câu khẳng định và không dùng trợ động từ do/does/did; dùng if/whether cho câu hỏi yes-no."
      },
      "formulae": [
        "ask + wh-word + subject + verb",
        "ask + if/whether + subject + verb"
      ],
      "whenToUse": [
        "Turn direct questions into reported questions."
      ],
      "forms": {
        "positive": [
          "She asked where I lived.",
          "He asked if I was ready.",
          "They asked what time the train left."
        ]
      },
