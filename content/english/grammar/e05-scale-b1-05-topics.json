    {
      "schemaVersion": 1,
      "id": "gr.b1.reported-requests-commands",
      "cefr": "B1",
      "title": "Reported requests and commands",
      "objective": "Report instructions using tell/ask + object + to-infinitive.",
      "concept": {
        "en": "Report requests and commands with ask/tell/order + object + to-infinitive, and use not to for negative commands.",
        "vi": "Tường thuật lời yêu cầu và mệnh lệnh bằng ask/tell/order + tân ngữ + to-infinitive; dùng not to cho mệnh lệnh phủ định."
      },
      "formulae": [
        "ask/tell + object + to + base verb",
        "tell + object + not to + base verb"
      ],
      "whenToUse": [
        "Report what someone asked or ordered another person to do."
      ],
      "forms": {
        "positive": [
          "She asked me to sit down.",
          "The teacher told us to be quiet.",
          "Dad told me not to stay out late."
