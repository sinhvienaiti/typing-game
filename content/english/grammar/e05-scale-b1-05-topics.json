    {
      "schemaVersion": 1,
      "id": "gr.b1.relative-whose",
      "cefr": "B1",
      "title": "Relative clauses with whose",
      "objective": "Express possession inside defining and non-defining relative clauses.",
      "concept": {
        "en": "Use whose in a relative clause to show possession or relationship.",
        "vi": "Dùng whose trong mệnh đề quan hệ để thể hiện sở hữu hoặc mối quan hệ."
      },
      "formulae": [
        "person/thing + whose + noun + clause"
      ],
      "whenToUse": [
        "Link a person or thing to something that belongs to or is associated with it."
      ],
      "forms": {
        "positive": [
          "I met a woman whose son is a pilot.",
          "That's the company whose office moved downtown.",
          "Students whose work is late must email the teacher."
        ]
