    {
      "schemaVersion": 1,
      "id": "gr.b1.reported-statements",
      "cefr": "B1",
      "title": "Reported statements",
      "objective": "Report speech with pronoun/time changes and basic backshift.",
      "concept": {
        "en": "Report what someone said by using a reporting verb plus a statement clause, often with tense and reference changes when reporting later.",
        "vi": "Tường thuật lời nói của ai đó bằng động từ tường thuật + mệnh đề, thường có thay đổi thì và từ chỉ thời gian/người khi kể lại sau đó."
      },
      "formulae": [
        "say (that) + clause",
        "tell + object + (that) + clause"
      ],
      "whenToUse": [
        "Report statements without repeating the speaker's exact words."
      ],
      "forms": {
        "positive": [
          "Mia said that she was tired.",
          "Tom told me that he needed help.",
          "They said they would call later."
        ]
      },
