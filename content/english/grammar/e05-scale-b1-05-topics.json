      "id": "gr.b1.indirect-questions",
      "cefr": "B1",
      "title": "Indirect questions",
      "objective": "Use polite question frames with statement word order.",
      "concept": {
        "en": "Use introductory phrases such as Could you tell me or Do you know followed by statement word order in the question clause.",
        "vi": "Dùng các cụm mở đầu như Could you tell me hoặc Do you know, sau đó dùng trật tự câu khẳng định trong mệnh đề hỏi."
      },
      "formulae": [
        "introductory phrase + wh-word + subject + verb",
        "introductory phrase + if/whether + subject + verb"
      ],
      "whenToUse": [
        "Ask questions more politely or indirectly."
      ],
      "forms": {
        "positive": [
          "Could you tell me where the station is?",
          "Do you know if the shop is open?",
          "Can you tell me what time it starts?"
