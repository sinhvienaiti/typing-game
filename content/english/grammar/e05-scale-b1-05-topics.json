      "id": "gr.b1.question-tags",
      "cefr": "B1",
      "title": "Question tags: agreement and intonation meaning",
      "objective": "Form tags and understand checking vs confirmation functions.",
      "concept": {
        "en": "Form question tags by matching the auxiliary or modal in the statement and reversing positive/negative polarity.",
        "vi": "Tạo câu hỏi đuôi bằng cách dùng cùng trợ động từ hoặc modal của mệnh đề chính và đảo tính khẳng định/phủ định."
      },
      "formulae": [
        "positive statement, negative tag?",
        "negative statement, positive tag?"
      ],
      "whenToUse": [
        "Check information or invite agreement with a wider range of tenses and auxiliaries."
      ],
      "forms": {
