    {
      "schemaVersion": 1,
      "id": "gr.b1.relative-pronoun-omission",
      "cefr": "B1",
      "title": "Omitting relative pronouns",
      "objective": "Omit object relative pronouns when grammar allows it.",
      "concept": {
        "en": "In a defining relative clause, omit who/that/which when it is the object, but not when it is the subject.",
        "vi": "Trong mệnh đề quan hệ xác định, có thể lược bỏ who/that/which khi nó là tân ngữ, nhưng không lược bỏ khi nó là chủ ngữ."
      },
      "formulae": [
        "object relative: noun + (that/which/who) + subject + verb",
        "subject relative: pronoun required"
      ],
      "whenToUse": [
        "Recognize when a relative pronoun can be omitted naturally."
      ],
      "forms": {
        "positive": [
          "The book I bought is excellent.",
          "The person we met was friendly.",
          "The woman who works here is helpful."
        ]
      },
      "variations": [],
      "relatedCollocationIds": [],
