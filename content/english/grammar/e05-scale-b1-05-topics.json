    {
      "schemaVersion": 1,
      "id": "gr.b1.reported-speech-backshift",
      "cefr": "B1",
      "title": "Reported speech: backshift vs unchanged truth",
      "objective": "Choose when backshift is natural and when it is unnecessary.",
      "concept": {
        "en": "When reporting past speech later, present forms often backshift to past forms and will often changes to would, unless the information is still current or backshift is unnecessary.",
        "vi": "Khi tường thuật lại lời nói trong quá khứ, các thì hiện tại thường lùi về quá khứ và will thường đổi thành would, trừ khi thông tin vẫn còn đúng hoặc không cần lùi thì."
      },
      "formulae": [
        "present → past",
        "will → would",
        "can → could (common backshift)"
      ],
      "whenToUse": [
        "Show the time relationship between the original speech and the later report."
      ],
      "forms": {
        "positive": [
          "'I'm busy.' → She said she was busy.",
          "'I'll call.' → He said he would call.",
          "'I can swim.' → Mia said she could swim."
        ]
      },
      "variations": [],
