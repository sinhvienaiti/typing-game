    {
      "schemaVersion": 1,
      "id": "gr.b2.future-forms-planning",
      "cefr": "B2",
      "title": "Advanced future form choice in plans",
      "objective": "Coordinate intentions, arrangements, schedules, predictions and deadlines.",
      "concept": {
        "en": "Use future forms strategically to distinguish intentions, arrangements, schedules, forecasts, deadlines and expected ongoing activity.",
        "vi": "Dùng các dạng tương lai có chủ đích để phân biệt ý định, sắp xếp, lịch trình, dự báo, hạn hoàn thành và hoạt động dự kiến đang diễn ra."
      },
      "formulae": [
        "going to = intention/evidence",
        "Present Continuous = arrangement",
        "Present Simple = schedule",
        "will = forecast/decision",
        "will have = completed by deadline"
      ],
      "whenToUse": [
        "Choose a future form according to the speaker's perspective on planning and certainty."
      ],
      "forms": {
        "positive": [
          "We're meeting the supplier at ten.",
          "The conference starts on Monday.",
          "By noon, I'll have sent the final version."
        ]
      },
