    {
      "schemaVersion": 1,
      "id": "gr.b2.future-continuous-expectation",
      "cefr": "B2",
      "title": "Future Continuous: expected course and polite inquiry",
      "objective": "Describe expected ongoing events and ask about plans neutrally.",
      "concept": {
        "en": "Besides an action in progress, the Future Continuous can describe an expected event as part of a normal course or politely ask about someone's plans.",
        "vi": "Ngoài hành động đang diễn ra, Tương lai tiếp diễn còn có thể diễn tả một việc được dự kiến xảy ra theo tiến trình bình thường hoặc hỏi kế hoạch một cách lịch sự."
      },
      "formulae": [
        "will be + V-ing",
        "Will + subject + be + V-ing ...?"
      ],
      "whenToUse": [
        "Describe expected future routines or ask about plans without sounding like a request."
      ],
      "forms": {
        "positive": [
          "I'll be seeing Marta tomorrow, so I'll give her the message.",
          "Will you be using the car this evening?",
          "They'll be staying with us for a few days."
        ]
      },
