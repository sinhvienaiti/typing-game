    {
      "schemaVersion": 1,
      "id": "gr.b2.second-conditional-modals",
      "cefr": "B2",
      "title": "Second Conditional with could/might",
      "objective": "Express hypothetical ability and uncertain hypothetical results.",
      "concept": {
        "en": "In unreal or unlikely present/future conditions, the result clause can use would, could or might to express consequence, ability or possibility.",
        "vi": "Trong điều kiện không thực hoặc ít khả năng ở hiện tại/tương lai, mệnh đề kết quả có thể dùng would, could hoặc might để diễn tả kết quả, khả năng hay khả năng xảy ra."
      },
      "formulae": [
        "If + Past Simple, would/could/might + base verb."
      ],
      "whenToUse": [
        "Vary the result meaning in Second Conditional patterns."
      ],
      "forms": {
        "positive": [
          "If I had more time, I could learn another language.",
          "If she lived nearer, we might see her more often.",
          "If they offered me the job, I would accept it."
        ]
      },
