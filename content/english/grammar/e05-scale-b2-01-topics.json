    {
      "schemaVersion": 1,
      "id": "gr.b2.future-perfect",
      "cefr": "B2",
      "title": "Future Perfect",
      "objective": "Describe actions completed by a future deadline/reference point.",
      "concept": {
        "en": "Use the Future Perfect for an action that will be completed before a specified future time.",
        "vi": "Dùng Tương lai hoàn thành cho hành động sẽ hoàn tất trước một mốc tương lai xác định."
      },
      "formulae": [
        "Subject + will have + past participle + by/before future time."
      ],
      "whenToUse": [
        "Look forward from now to a future deadline and describe what will already be complete."
      ],
      "forms": {
        "positive": [
          "By Friday, we'll have finished the project.",
          "She will have left by the time you arrive.",
          "By next year, they will have lived here for a decade."
        ]
      },
