    {
      "schemaVersion": 1,
      "id": "gr.b2.future-in-the-past",
      "cefr": "B2",
      "title": "Future in the past",
      "objective": "Use would/was going to/was about to for future viewed from a past point.",
      "concept": {
        "en": "Use would, was/were going to and was/were about to to describe a future event viewed from a past point.",
        "vi": "Dùng would, was/were going to và was/were about to để diễn tả một sự kiện tương lai nhìn từ một mốc trong quá khứ."
      },
      "formulae": [
        "would + base verb",
        "was/were going to + base verb",
        "was/were about to + base verb"
      ],
      "whenToUse": [
        "Report past plans, predictions and events that were still future at the past reference point."
      ],
      "forms": {
        "positive": [
          "I knew she would call later.",
          "We were going to leave, but the storm started.",
          "He was about to speak when the phone rang."
        ]
