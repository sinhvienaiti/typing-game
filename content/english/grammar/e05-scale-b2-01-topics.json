    {
      "schemaVersion": 1,
      "id": "gr.b2.perfect-aspect-nuance",
      "cefr": "B2",
      "title": "Present perfect simple/continuous: nuanced aspect choice",
      "objective": "Choose completion, result, repetition, temporary activity or duration focus.",
      "concept": {
        "en": "Perfect forms connect an earlier situation to a later reference point; choose simple or continuous aspect according to result, completion and duration focus.",
        "vi": "Các dạng hoàn thành nối một tình huống xảy ra trước với một mốc tham chiếu sau; chọn dạng đơn hay tiếp diễn tùy trọng tâm kết quả, hoàn tất hay thời lượng."
      },
      "formulae": [
        "have/has + past participle",
        "had + past participle",
        "have/has/had been + V-ing"
      ],
      "whenToUse": [
        "Contrast result/completion with ongoing process across present and past reference points."
      ],
      "forms": {
        "positive": [
          "I've finished the report, so you can read it now.",
          "I'd been working for hours before I took a break.",
          "She has known him since school."
        ]
      },
