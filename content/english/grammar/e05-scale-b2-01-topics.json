    {
      "schemaVersion": 1,
      "id": "gr.b2.past-perfect-continuous",
      "cefr": "B2",
      "title": "Past Perfect Continuous",
      "objective": "Show duration/activity leading up to a past reference point.",
      "concept": {
        "en": "Use the Past Perfect Continuous to emphasize the duration or repeated nature of an activity continuing up to a past reference point.",
        "vi": "Dùng Quá khứ hoàn thành tiếp diễn để nhấn mạnh thời lượng hoặc tính lặp lại của hoạt động kéo dài đến một mốc trong quá khứ."
      },
      "formulae": [
        "Subject + had been + V-ing + for/since ..."
      ],
      "whenToUse": [
        "Explain what had been happening before another past event, especially when duration or visible results matter."
      ],
      "forms": {
        "positive": [
          "They had been waiting for an hour when the bus arrived.",
          "Her eyes were tired because she'd been reading all night.",
          "We had been living there for six years before we moved."
        ]
      },
      "variations": [],
