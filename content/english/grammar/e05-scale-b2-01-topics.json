    {
      "schemaVersion": 1,
      "id": "gr.b2.mixed-conditional-past-present",
      "cefr": "B2",
      "title": "Mixed Conditional: past condition → present result",
      "objective": "Connect a counterfactual past event to a present consequence.",
      "concept": {
        "en": "Use a mixed conditional with an unreal past condition and a present result when a different past action would change the situation now.",
        "vi": "Dùng câu điều kiện hỗn hợp với điều kiện quá khứ không có thật và kết quả hiện tại khi một hành động quá khứ khác đi sẽ làm thay đổi tình hình bây giờ."
      },
      "formulae": [
        "If + Past Perfect, would + base verb (present result)."
      ],
      "whenToUse": [
        "Connect a past cause with its imagined present consequence."
      ],
      "forms": {
        "positive": [
          "If I'd studied medicine, I'd be a doctor now.",
          "If we hadn't missed the train, we'd be home now.",
          "If she had accepted the offer, she would live in Paris now."
        ]
      },
