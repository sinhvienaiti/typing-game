    {
      "schemaVersion": 1,
      "id": "gr.b1.passive-agent-choice",
      "cefr": "B1",
      "title": "Passive agents and when to omit them",
      "objective": "Decide whether a by-agent is useful, obvious or irrelevant.",
      "concept": {
        "en": "In passive sentences, include by + agent only when the agent is important, informative or surprising; omit it when unknown or obvious.",
        "vi": "Trong câu bị động, chỉ thêm by + tác nhân khi người thực hiện quan trọng, cung cấp thông tin hoặc đáng chú ý; bỏ đi khi không biết hoặc đã hiển nhiên."
      },
      "formulae": [
        "passive clause (+ by + agent when useful)"
      ],
      "whenToUse": [
        "Decide whether naming the agent adds meaningful information."
      ],
      "forms": {
        "positive": [
          "My bike was stolen last night.",
          "The novel was written by George Orwell.",
          "The road is being repaired."
        ]
