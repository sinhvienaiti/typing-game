    {
      "schemaVersion": 1,
      "id": "gr.b1.stop-try-gerund-infinitive",
      "cefr": "B1",
      "title": "Stop/try + -ing vs to-infinitive",
      "objective": "Distinguish ending an activity, purpose, experiment and effort meanings.",
      "concept": {
        "en": "Stop + -ing means end an activity, stop + to-infinitive means pause another activity in order to do something; try + -ing tests a method, while try + to-infinitive attempts a difficult action.",
        "vi": "Stop + V-ing nghĩa là chấm dứt một hoạt động, stop + to-infinitive là dừng việc khác để làm việc này; try + V-ing là thử một phương pháp, còn try + to-infinitive là cố gắng thực hiện."
      },
      "formulae": [
        "stop doing / stop to do",
        "try doing / try to do"
      ],
      "whenToUse": [
        "Choose gerund or infinitive when the meaning changes."
      ],
      "forms": {
        "positive": [
          "He stopped smoking last year.",
          "We stopped to buy some water.",
          "Try restarting the computer."
        ]
      },
      "variations": [],
      "relatedCollocationIds": [],
