      "id": "gr.b1.passive-modals",
      "cefr": "B1",
      "title": "Passive with modal verbs",
      "objective": "Form modal + be + past participle for rules, possibility and obligation.",
      "concept": {
        "en": "Form a passive after a modal with modal + be + past participle.",
        "vi": "Tạo câu bị động sau động từ khuyết thiếu bằng modal + be + quá khứ phân từ."
      },
      "formulae": [
