    {
      "schemaVersion": 1,
      "id": "gr.b1.verb-object-to-infinitive",
      "cefr": "B1",
      "title": "Verb + object + to-infinitive",
      "objective": "Use tell/ask/want/allow/encourage patterns.",
      "concept": {
        "en": "Many verbs such as ask, tell, want, expect and advise can be followed by an object plus a to-infinitive.",
        "vi": "Nhiều động từ như ask, tell, want, expect và advise có thể theo sau bởi tân ngữ + to-infinitive."
      },
      "formulae": [
        "verb + object + to + base verb"
      ],
      "whenToUse": [
        "Report requests, expectations, instructions and advice directed at another person."
      ],
      "forms": {
        "positive": [
          "She asked me to wait outside.",
          "The doctor advised him to rest.",
          "We expect them to arrive soon."
