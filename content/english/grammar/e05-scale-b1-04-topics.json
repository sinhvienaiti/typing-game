    {
      "schemaVersion": 1,
      "id": "gr.b1.nondefining-relative-clauses",
      "cefr": "B1",
      "title": "Non-defining relative clauses",
      "objective": "Add extra information with commas and appropriate pronouns.",
      "concept": {
        "en": "Use non-defining relative clauses between commas to add extra information about a noun that is already identified.",
        "vi": "Dùng mệnh đề quan hệ không xác định, đặt giữa dấu phẩy, để thêm thông tin phụ về danh từ đã được xác định rõ."
      },
      "formulae": [
        "identified noun, who/which + extra clause, ..."
      ],
      "whenToUse": [
        "Add non-essential background information without changing which noun is meant."
      ],
      "forms": {
        "positive": [
          "My brother, who lives in Da Nang, is visiting us.",
          "This laptop, which I bought last year, is already broken.",
          "Hanoi, which is Vietnam's capital, has many lakes."
