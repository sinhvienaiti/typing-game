    {
      "schemaVersion": 1,
      "id": "gr.b1.passive-present-past",
      "cefr": "B1",
      "title": "Passive Voice: present and past simple",
      "objective": "Shift focus from doer to action/result.",
      "concept": {
        "en": "Form the present and past passive with the correct form of be plus a past participle when the action or result is more important than the agent.",
        "vi": "Tạo câu bị động hiện tại và quá khứ bằng dạng thích hợp của be + quá khứ phân từ khi hành động hoặc kết quả quan trọng hơn người thực hiện."
      },
      "formulae": [
        "Present Simple passive: am/is/are + past participle",
        "Past Simple passive: was/were + past participle"
      ],
      "whenToUse": [
        "Shift focus from who does an action to what receives the action."
      ],
      "forms": {
        "positive": [
          "English is spoken in many countries.",
          "The bridge was built in 1998.",
          "These rooms are cleaned every day."
        ]
      },
