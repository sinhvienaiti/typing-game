    {
      "schemaVersion": 1,
      "id": "gr.b1.make-let-help",
      "cefr": "B1",
      "title": "Make/let/help + object + verb",
      "objective": "Use causative/permission patterns with bare infinitives appropriately.",
      "concept": {
        "en": "Use make and let with object + bare infinitive; help can take object + bare infinitive or to-infinitive.",
        "vi": "Dùng make và let với tân ngữ + động từ nguyên mẫu không to; help có thể đi với tân ngữ + động từ nguyên mẫu có hoặc không có to."
      },
      "formulae": [
        "make/let + object + base verb",
        "help + object + (to) + base verb"
      ],
      "whenToUse": [
        "Express causing, permitting or assisting another person to do something."
      ],
      "forms": {
        "positive": [
          "The joke made us laugh.",
          "My parents let me stay out late.",
          "She helped me carry the boxes."
        ]
