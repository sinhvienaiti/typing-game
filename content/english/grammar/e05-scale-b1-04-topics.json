    {
      "schemaVersion": 1,
      "id": "gr.b1.defining-relative-clauses",
      "cefr": "B1",
      "title": "Defining relative clauses",
      "objective": "Add essential identifying information accurately.",
      "concept": {
        "en": "Use defining relative clauses to give essential information that identifies the person, thing or place being discussed.",
        "vi": "Dùng mệnh đề quan hệ xác định để cung cấp thông tin thiết yếu giúp xác định người, vật hoặc nơi đang nói đến."
      },
      "formulae": [
        "noun + who/that/which/where + defining clause"
      ],
      "whenToUse": [
        "Identify exactly which noun you mean without commas."
      ],
      "forms": {
        "positive": [
          "The woman who called earlier is my manager.",
          "I need the file that you sent yesterday.",
          "That's the cafe where we met."
        ]
