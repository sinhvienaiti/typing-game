    {
      "schemaVersion": 1,
      "id": "gr.a2.present-perfect-ever-never",
      "cefr": "A2",
      "title": "Present Perfect with ever/never",
      "objective": "Ask and answer about experience with ever and never.",
      "concept": {
        "en": "Use ever in Present Perfect questions and never in statements to talk about experience up to now.",
        "vi": "Dùng ever trong câu hỏi Hiện tại hoàn thành và never trong câu khẳng định để nói về trải nghiệm tính đến hiện tại."
      },
      "formulae": [
        "Have/Has + subject + ever + past participle?",
        "Subject + have/has never + past participle."
      ],
      "whenToUse": [
        "Ask about or state life experience without a finished past time."
      ],
      "forms": {
        "positive": [
          "Have you ever ridden a horse?",
          "I've never flown in a helicopter.",
          "Has Tom ever tried sushi?"
        ]
      },
      "variations": [
        "Never already contains a negative meaning, so do not add not."
      ],
