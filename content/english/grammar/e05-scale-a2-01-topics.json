    {
      "schemaVersion": 1,
      "id": "gr.a2.past-continuous-interruption",
      "cefr": "A2",
      "title": "Past Continuous + Past Simple: interruption",
      "objective": "Describe an action in progress interrupted by a shorter event.",
      "concept": {
        "en": "Use the Past Continuous for an action already in progress and the Past Simple for the shorter event that interrupts it.",
        "vi": "Dùng Quá khứ tiếp diễn cho hành động đang diễn ra và Quá khứ đơn cho sự kiện ngắn chen vào."
      },
      "formulae": [
        "Past Continuous + when + Past Simple."
      ],
      "whenToUse": [
        "Describe an interrupted past activity."
      ],
      "forms": {
        "positive": [
          "I was cooking when the phone rang.",
          "They were walking home when it started to snow.",
          "She was sleeping when the alarm went off."
        ]
      },
      "variations": [
        "When commonly introduces the shorter interrupting event."
      ],
