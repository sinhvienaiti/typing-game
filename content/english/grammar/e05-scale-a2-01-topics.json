    {
      "schemaVersion": 1,
      "id": "gr.a2.past-simple-finished-time",
      "cefr": "A2",
      "title": "Past Simple with finished time",
      "objective": "Link completed past events to finished time expressions.",
      "concept": {
        "en": "Use the Past Simple for an action completed at a finished time in the past.",
        "vi": "Dùng Quá khứ đơn cho hành động đã hoàn tất tại một thời điểm quá khứ đã kết thúc."
      },
      "formulae": [
        "Subject + past form + finished-time expression."
      ],
      "whenToUse": [
        "Use it with times such as yesterday, last night, in 2024 or two days ago."
      ],
      "forms": {
        "positive": [
          "I finished the report yesterday.",
          "Sara called me last night.",
          "We moved here in 2024."
        ]
      },
      "variations": [
        "A finished-time expression normally selects the Past Simple."
      ],
