    {
      "schemaVersion": 1,
      "id": "gr.a2.present-perfect-already-yet",
      "cefr": "A2",
      "title": "Present Perfect with already/yet",
      "objective": "Express earlier-than-expected completion and pending completion.",
      "concept": {
        "en": "Use already for something completed sooner than expected and yet mainly in Present Perfect questions and negatives.",
        "vi": "Dùng already cho việc đã hoàn tất sớm hơn dự kiến và yet chủ yếu trong câu hỏi hoặc phủ định ở Hiện tại hoàn thành."
      },
      "formulae": [
        "Subject + have/has already + past participle.",
        "Have/Has + subject + past participle + yet?",
        "Subject + haven't/hasn't + past participle + yet."
      ],
      "whenToUse": [
        "Talk about whether an expected action is complete by now."
      ],
      "forms": {
        "positive": [
          "I've already sent the email.",
          "Nina hasn't finished yet.",
          "Have they arrived yet?"
        ]
      },
      "variations": [
        "Already normally comes before the past participle; yet usually comes at the end."
      ],
