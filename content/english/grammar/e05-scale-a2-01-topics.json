    {
      "schemaVersion": 1,
      "id": "gr.a2.used-to",
      "cefr": "A2",
      "title": "Used to: past habits and states",
      "objective": "Describe past habits/states that are no longer true.",
      "concept": {
        "en": "Use used to + base verb for past habits or states that are no longer true now.",
        "vi": "Dùng used to + động từ nguyên mẫu cho thói quen hoặc trạng thái trong quá khứ hiện nay không còn đúng."
      },
      "formulae": [
        "Subject + used to + base verb.",
        "Subject + didn't use to + base verb."
      ],
      "whenToUse": [
        "Talk about repeated past habits or old situations that changed."
      ],
      "forms": {
        "positive": [
          "I used to live near the sea.",
          "Mina used to walk to school.",
          "We didn't use to have a car."
        ]
      },
      "variations": [
        "Used to describes a past pattern, not a single finished event."
      ],
