    {
      "schemaVersion": 1,
      "id": "gr.a2.past-simple-vs-continuous",
      "cefr": "A2",
      "title": "Past Simple vs Past Continuous",
      "objective": "Choose completed events vs background/in-progress past actions.",
      "concept": {
        "en": "Choose the Past Simple for completed events and the Past Continuous for activities in progress at that past moment.",
        "vi": "Chọn Quá khứ đơn cho sự kiện hoàn tất và Quá khứ tiếp diễn cho hoạt động đang diễn ra tại thời điểm quá khứ đó."
      },
      "formulae": [
        "completed event: Past Simple",
        "background/in-progress action: was/were + verb-ing"
      ],
      "whenToUse": [
        "Contrast a background activity with a completed event in a past story."
      ],
      "forms": {
        "positive": [
          "I was taking a shower when you called.",
          "While Ben was driving, he saw an accident.",
          "We were having dinner when the power went out."
        ]
      },
      "variations": [
        "While often introduces the longer background action."
      ],
