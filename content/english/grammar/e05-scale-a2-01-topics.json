    {
      "schemaVersion": 1,
      "id": "gr.a2.present-perfect-recent-result",
      "cefr": "A2",
      "title": "Present Perfect: recent events and present result",
      "objective": "Connect a recent past event to a current result.",
      "concept": {
        "en": "Use the Present Perfect when a recent past action has an important result now.",
        "vi": "Dùng Hiện tại hoàn thành khi một hành động vừa xảy ra trong quá khứ tạo ra kết quả quan trọng ở hiện tại."
      },
      "formulae": [
        "Subject + have/has + past participle."
      ],
      "whenToUse": [
        "Connect a recent action with its present result."
      ],
      "forms": {
        "positive": [
          "I've lost my keys, so I can't open the door.",
          "Leo has broken his glasses, so he can't read clearly.",
          "We've finished the work, so we can go home."
        ]
      },
      "variations": [
        "The present result is more important than the exact past time."
      ],
      "relatedCollocationIds": [],
      "exampleIds": [
