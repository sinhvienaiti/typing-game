    {
      "schemaVersion": 1,
      "id": "gr.a2.past-continuous-background",
      "cefr": "A2",
      "title": "Past Continuous: background actions",
      "objective": "Set the scene with actions in progress at a past time.",
      "concept": {
        "en": "Use the Past Continuous to describe an activity or situation in progress around a past time.",
        "vi": "Dùng Quá khứ tiếp diễn để mô tả hoạt động hoặc tình huống đang diễn ra quanh một thời điểm trong quá khứ."
      },
      "formulae": [
        "Subject + was/were + verb-ing."
      ],
      "whenToUse": [
        "Set the background scene for another past event or describe what was happening at a stated past time."
      ],
      "forms": {
        "positive": [
          "It was raining while we were driving home.",
          "The children were playing outside at six.",
          "I was reading when the lights went out."
        ]
      },
      "variations": [
        "The Past Continuous presents an action as in progress rather than as a completed event."
      ],
