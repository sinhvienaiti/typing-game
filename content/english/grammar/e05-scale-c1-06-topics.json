    {
      "schemaVersion": 1,
      "id": "gr.c1.boosters-downtoners",
      "cefr": "C1",
      "title": "Boosters and downtoners",
      "objective": "Control emphasis with highly, strongly, rather, somewhat and related stance choices.",
      "concept": {
        "en": "Boosters strengthen commitment or degree, while downtoners deliberately reduce force; both are sensitive to collocation and register.",
        "vi": "Booster tăng mức độ/cam kết, còn downtoner chủ ý giảm lực diễn đạt; cả hai phụ thuộc collocation và văn phong."
      },
      "formulae": [
        "strongly/highly/deeply + selected adjective/verb",
        "somewhat/rather/slightly + gradable expression"
      ],
      "whenToUse": [
        "Calibrate emphasis rather than stacking intensifiers mechanically."
      ],
      "forms": {
        "positive": [
          "The evidence strongly supports a phased implementation rather than an immediate national rollout.",
          "The revised definition is somewhat broader than the one used in the pilot.",
          "The findings are highly relevant to services that rely on seasonal staff."
        ]
      },
