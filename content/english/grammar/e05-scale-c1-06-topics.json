    {
      "schemaVersion": 1,
      "id": "gr.c1.advanced-preposition-choice",
      "cefr": "C1",
      "title": "Advanced preposition choice",
      "objective": "Resolve idiomatic and abstract preposition contrasts that cannot be predicted from literal meaning alone.",
      "concept": {
        "en": "Advanced preposition choice is often lexically fixed or meaning-sensitive and cannot be predicted reliably from literal translation.",
        "vi": "Lựa chọn giới từ nâng cao thường mang tính từ vựng/collocation hoặc phụ thuộc nghĩa và không thể suy ra chắc chắn bằng dịch sát."
      },
      "formulae": [
        "noun/adjective/verb + conventional preposition",
        "preposition choice changes semantic relation"
      ],
      "whenToUse": [
        "Learn the preposition with the governing word and verify whether alternative prepositions change meaning or register."
      ],
      "forms": {
        "positive": [
          "The committee expressed reservations about the proposed exemption from the reporting requirement.",
          "The new guidance is consistent with the principles set out in the earlier judgment.",
          "There is considerable scope for improvement in how the agency communicates risk."
