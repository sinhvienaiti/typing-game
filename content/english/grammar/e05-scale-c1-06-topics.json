    {
      "schemaVersion": 1,
      "id": "gr.c1.politeness-mitigation",
      "cefr": "C1",
      "title": "Politeness and mitigation",
      "objective": "Use distancing, softeners and indirect forms to manage face-sensitive requests/disagreement.",
      "concept": {
        "en": "Mitigation softens requests, disagreement, and criticism through modal distance, tentative framing, and partial agreement.",
        "vi": "Mitigation làm mềm yêu cầu, bất đồng và phê bình bằng khoảng cách modal, cách diễn đạt dè dặt và đồng thuận một phần."
      },
      "formulae": [
        "I was wondering if...",
        "Would it be possible to...?",
        "I take your point, but...",
        "It may be worth..."
      ],
      "whenToUse": [
        "Use mitigation when preserving the relationship matters, while keeping the requested action or disagreement clear."
      ],
      "forms": {
        "positive": [
          "I was wondering whether you might be able to send the revised schedule before the meeting.",
          "I take your point about cost, but I am not convinced the proposed saving is sustainable.",
          "It may be worth checking the assumption with the regional team before we finalize the paper."
        ]
      },
