    {
      "schemaVersion": 1,
      "id": "gr.c1.vague-language",
      "cefr": "C1",
      "title": "Vague language and approximators",
      "objective": "Use kind of, roughly, or so, and things like that appropriately by register.",
      "concept": {
        "en": "Vague language deliberately reduces precision through approximators and open-ended category markers when exactness is unnecessary or unavailable.",
        "vi": "Vague language cố ý giảm độ chính xác bằng từ xấp xỉ và dấu hiệu danh mục mở khi không cần hoặc chưa thể nêu chính xác."
      },
      "formulae": [
        "roughly/about + quantity",
        "or so",
        "kind/sort of",
        "and things/stuff like that"
      ],
      "whenToUse": [
        "Use vague language appropriately in speech and informal prose, but replace it with precise wording where formal accountability requires exactness."
      ],
      "forms": {
        "positive": [
          "Roughly two hundred households responded to the first survey.",
          "The repair should take another hour or so if no further damage is found.",
          "We discussed staffing, scheduling, procurement, and things like that."
        ]
      },
