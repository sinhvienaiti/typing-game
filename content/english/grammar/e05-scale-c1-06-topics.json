    {
      "schemaVersion": 1,
      "id": "gr.c1.impersonal-formal-style",
      "cefr": "C1",
      "title": "Impersonal constructions in formal writing",
      "objective": "Use passive, anticipatory it and impersonal reporting without obscuring responsibility.",
      "concept": {
        "en": "Formal prose can background the actor with passives, anticipatory it, and impersonal reporting, but these choices should not conceal responsibility unnecessarily.",
        "vi": "Văn phong trang trọng có thể làm mờ tác nhân bằng bị động, anticipatory it và reporting impersonal, nhưng không nên che trách nhiệm một cách không cần thiết."
      },
      "formulae": [
        "It is + adjective/past participle + that-clause",
        "passive + to-infinitive",
        "It appears/seems that + clause"
      ],
      "whenToUse": [
        "Use impersonal forms for process/evidence focus while naming the actor when accountability matters."
      ],
      "forms": {
        "positive": [
          "It is widely accepted that the current measure underestimates informal work.",
          "Further testing is required before the device can be approved for clinical use.",
          "It appears that two different definitions were used in the original survey."
        ]
      },
