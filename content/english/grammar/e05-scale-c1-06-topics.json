      "schemaVersion": 1,
      "id": "gr.c1.given-new-information",
      "cefr": "C1",
      "title": "Given/new information and clause ordering",
      "objective": "Order information so known material leads naturally to new/focal material.",
      "concept": {
        "en": "English information structure often places accessible or given material early and reserves new, heavy, or focal material for later positions.",
        "vi": "Cấu trúc thông tin tiếng Anh thường đặt thông tin đã biết ở đầu và để thông tin mới, nặng hoặc trọng tâm về sau."
      },
      "formulae": [
        "given/topic → new/focus",
        "light before heavy where grammar allows"
      ],
      "whenToUse": [
        "Order clauses and noun phrases so the reader can anchor each new point in information already active."
      ],
      "forms": {
        "positive": [
          "The original model assumed constant demand. That assumption is what the new evidence most directly challenges.",
          "Several risks were identified during testing. The most serious was an undocumented dependency in the payment service.",
          "A revised timetable was circulated yesterday. At its center is a six-week external review."
        ]
      },
