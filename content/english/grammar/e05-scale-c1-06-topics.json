    {
      "schemaVersion": 1,
      "id": "gr.c1.spoken-headers-tails",
      "cefr": "C1",
      "title": "Spoken headers and tails",
      "objective": "Recognize/use conversational topic frames such as That car, is it yours? and It's nice, that place.",
      "concept": {
        "en": "Spoken headers introduce a topic before the clause, while tails add a clarifying noun phrase after a clause or pronoun.",
        "vi": "Trong hội thoại, header giới thiệu chủ đề trước mệnh đề, còn tail thêm cụm danh từ làm rõ sau mệnh đề/đại từ."
      },
      "formulae": [
        "header NP, clause with pronoun",
        "clause with pronoun, tail NP"
      ],
      "whenToUse": [
        "Use headers and tails in conversation for topic management; avoid importing them unedited into formal prose."
      ],
      "forms": {
        "positive": [
          "That new procurement portal, have you managed to use it yet?",
          "It's surprisingly intuitive, the mobile version.",
          "Those figures from last quarter, do we still need them in the appendix?"
        ]
      },
