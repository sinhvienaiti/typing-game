    {
      "schemaVersion": 1,
      "id": "gr.c1.parallelism",
      "cefr": "C1",
      "title": "Grammatical parallelism",
      "objective": "Keep coordinated lists, comparisons and paired structures grammatically parallel.",
      "concept": {
        "en": "Parallelism keeps coordinated and compared elements in matching grammatical forms, making complex prose easier to process.",
        "vi": "Parallelism giữ các thành phần phối hợp hoặc so sánh ở dạng ngữ pháp tương ứng, giúp văn bản phức dễ đọc hơn."
      },
      "formulae": [
        "X, Y, and Z in matching forms",
        "not only X but also Y",
        "compare like with like"
      ],
      "whenToUse": [
        "Use parallel forms in lists, paired structures, headings, and formal comparisons."
      ],
      "forms": {
        "positive": [
          "The review aims to reduce duplication, improve accountability, and clarify decision rights.",
          "The reform affected not only how funds were allocated but also how outcomes were reported.",
          "The committee asked whether the rule was necessary, whether it was proportionate, and whether it was enforceable."
        ]
      },
