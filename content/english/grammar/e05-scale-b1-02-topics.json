    {
      "schemaVersion": 1,
      "id": "gr.b1.first-conditional-variants",
      "cefr": "B1",
      "title": "First Conditional: modal and imperative results",
      "objective": "Use can/may/might/should or imperatives in realistic result clauses.",
      "concept": {
        "en": "In First Conditional patterns, the result clause can use will, can, may, might or an imperative depending on the intended result.",
        "vi": "Trong câu điều kiện loại 1, mệnh đề kết quả có thể dùng will, can, may, might hoặc câu mệnh lệnh tùy ý nghĩa."
      },
      "formulae": [
        "If + Present Simple, will/can/may/might + base verb.",
        "If + Present Simple, imperative."
      ],
      "whenToUse": [
        "Express likely results, possibilities, permission or instructions after a realistic future condition."
      ],
      "forms": {
        "positive": [
          "If you finish early, you can leave.",
          "If it rains, we might stay home.",
          "If you see Mia, tell her to call me."
        ]
      },
