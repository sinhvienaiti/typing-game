    {
      "schemaVersion": 1,
      "id": "gr.b1.will-vs-going-to",
      "cefr": "B1",
      "title": "Will vs going to: intention and prediction nuance",
      "objective": "Choose between spontaneous/neutral future meaning and prior intention/evidence.",
      "concept": {
        "en": "Use will for decisions made now and opinion-based predictions; use be going to for prior intentions and evidence-based predictions.",
        "vi": "Dùng will cho quyết định tức thời và dự đoán dựa trên ý kiến; dùng be going to cho ý định đã có và dự đoán dựa trên bằng chứng hiện tại."
      },
      "formulae": [
        "will + base verb",
        "am/is/are going to + base verb"
      ],
      "whenToUse": [
        "Choose the future form according to decision timing and evidence."
      ],
      "forms": {
        "positive": [
          "I'll answer the phone.",
          "I'm going to start a course next month.",
          "Look at those clouds; it's going to rain."
        ]
      },
