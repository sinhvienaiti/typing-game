    {
      "schemaVersion": 1,
      "id": "gr.b1.future-continuous",
      "cefr": "B1",
      "title": "Future Continuous",
      "objective": "Describe actions expected to be in progress at a future time.",
      "concept": {
        "en": "Use the Future Continuous for an action that will be in progress at a particular future time.",
        "vi": "Dùng Tương lai tiếp diễn cho hành động sẽ đang diễn ra tại một thời điểm cụ thể trong tương lai."
      },
      "formulae": [
        "Subject + will be + verb-ing."
      ],
      "whenToUse": [
        "Describe an activity expected to be in progress around a future time."
      ],
      "forms": {
        "positive": [
          "This time tomorrow, I'll be flying to Hanoi.",
          "At eight, we'll be having dinner.",
          "Don't call at ten; I'll be sleeping."
        ]
      },
