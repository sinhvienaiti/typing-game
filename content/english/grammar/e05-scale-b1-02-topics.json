    {
      "schemaVersion": 1,
      "id": "gr.b1.used-to-vs-would",
      "cefr": "B1",
      "title": "Used to vs would for past habits",
      "objective": "Choose forms for repeated past actions and past states.",
      "concept": {
        "en": "Use used to for repeated past habits and past states; use would for repeated past actions, but not normally for past states.",
        "vi": "Dùng used to cho thói quen lặp lại và trạng thái trong quá khứ; dùng would cho hành động lặp lại trong quá khứ nhưng thường không dùng cho trạng thái."
      },
      "formulae": [
        "used to + base verb = past habit/state",
        "would + base verb = repeated past action"
      ],
      "whenToUse": [
        "Choose between two ways of describing repeated past behavior."
      ],
      "forms": {
        "positive": [
          "We used to live near the station.",
          "Every summer, we would visit our grandparents.",
          "She used to have long hair."
        ]
      },
      "variations": [],
