    {
      "schemaVersion": 1,
      "id": "gr.b1.present-future-forms-detail",
      "cefr": "B1",
      "title": "Present forms for future events",
      "objective": "Distinguish arrangements from fixed schedules in realistic planning.",
      "concept": {
        "en": "Use present and future forms according to whether a future event is a timetable, arrangement, intention, prediction or action in progress.",
        "vi": "Chọn các dạng hiện tại và tương lai tùy theo sự kiện là lịch trình, sắp xếp, ý định, dự đoán hay hành động đang diễn ra trong tương lai."
      },
      "formulae": [
        "schedule: Present Simple",
        "arrangement: Present Continuous",
        "intention: going to",
        "prediction/decision: will",
        "in progress: will be + V-ing"
      ],
      "whenToUse": [
        "Select a more precise future form from context."
      ],
      "forms": {
        "positive": [
          "The train leaves at 6:20.",
          "I'm meeting Lee after work.",
          "At nine tomorrow, I'll be taking my exam."
        ]
