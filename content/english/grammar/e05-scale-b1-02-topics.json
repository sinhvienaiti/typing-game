      "id": "gr.b1.wish-present",
      "cefr": "B1",
      "title": "Wish + past: present wishes",
      "objective": "Express dissatisfaction with a present situation.",
      "concept": {
        "en": "Use wish + Past Simple to talk about a present situation that you want to be different.",
        "vi": "Dùng wish + Quá khứ đơn để nói về một tình huống hiện tại mà bạn muốn nó khác đi."
      },
      "formulae": [
        "Subject + wish(es) + subject + Past Simple.",
        "wish + could + base verb for present ability/possibility"
      ],
      "whenToUse": [
        "Express regret or dissatisfaction about an unreal present situation."
      ],
      "forms": {
        "positive": [
