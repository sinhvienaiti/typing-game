    {
      "schemaVersion": 1,
      "id": "gr.b1.narrative-tenses",
      "cefr": "B1",
      "title": "Narrative tenses",
      "objective": "Combine past simple, continuous and perfect to tell coherent stories.",
      "concept": {
        "en": "Combine Past Simple, Past Continuous and Past Perfect to show main events, background actions and earlier events in a story.",
        "vi": "Kết hợp Quá khứ đơn, Quá khứ tiếp diễn và Quá khứ hoàn thành để thể hiện sự kiện chính, hành động nền và sự kiện xảy ra trước trong một câu chuyện."
      },
      "formulae": [
        "main event: Past Simple",
        "background: Past Continuous",
        "earlier event: Past Perfect"
      ],
      "whenToUse": [
        "Organize a past narrative so the timeline and background are clear."
      ],
      "forms": {
        "positive": [
          "I was walking home when I noticed I had lost my keys.",
          "The sun was shining when we left the hotel.",
          "She opened the door and saw that someone had moved the box."
        ]
      },
