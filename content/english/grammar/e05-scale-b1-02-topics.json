    {
      "schemaVersion": 1,
      "id": "gr.b1.conditional-alternatives",
      "cefr": "B1",
      "title": "Unless, as long as and provided that",
      "objective": "Express conditions without relying only on if.",
      "concept": {
        "en": "Use unless, as long as, provided/providing and in case to express different kinds of conditions and precautions.",
        "vi": "Dùng unless, as long as, provided/providing và in case để diễn đạt các loại điều kiện và biện pháp đề phòng khác nhau."
      },
      "formulae": [
        "unless = if ... not",
        "as long as/provided = only if condition is met",
        "in case = precaution for a possible situation"
      ],
      "whenToUse": [
        "Vary conditional linking words while keeping their meanings distinct."
      ],
      "forms": {
        "positive": [
          "You won't pass unless you study.",
          "You can borrow the car as long as you're careful.",
          "Take an umbrella in case it rains."
        ]
      },
