    {
      "schemaVersion": 1,
      "id": "gr.c1.partitives-proportions",
      "cefr": "C1",
      "title": "Partitives and proportions",
      "objective": "Use a proportion/share/majority/minority/percentage of with correct agreement and countability.",
      "concept": {
        "en": "Partitives and proportion expressions combine quantity heads with of-phrases, and agreement often follows the noun inside the of-phrase.",
        "vi": "Cấu trúc partitive và tỷ lệ kết hợp danh từ chỉ lượng với of-phrase; hòa hợp động từ thường theo danh từ trong of-phrase."
      },
      "formulae": [
        "a majority/minority/proportion/percentage of + noun",
        "two thirds of + noun"
      ],
      "whenToUse": [
        "Match agreement and countability to the quantified noun and the intended reading."
      ],
      "forms": {
        "positive": [
          "A majority of the respondents support the revised proposal.",
          "Nearly two thirds of the budget is allocated to long-term infrastructure.",
          "Only a small proportion of the archived files were digitally searchable."
        ]
      },
