    {
      "schemaVersion": 1,
      "id": "gr.c1.advanced-substitution",
      "cefr": "C1",
      "title": "One/ones, that/those, former/latter and do so",
      "objective": "Choose substitution devices by noun type, register and discourse relation.",
      "concept": {
        "en": "Substitution devices replace repeated nouns or propositions while preserving number, type, and discourse relation.",
        "vi": "Các phương tiện thay thế thay cho danh từ hoặc mệnh đề đã nêu, đồng thời phải giữ đúng số, loại và quan hệ diễn ngôn."
      },
      "formulae": [
        "one/ones",
        "that/those + modifier",
        "the former/the latter",
        "do so"
      ],
      "whenToUse": [
        "Choose substitution according to whether the antecedent is a count noun, a noun phrase, or a verb phrase and according to register."
      ],
      "forms": {
        "positive": [
          "The revised estimate is more conservative than the one published in March.",
          "Urban rents rose faster than those in smaller towns.",
          "The regulator asked the company to disclose the method, and it agreed to do so."
        ]
      },
