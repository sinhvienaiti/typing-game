    {
      "schemaVersion": 1,
      "id": "gr.c1.articles-shared-knowledge",
      "cefr": "C1",
      "title": "Articles and shared situational knowledge",
      "objective": "Use the when identifiability comes from shared context rather than prior mention.",
      "concept": {
        "en": "Definite reference can arise from a shared physical or social situation even when the noun has not been mentioned earlier.",
        "vi": "Tham chiếu xác định có thể hình thành từ bối cảnh vật lý/xã hội chung dù danh từ chưa được nhắc trước đó."
      },
      "formulae": [
        "the + uniquely identifiable noun in shared context"
      ],
      "whenToUse": [
        "Use the when speaker and listener can identify the referent from the immediate situation or shared institutional knowledge."
      ],
      "forms": {
        "positive": [
          "Could you close the window before the presentation starts?",
          "The chair will circulate the agenda after lunch.",
          "I left the access card at reception because the security desk was already closed."
        ]
      },
