    {
      "schemaVersion": 1,
      "id": "gr.c1.institution-metonymy-articles",
      "cefr": "C1",
      "title": "Institutional/metonymic article shifts",
      "objective": "Distinguish activity, institution, building and service meanings through article choice.",
      "concept": {
        "en": "Article choice can distinguish participation in an institution's normal activity from reference to its building, organization, or service.",
        "vi": "Mạo từ có thể phân biệt việc tham gia hoạt động thông thường của một thể chế với việc nói về tòa nhà, tổ chức hoặc dịch vụ."
      },
      "formulae": [
        "go to school/prison/church (institutional activity)",
        "go to the school/prison/church (specific place/building)"
      ],
      "whenToUse": [
        "Use article shifts to signal whether the institution is understood functionally or as a concrete identifiable entity."
      ],
      "forms": {
        "positive": [
          "The journalist went to the prison to interview the governor, while two suspects were still in prison awaiting trial.",
          "Children usually start school at five, but their parents visited the school yesterday.",
          "After surgery he remained in hospital for three nights before returning to the hospital for a follow-up appointment."
        ]
