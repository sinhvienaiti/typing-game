    {
      "schemaVersion": 1,
      "id": "gr.c1.auxiliary-ellipsis",
      "cefr": "C1",
      "title": "Ellipsis after auxiliaries",
      "objective": "Omit repeated verb phrases after auxiliaries while preserving tense/modal meaning.",
      "concept": {
        "en": "After an auxiliary or modal, a repeated verb phrase can be omitted when its content is recoverable from context.",
        "vi": "Sau trợ động từ hoặc modal, có thể lược cụm động từ lặp lại khi nội dung đã suy ra được từ ngữ cảnh."
      },
      "formulae": [
        "subject + auxiliary/modal (+ not), with VP omitted"
      ],
      "whenToUse": [
        "Use auxiliary ellipsis to avoid repetition while preserving tense, polarity, and modality."
      ],
      "forms": {
        "positive": [
          "The first model predicted a decline, but the revised model didn't.",
          "Some departments may extend the deadline, while others may not.",
          "I haven't reviewed the annex yet, but the legal team has."
        ]
      },
