    {
      "schemaVersion": 1,
      "id": "gr.c1.advanced-condition-markers",
      "cefr": "C1",
      "title": "Supposing, provided, but for and otherwise",
      "objective": "Express formal, hypothetical and exception conditions compactly.",
      "concept": {
        "en": "Formal condition markers such as provided, supposing, but for, and otherwise compress different conditional relations.",
        "vi": "Các dấu hiệu điều kiện trang trọng như provided, supposing, but for và otherwise nén những quan hệ điều kiện khác nhau."
      },
      "formulae": [
        "provided/providing that + clause",
        "supposing + clause",
        "but for + noun phrase",
        "imperative/clause; otherwise + result"
      ],
      "whenToUse": [
        "Use each marker for its specific meaning: sufficient condition, hypothesis, exception, or avoided consequence."
      ],
      "forms": {
        "positive": [
          "Provided that the safeguards remain in place, the trial can continue.",
          "But for a last-minute appeal, the demolition would already have begun.",
          "Submit the declaration by Friday; otherwise, the application will lapse."
        ]
      },
