    {
      "schemaVersion": 1,
      "id": "gr.c1.mixed-conditionals-nuance",
      "cefr": "C1",
      "title": "Mixed conditionals: time and causality nuance",
      "objective": "Build cross-time counterfactuals only when the causal relationship is coherent.",
      "concept": {
        "en": "Mixed conditionals connect counterfactual cause and result across different time frames only when the causal relation is coherent.",
        "vi": "Mixed conditional nối nguyên nhân và kết quả phản thực ở các mốc thời gian khác nhau khi quan hệ nhân quả thực sự hợp lý."
      },
      "formulae": [
        "if + past perfect, would + base verb",
        "if + past simple, would have + past participle"
      ],
      "whenToUse": [
        "Choose tense combinations from the cause-result timeline rather than memorizing a fixed label."
      ],
      "forms": {
        "positive": [
          "If the company had invested in training earlier, it would have a stronger internal security team now.",
          "If she were less risk-averse, she would have accepted the partnership last year.",
          "If we had not changed the architecture, the platform would still be struggling under peak load."
        ]
      },
