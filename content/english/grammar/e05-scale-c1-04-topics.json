    {
      "schemaVersion": 1,
      "id": "gr.c1.advanced-unreal-preferences",
      "cefr": "C1",
      "title": "Unreal past in preferences and criticism",
      "objective": "Use would rather/sooner, would prefer and It's time with correct subject/time reference.",
      "concept": {
        "en": "Unreal-past forms after would rather, would sooner, and It's time express present preferences, criticism, or overdue action.",
        "vi": "Dạng quá khứ phi thực sau would rather, would sooner và It's time diễn đạt sở thích hiện tại, lời phê bình hoặc việc đã đến lúc phải làm."
      },
      "formulae": [
        "would rather + subject + past simple",
        "It's time + subject + past simple"
      ],
      "whenToUse": [
        "Use unreal past when the subject of the preferred or overdue action is different from the speaker or the action is not yet real."
      ],
      "forms": {
        "positive": [
          "I'd rather the department published the methodology before announcing the headline figure.",
          "It's time the agency explained how the exception is being applied.",
          "She would sooner the matter remained confidential until the audit finished."
        ]
      },
