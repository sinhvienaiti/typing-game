    {
      "schemaVersion": 1,
      "id": "gr.b2.articles-abstract-nouns",
      "cefr": "B2",
      "title": "Articles with abstract nouns",
      "objective": "Choose zero/a/the as abstract ideas become general, instances or specified concepts.",
      "concept": {
        "en": "Article choice with abstract nouns depends on whether the idea is general, one instance or a specifically identified concept.",
        "vi": "Việc chọn mạo từ với danh từ trừu tượng phụ thuộc vào việc ý niệm đang được nói chung, là một trường hợp cụ thể hay là một khái niệm đã được xác định."
      },
      "formulae": [
        "zero article + abstract noun = general concept",
        "a/an + modified countable instance",
        "the + specified abstract noun"
      ],
      "whenToUse": [
        "Choose zero, a/an or the according to how specifically the abstract idea is framed in the discourse."
      ],
      "forms": {
        "positive": [
          "Freedom requires responsibility.",
          "The freedom we gained after the reform came with new responsibilities.",
          "A deep understanding of context is essential for accurate interpretation."
        ]
      },
