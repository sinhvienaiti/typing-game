    {
      "schemaVersion": 1,
      "id": "gr.b2.correlative-comparison",
      "cefr": "B2",
      "title": "The more..., the more...",
      "objective": "Express linked changes with correlative comparatives.",
      "concept": {
        "en": "The correlative pattern the + comparative ..., the + comparative ... links two changing variables.",
        "vi": "Cấu trúc tương liên the + so sánh hơn ..., the + so sánh hơn ... liên kết hai đại lượng thay đổi cùng nhau."
      },
      "formulae": [
        "The + comparative + clause, the + comparative + clause"
      ],
      "whenToUse": [
        "Express that a change in one condition is systematically associated with a change in another."
      ],
      "forms": {
        "positive": [
          "The more carefully you plan, the fewer problems you are likely to face.",
          "The longer the meeting continued, the less productive it became.",
          "The more we automate routine tasks, the more time we can spend on analysis."
        ]
