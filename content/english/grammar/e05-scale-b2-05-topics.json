    {
      "schemaVersion": 1,
      "id": "gr.b2.generic-reference",
      "cefr": "B2",
      "title": "Generic reference with a/an, the and zero article",
      "objective": "Choose among three generic patterns based on noun type and style.",
      "concept": {
        "en": "English can express a whole class with a zero-article plural, with the + singular for a species/class, or with a/an + singular for a representative member.",
        "vi": "Tiếng Anh có thể nói về cả một lớp bằng danh từ số nhiều không mạo từ, the + số ít để chỉ loài/lớp, hoặc a/an + số ít để lấy một thành viên làm đại diện."
      },
      "formulae": [
        "plural noun with zero article",
        "the + singular noun",
        "a/an + singular noun"
      ],
      "whenToUse": [
        "Choose a generic pattern according to noun type, register and whether the class or a representative member is foregrounded."
      ],
      "forms": {
        "positive": [
          "Tigers are powerful predators.",
          "The tiger is threatened by habitat loss.",
          "A smartphone can replace several everyday devices."
        ]
      },
