    {
      "schemaVersion": 1,
      "id": "gr.b2.less-fewer-number-amount",
      "cefr": "B2",
      "title": "Less/fewer, number/amount and quantity precision",
      "objective": "Match quantifiers and measure nouns to countability.",
      "concept": {
        "en": "Fewer and number normally combine with countable plural nouns, while less and amount normally combine with uncountable quantity.",
        "vi": "Fewer và number thường đi với danh từ đếm được số nhiều, còn less và amount thường đi với lượng không đếm được."
      },
      "formulae": [
        "fewer + plural count noun",
        "less + uncountable noun",
        "number of + plural count noun",
        "amount of + uncountable noun"
      ],
      "whenToUse": [
        "Make quantity language precise in formal and neutral contexts by matching the expression to countability."
      ],
      "forms": {
        "positive": [
          "Fewer employees commute every day than they did five years ago.",
          "The amount of waste produced by the factory has fallen significantly.",
          "We need less time but a greater number of volunteers."
        ]
      },
