    {
      "schemaVersion": 1,
      "id": "gr.b2.superlative-present-perfect",
      "cefr": "B2",
      "title": "Superlative + present perfect experience",
      "objective": "Use patterns such as the best ... I've ever ... naturally.",
      "concept": {
        "en": "A superlative followed by a Present Perfect relative clause evaluates an experience across the speaker's life or another unfinished period.",
        "vi": "Dạng so sánh nhất đi với mệnh đề Present Perfect dùng để đánh giá một trải nghiệm trong suốt cuộc đời người nói hoặc một khoảng thời gian chưa kết thúc."
      },
      "formulae": [
        "the + superlative + noun + subject + have/has ever + past participle"
      ],
      "whenToUse": [
        "Describe an extreme experience while keeping the comparison period connected to the present."
      ],
      "forms": {
        "positive": [
          "This is the most demanding project I've ever managed.",
          "It's the best documentary we've seen this year.",
          "That was the most convincing explanation she has given so far."
        ]
