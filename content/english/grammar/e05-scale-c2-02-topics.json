    {
      "schemaVersion": 1,
      "id": "gr.c2.comparative-clause-ellipsis",
      "cefr": "C2",
      "title": "Ellipsis in comparative clauses",
      "objective": "Interpret and produce reduced clauses after than/as.",
      "concept": {
        "en": "Comparative clauses after than and as often omit material recoverable from the matrix clause, but the ellipsis must preserve the intended comparison.",
        "vi": "Mệnh đề so sánh sau than và as thường lược phần có thể suy ra từ mệnh đề chính, nhưng phần lược phải giữ đúng đối tượng so sánh."
      },
      "formulae": [
        "comparative + than + reduced clause",
        "as + adjective/adverb + as + reduced clause"
      ],
      "whenToUse": [
        "Expand the reduced clause mentally to check case, scope, and whether like is being compared with like."
      ],
      "forms": {
        "positive": [
          "The revised model predicts a steeper decline than the earlier one does.",
          "The second survey attracted more rural respondents than the first.",
          "The measure is not as sensitive to short-term volatility as the previous index was."
        ]
      },
