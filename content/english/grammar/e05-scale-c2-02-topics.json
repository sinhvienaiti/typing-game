    {
      "schemaVersion": 1,
      "id": "gr.c2.free-relatives",
      "cefr": "C2",
      "title": "Free/fused relative clauses",
      "objective": "Use what/where/how constructions that function as complete noun phrases.",
      "concept": {
        "en": "A free or fused relative contains its own antecedent, so the wh-form and relative clause together function as a complete noun phrase or adjunct.",
        "vi": "Free/fused relative tự chứa antecedent, vì vậy wh-form cùng mệnh đề quan hệ hoạt động như một cụm danh từ hoặc trạng ngữ hoàn chỉnh."
      },
      "formulae": [
        "what + clause = the thing(s) that ...",
        "where + clause = the place where ...",
        "how + clause = the way in which ..."
      ],
      "whenToUse": [
        "Use free relatives when no separate head noun is needed and distinguish them from interrogative embedded clauses by function."
      ],
      "forms": {
        "positive": [
          "What the audit uncovered was more serious than the preliminary note had suggested.",
          "We returned to where the original samples had been stored.",
          "How the exception is interpreted will determine whether the appeal succeeds."
        ]
      },
