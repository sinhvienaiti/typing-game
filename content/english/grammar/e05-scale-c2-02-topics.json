    {
      "schemaVersion": 1,
      "id": "gr.c2.formulaic-subjunctive",
      "cefr": "C2",
      "title": "Formulaic and irrealis subjunctive",
      "objective": "Use fixed expressions and were-subjunctive forms with appropriate register.",
      "concept": {
        "en": "Formulaic subjunctives survive in fixed expressions and the irrealis were marks remote hypotheticals independently of subject number.",
        "vi": "Subjunctive công thức tồn tại trong các cụm cố định, còn irrealis were đánh dấu giả định xa thực tế không phụ thuộc số của chủ ngữ."
      },
      "formulae": [
        "be that as it may",
        "come what may",
        "if I/he/she were ...",
        "far be it from me ..."
      ],
      "whenToUse": [
        "Use fixed subjunctive expressions as register-sensitive units and use were for careful irrealis hypotheses."
      ],
      "forms": {
        "positive": [
          "Be that as it may, the committee still has to explain why the safeguard was removed.",
          "Were the evidence less ambiguous, I would support a stronger conclusion.",
          "Come what may, the archive must remain accessible to the inquiry."
        ]
      },
