    {
      "schemaVersion": 1,
      "id": "gr.c2.extraposition-anticipatory-it",
      "cefr": "C2",
      "title": "Extraposition and anticipatory it",
      "objective": "Move heavy clauses rightward with it while preserving information structure.",
      "concept": {
        "en": "Extraposition places a heavy clausal subject later and fills subject position with anticipatory it, often improving information balance.",
        "vi": "Extraposition đưa chủ ngữ mệnh đề nặng về cuối và dùng anticipatory it ở vị trí chủ ngữ, thường giúp cân bằng thông tin."
      },
      "formulae": [
        "It + be/seem + complement + that/to-clause",
        "It + verb + that-clause"
      ],
      "whenToUse": [
        "Use extraposition when the clausal subject would be awkwardly heavy initially, while preserving its semantic role."
      ],
      "forms": {
        "positive": [
          "It became clear during the hearing that several witnesses had been given different versions of the timetable.",
          "It would be difficult to justify abandoning the safeguard without new evidence.",
          "It surprised the reviewers that the discrepancy had not been detected earlier."
        ]
      },
