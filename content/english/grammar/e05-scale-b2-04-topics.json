    {
      "schemaVersion": 1,
      "id": "gr.b2.emphatic-do",
      "cefr": "B2",
      "title": "Emphatic do",
      "objective": "Add contrastive emphasis to affirmative present/past statements.",
      "concept": {
        "en": "Use do/does/did before a base verb in affirmative clauses to add contrastive emphasis, especially when correcting or strongly confirming something.",
        "vi": "Dùng do/does/did trước động từ nguyên mẫu trong câu khẳng định để thêm nhấn mạnh tương phản, đặc biệt khi đính chính hoặc khẳng định mạnh."
      },
      "formulae": [
        "do/does/did + base verb (affirmative emphasis)"
      ],
      "whenToUse": [
        "Emphasize that an affirmative statement is genuinely true."
      ],
      "forms": {
        "positive": [
          "I do understand your concern.",
          "She does work hard.",
          "He did call me yesterday."
        ]
      },
