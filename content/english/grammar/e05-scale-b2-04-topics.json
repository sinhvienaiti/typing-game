    {
      "schemaVersion": 1,
      "id": "gr.b2.gerund-clauses-subject",
      "cefr": "B2",
      "title": "Gerund clauses as subjects and complements",
      "objective": "Use -ing clauses as noun-like units in formal and everyday English.",
      "concept": {
        "en": "Use a gerund clause as the subject of a sentence when an activity or action is treated as a concept.",
        "vi": "Dùng mệnh đề V-ing làm chủ ngữ khi một hoạt động hay hành động được xem như một khái niệm."
      },
      "formulae": [
        "V-ing phrase + singular verb"
      ],
      "whenToUse": [
        "Make an activity the topic of a statement in neutral or formal English."
      ],
      "forms": {
        "positive": [
          "Working from home saves time.",
          "Learning a language takes patience.",
          "Driving at night can be tiring."
        ]
