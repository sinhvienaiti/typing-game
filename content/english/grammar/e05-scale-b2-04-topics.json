    {
      "schemaVersion": 1,
      "id": "gr.b2.reduced-relative-clauses",
      "cefr": "B2",
      "title": "Reduced relative clauses",
      "objective": "Condense active/passive relative clauses without ambiguity.",
      "concept": {
        "en": "Reduce some relative clauses with active V-ing, passive past participles or to-infinitives when the meaning remains clear.",
        "vi": "Rút gọn một số mệnh đề quan hệ bằng V-ing chủ động, quá khứ phân từ bị động hoặc to-infinitive khi nghĩa vẫn rõ."
      },
      "formulae": [
        "noun + V-ing ... = noun who/which is doing",
        "noun + past participle ... = noun that is/was done",
        "noun + to-infinitive for selected patterns"
      ],
      "whenToUse": [
        "Make noun phrases more concise in written English."
      ],
      "forms": {
        "positive": [
          "People waiting outside should form a line.",
          "The documents sent yesterday have arrived.",
          "She was the first person to finish."
        ]
      },
