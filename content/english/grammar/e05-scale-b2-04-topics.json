    {
      "schemaVersion": 1,
      "id": "gr.b2.infinitive-clauses",
      "cefr": "B2",
      "title": "Infinitive clauses after nouns/adjectives and as complements",
      "objective": "Build compact to-infinitive clause structures with clear understood subjects.",
      "concept": {
        "en": "Use to-infinitive clauses after adjectives, nouns and verbs or as extraposed subjects to express purpose, evaluation, intention or potential action.",
        "vi": "Dùng mệnh đề to-infinitive sau tính từ, danh từ và động từ hoặc trong cấu trúc chủ ngữ giả để diễn tả mục đích, đánh giá, ý định hay hành động tiềm năng."
      },
      "formulae": [
        "to + base verb phrase",
        "It + be + adjective + to-infinitive"
      ],
      "whenToUse": [
        "Build more complex complements around potential or intended actions."
      ],
      "forms": {
        "positive": [
          "It's important to check the details.",
          "She has a decision to make.",
          "We agreed to meet outside."
        ]
      },
