    {
      "schemaVersion": 1,
      "id": "gr.b2.participle-clauses-ing",
      "cefr": "B2",
      "title": "Present participle clauses",
      "objective": "Reduce clauses when subjects align and simultaneous/cause meanings are clear.",
      "concept": {
        "en": "Use an -ing participle clause to reduce a clause when the understood subject is the same and the action is simultaneous, causal or sequential.",
        "vi": "Dùng mệnh đề phân từ V-ing để rút gọn mệnh đề khi chủ ngữ ngầm giống nhau và hành động diễn ra đồng thời, có quan hệ nguyên nhân hoặc trình tự."
      },
      "formulae": [
        "V-ing clause, main clause"
      ],
      "whenToUse": [
        "Make written sentences more compact while keeping the same subject relationship."
      ],
      "forms": {
        "positive": [
          "Walking home, I saw an old friend.",
          "Knowing the answer, she raised her hand.",
          "Opening the door, he noticed the lights were off."
        ]
      },
