    {
      "schemaVersion": 1,
      "id": "gr.b2.noun-clauses-that-whether-wh",
      "cefr": "B2",
      "title": "Noun clauses with that, whether/if and wh-words",
      "objective": "Use clauses as objects/complements with correct word order.",
      "concept": {
        "en": "Use that-, whether/if- and wh-clauses as noun-like complements after verbs, adjectives and some nouns.",
        "vi": "Dùng mệnh đề that, whether/if và wh như bổ ngữ mang chức năng danh từ sau động từ, tính từ và một số danh từ."
      },
      "formulae": [
        "verb/adjective + that + clause",
        "verb + whether/if + clause",
        "verb + wh-word + clause"
      ],
      "whenToUse": [
        "Express propositions, uncertainty and embedded information as clause complements."
      ],
      "forms": {
        "positive": [
          "I believe that the plan will work.",
          "We're not sure whether the data is complete.",
          "She explained why the meeting was canceled."
        ]
      },
