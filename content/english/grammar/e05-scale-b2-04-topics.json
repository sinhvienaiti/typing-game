    {
      "schemaVersion": 1,
      "id": "gr.b2.wh-ever-clauses",
      "cefr": "B2",
      "title": "Whoever/whatever/wherever clauses",
      "objective": "Express free-choice or unknown reference with -ever forms.",
      "concept": {
        "en": "Use whoever, whatever, wherever, whenever and however to introduce free relative or concessive clauses meaning any person, thing, place, time or way.",
        "vi": "Dùng whoever, whatever, wherever, whenever và however để mở đầu mệnh đề tự do hoặc nhượng bộ mang nghĩa bất kỳ người, vật, nơi, lúc hay cách nào."
      },
      "formulae": [
        "whoever/whatever/wherever/whenever/however + clause"
      ],
      "whenToUse": [
        "Refer generally without naming a specific person or thing, or express concession."
      ],
      "forms": {
        "positive": [
          "Take whatever you need.",
          "Whoever arrives first should open the door.",
          "Wherever you go, keep in touch."
        ]
      },
