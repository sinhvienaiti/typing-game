    {
      "schemaVersion": 1,
      "id": "gr.b2.participle-clauses-ed",
      "cefr": "B2",
      "title": "Past participle clauses",
      "objective": "Use reduced passive/result clauses accurately.",
      "concept": {
        "en": "Use a past-participle clause to reduce a passive or state-based clause when the understood subject is the same as the main clause subject.",
        "vi": "Dùng mệnh đề quá khứ phân từ để rút gọn mệnh đề bị động hoặc trạng thái khi chủ ngữ ngầm giống với chủ ngữ mệnh đề chính."
      },
      "formulae": [
        "past participle phrase, main clause"
      ],
      "whenToUse": [
        "Compress passive background information in formal or written style."
      ],
      "forms": {
        "positive": [
          "Built in 1920, the house needs major repairs.",
          "Surprised by the news, Mina called immediately.",
          "Designed for beginners, the course is easy to follow."
        ]
      },
